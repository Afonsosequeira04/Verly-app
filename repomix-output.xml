            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: none;
        }
        .sidenav-scroll::-webkit-scrollbar { display: none; }

        /* ── Main content acompanha ───────────────────────── */
        .main-content {
            margin-left: var(--nav-width);
            transition: margin-left 0.25s cubic-bezier(.4,0,.2,1);
        }
        .sidenav.collapsed ~ .main-content {
            margin-left: var(--nav-collapsed);
        }

        /* ── Logo row ─────────────────────────────────────── */
        .sidenav-logo {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 20px 10px 8px;
            margin-bottom: 0;
            flex-shrink: 0;
            position: relative;
            z-index: 1;
        }
        .sidenav-logo-left {
            display: flex;
            align-items: center;
            gap: 10px;
            overflow: hidden;
            flex: 1;
            min-width: 0;
        }

        /* ── Barra de ações (sino + tema) ─────────────────── */
        .sidenav-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px 12px;
            flex-shrink: 0;
            overflow: hidden;
            transition: opacity 0.2s ease, max-height 0.25s ease, padding 0.25s ease;
            max-height: 60px;
            position: relative;
            z-index: 1;
        }
        .sidenav.collapsed .sidenav-actions {
            opacity: 0;
            max-height: 0;
            padding-top: 0;
            padding-bottom: 0;
            pointer-events: none;
        }

        /* ── Botão hambúrguer ─────────────────────────────── */
        .nav-toggle {
            width: 34px; height: 34px;
            border-radius: 8px;
            border: none;
            outline: none;
            appearance: none;
            -webkit-appearance: none;
            background: transparent;
            color: var(--text-muted);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: background 0.15s, color 0.15s;
            padding: 0;
            box-shadow: none;
        }
        .nav-toggle:hover { background: var(--surface2); color: var(--text); }
        .nav-toggle:focus { outline: none; box-shadow: none; }

        /* ── Textos que desaparecem ───────────────────────── */
        .nav-label,
        .logo-text,
        .sidenav-section,
        .user-details {
            transition: opacity 0.2s ease, max-width 0.25s ease;
            white-space: nowrap;
            overflow: hidden;
            max-width: 180px;
        }
        .sidenav.collapsed .nav-label,
        .sidenav.collapsed .logo-text,
        .sidenav.collapsed .user-details {
            opacity: 0;
            max-width: 0;
            pointer-events: none;
        }
        .sidenav.collapsed .sidenav-section {
            opacity: 0;
            font-size: 0;
            margin: 6px 0 2px;
        }

        /* ── Links centram quando colapsado ──────────────── */
        .sidenav.collapsed .nav-link {
            justify-content: center;
            padding: 10px 0;
        }
        .sidenav.collapsed .sidenav-footer {
            justify-content: center;
            padding: 12px 0 20px;
        }
        .sidenav.collapsed .user-info { flex: 0; }

        /* ── Footer não faz scroll ────────────────────────── */
        .sidenav-footer {
            flex-shrink: 0;
        }

        /* ── Tooltip ao colapsar ─────────────────────────── */
        .sidenav.collapsed .nav-link:hover::after {
            content: attr(data-tooltip);
            position: absolute;
            left: calc(var(--nav-collapsed) + 4px);
            top: 50%;
            transform: translateY(-50%);
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text);
            font-size: 12px;
            font-weight: 600;
            padding: 5px 10px;
            border-radius: 6px;
            white-space: nowrap;
            z-index: 300;
            box-shadow: var(--shadow);
            pointer-events: none;
        }

    /* ── Light mode ──────────────────────────────────── */
    [data-theme="light"] {
        --bg:           #F4F4F9;
        --surface:      #FFFFFF;
        --surface2:     #F0F0F6;
        --surface3:     #E8E8F0;
        --border:       rgba(0,0,0,0.08);
        --border-hover: rgba(0,0,0,0.16);
        --text:         #0E0E1A;
        --text-muted:   #6B6B80;
        --text-sub:     #9999AA;
        --brand:        #4A3AFF;
        --brand-2:      #6C5CE7;
        --brand-light:  rgba(74,58,255,0.10);
        --shadow:       0 4px 24px rgba(0,0,0,0.10);
        --shadow-brand: 0 4px 20px rgba(74,58,255,0.20);
    }

    /* Theme toggle button */
    .theme-toggle {
        width: 32px; height: 32px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--surface2);
        color: var(--text-muted);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: all 0.15s;
        padding: 0;
        margin-left: 4px;
    }
    .theme-toggle:hover { background: var(--surface3); color: var(--text); }
    .theme-toggle svg { pointer-events: none; }

    /* ── Notification bell ─────────────────────────── */
    .notif-bell-wrap {
        position: relative;
        flex-shrink: 0;
    }
    .notif-bell {
        width: 32px; height: 32px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--surface2);
        color: var(--text-muted);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s;
        padding: 0;
        position: relative;
    }
    .notif-bell:hover { background: var(--surface3); color: var(--text); }
    .notif-bell svg { pointer-events: none; }
    .notif-badge {
        display: none;
        position: absolute;
        top: -4px; right: -4px;
        width: 16px; height: 16px;
        background: #FF4757;
        color: white;
        border-radius: 50%;
        font-size: 9px;
        font-weight: 800;
        align-items: center;
        justify-content: center;
        border: 2px solid var(--bg);
        font-family: 'Plus Jakarta Sans', sans-serif;
        animation: pulse-badge 2s ease-in-out infinite;
    }
    .notif-badge.visible { display: flex; }
    @keyframes pulse-badge {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.15); }
    }

    /* ── Notification panel ────────────────────────── */
    .notif-panel {
        display: none;
        position: fixed;
        top: 0; left: 0; /* overridden by JS */
        width: 300px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.4);
        z-index: 9999;
        overflow: hidden;
        animation: slideDown 0.2s ease;
    }
    .notif-panel.open { display: block; }
    @keyframes slideDown { from { opacity:0; transform:translateY(-6px); } to { opacity:1; transform:none; } }
    .notif-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px 10px;
        border-bottom: 1px solid var(--border);
    }
    .notif-panel-title {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--text-muted);
    }
    .notif-panel-count {
        font-size: 11px;
        font-weight: 700;
        color: var(--brand-2);
    }
    .notif-list {
        max-height: 360px;
        overflow-y: auto;
        scrollbar-width: thin;
    }
    .notif-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        text-decoration: none;
        color: inherit;
        transition: background 0.15s;
        cursor: pointer;
    }
    .notif-item:last-child { border-bottom: none; }
    .notif-item:hover { background: var(--surface2); }
    .notif-item-icon {
        font-size: 18px;
        flex-shrink: 0;
        margin-top: 1px;
    }
    .notif-item-body { flex: 1; min-width: 0; }
    .notif-item-title {
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 2px;
        line-height: 1.3;
    }
    .notif-item-msg {
        font-size: 11px;
        color: var(--text-muted);
        line-height: 1.5;
    }
    .notif-item-urgency {
        width: 5px;
        border-radius: 0 14px 14px 0;
        align-self: stretch;
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
    }
    .notif-item { position: relative; }
    .notif-urgencia-alta  { border-left: 3px solid #FF4757; }
    .notif-urgencia-media { border-left: 3px solid #FFB800; }
    .notif-urgencia-info  { border-left: 3px solid var(--brand); }
    .notif-empty {
        padding: 28px 16px;
        text-align: center;
        color: var(--text-muted);
        font-size: 13px;
    }
    .notif-empty-icon { font-size: 28px; margin-bottom: 8px; opacity: 0.4; }

    /* ── Global entry animation ────────────────────── */
    @keyframes verly-slide-in {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: none; }
    }
    .main-content > * {
        animation: verly-slide-in 0.35s ease both;
    }
    .main-content > *:nth-child(1) { animation-delay: 0.00s; }
    .main-content > *:nth-child(2) { animation-delay: 0.05s; }
    .main-content > *:nth-child(3) { animation-delay: 0.10s; }
    .main-content > *:nth-child(4) { animation-delay: 0.13s; }
    .main-content > *:nth-child(5) { animation-delay: 0.16s; }

    /* Flash messages */
    .flash-messages { margin-bottom: 16px; }
    .flash { padding: 12px 16px; border-radius: 8px; font-size: 13px; font-weight: 500; margin-bottom: 8px; }
    .flash-success { background: rgba(0,214,143,0.1); color: #00D68F; border: 1px solid rgba(0,214,143,0.2); }
    .flash-error   { background: rgba(244,63,94,0.1);  color: #FF4757; border: 1px solid rgba(244,63,94,0.2); }
    .flash-warning { background: rgba(245,158,11,0.1); color: #F59E0B; border: 1px solid rgba(245,158,11,0.2); }
    </style>

    {% block extra_head %}{% endblock %}
</head>
<body>
<div class="app-layout">

    <nav class="sidenav" id="sidenav">
        <!-- Logo + botão hambúrguer -->
        <div class="sidenav-logo">
            <div class="sidenav-logo-left">
                <div class="logo-mark" style="background:none;box-shadow:none;overflow:hidden;">
                    <img src="{{ url_for('static', filename='img/logo.png') }}"
