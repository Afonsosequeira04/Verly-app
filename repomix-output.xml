<file path="templates/base.html">
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Verly{% endblock %}</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Sora:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    {% block extra_head %}{% endblock %}
</head>
<body>
<div class="app-layout">
    <nav class="sidenav">
        <div class="sidenav-logo">
            <img src="{{ url_for('static', filename='img/logo.png') }}" alt="Verly" style="height:100px;width:auto;margin:0 auto;">
        </div>

        <span class="sidenav-section">Principal</span>
        <ul class="sidenav-menu">
            <li>
                <a href="{{ url_for('dashboard.dashboard') }}" class="nav-link {% if request.endpoint == 'dashboard.dashboard' %}active{% endif %}">
                    <span class="nav-icon">⊞</span>
                    <span>Dashboard</span>
                </a>
            </li>
            <li>
                <a href="{{ url_for('faturas.faturas') }}" class="nav-link {% if request.endpoint == 'faturas.faturas' %}active{% endif %}">
                    <span class="nav-icon">🧾</span>
                    <span>Faturas</span>
                </a>
            </li>
            <li>
                <a href="{{ url_for('chat.chat') }}" class="nav-link {% if request.endpoint == 'chat.chat' %}active{% endif %}">
                    <span class="nav-icon">💬</span>
                    <span>Assistente IA</span>
                </a>
            </li>
        </ul>

        <span class="sidenav-section">Ferramentas IA</span>
        <ul class="sidenav-menu">
            <li>
                <a href="{{ url_for('scoring.analisar') }}" class="nav-link {% if request.endpoint and 'scoring' in request.endpoint %}active{% endif %}">
                    <span class="nav-icon">🧠</span>
                    <span>Score de Compras</span>
                </a>
            </li>
            <li>
                <a href="{{ url_for('subscriptions.subscriptions') }}" class="nav-link {% if request.endpoint and 'subscriptions' in request.endpoint %}active{% endif %}">
                    <span class="nav-icon">💸</span>
                    <span>Leak Detector</span>
                </a>
            </li>
            <li>
                <a href="{{ url_for('impulse.impulse') }}" class="nav-link {% if request.endpoint and 'impulse' in request.endpoint %}active{% endif %}">
                    <span class="nav-icon">🛑</span>
                    <span>Impulse Control</span>
                </a>
            </li>
            <li>
                <a href="{{ url_for('reports.relatorio') }}" class="nav-link {% if request.endpoint and 'reports' in request.endpoint %}active{% endif %}">
                    <span class="nav-icon">📊</span>
                    <span>Relatório Mensal</span>
                </a>
            </li>
            <li>
                <a href="{{ url_for('personality.personality') }}" class="nav-link {% if request.endpoint and 'personality' in request.endpoint %}active{% endif %}">
                    <span class="nav-icon">🔥</span>
                    <span>Personalidade</span>
                </a>
            </li>
        </ul>

        <span class="sidenav-section">Conta</span>
        <ul class="sidenav-menu">
            <li>
                <a href="{{ url_for('perfil.perfil') }}" class="nav-link {% if request.endpoint == 'perfil.perfil' %}active{% endif %}">
                    <span class="nav-icon">👤</span>
                    <span>Perfil</span>
                </a>
            </li>
        </ul>

        <div class="sidenav-footer">
            <div class="user-info">
                <div class="user-avatar">{{ current_user.nome[0].upper() }}</div>
                <div class="user-details">
                    <span class="user-name">{{ current_user.nome }}</span>
                    <span class="user-role">Utilizador</span>
                </div>
            </div>
            <a href="{{ url_for('auth.logout') }}" class="btn-logout" title="Sair">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
            </a>
        </div>
    </nav>

    <main class="main-content">
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                <div class="flash-messages">
                    {% for category, message in messages %}
                        <div class="flash flash-{{ category }}">{{ message }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endwith %}
        {% block content %}{% endblock %}
    </main>
</div>
<script src="{{ url_for('static', filename='js/main.js') }}"></script>
{% block extra_scripts %}{% endblock %}
</body>
</html>
