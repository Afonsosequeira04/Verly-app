      Animated.timing(slideY,  { toValue: 0, duration: 600, easing: Easing.out(Easing.cubic), useNativeDriver: true }),
    ]).start();
  }, []);

  return (
    <View style={s.root}>
      <Animated.View style={[s.content, { opacity, transform: [{ translateY: slideY }] }]}>

        {/* Logo */}
