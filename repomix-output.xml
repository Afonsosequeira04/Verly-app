// ── Exportar PDF ───────────────────────────────────────────────────────────────

export const exportarAPI = {
  // Abre o PDF no browser (URL com token)
  pdfUrl: async () => {
    const token = await getToken();
    const BASE = 'https://verly-app-production.up.railway.app/api/v1';
    return `${BASE}/exportar/pdf?_token=${token}`;
  },
};

