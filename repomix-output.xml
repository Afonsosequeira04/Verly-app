.stat-icon-wrap.blue   { background: rgba(74,58,255,0.12);  color: var(--brand-2); }
.stat-icon-wrap.green  { background: rgba(0,214,143,0.10);  color: #00D68F; }
.stat-icon-wrap.yellow { background: rgba(255,184,0,0.10);  color: #FFB800; }
.perfil-stat-val {
