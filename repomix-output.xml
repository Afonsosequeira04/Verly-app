<file path="templates/auth/login.html">
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Entrar · Verly</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Sora:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
</head>
<body class="auth-body">
<div class="auth-container">
    <div class="auth-left">
        <div class="auth-logo-wrap">
            <div class="auth-logo-icon">
                <img src="{{ url_for('static', filename='img/logo.png') }}" alt="Verly" style="height:48px;width:auto;">
            </div>
            <span class="auth-brand-name">Verly</span>
        </div>

        <div class="auth-hero">
            <h1>Track it.<br><span>Verify it.</span><br>Never lose a deadline.</h1>
            <p>Analisa as tuas faturas com IA, rastreia garantias e nunca percas um prazo de devolução.</p>
        </div>

        <div class="auth-features">
            <div class="auth-feature">
                <div class="auth-feature-dot"></div>
                <span>Análise de faturas com IA em segundos</span>
            </div>
            <div class="auth-feature">
                <div class="auth-feature-dot"></div>
                <span>Alertas automáticos de garantias e devoluções</span>
            </div>
            <div class="auth-feature">
                <div class="auth-feature-dot"></div>
                <span>Relatórios financeiros exportáveis em PDF</span>
            </div>
        </div>
    </div>

    <div class="auth-right">
        <div class="auth-card">
            <p class="auth-sub" style="margin-bottom:4px;font-size:12px;letter-spacing:1px;text-transform:uppercase;color:var(--text-sub);font-weight:600;">Bem-vindo de volta</p>
            <h2 class="auth-card-title">Iniciar sessão</h2>
            <p class="auth-sub">Introduz as tuas credenciais para continuar.</p>

            {% with messages = get_flashed_messages(with_categories=true) %}
                {% if messages %}{% for category, message in messages %}
                    <div class="flash flash-{{ category }}">{{ message }}</div>
                {% endfor %}{% endif %}
            {% endwith %}

            <form method="POST">
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" name="email" placeholder="o.teu@email.com" required autofocus>
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" placeholder="••••••••" required>
                </div>
                <div class="form-check">
                    <input type="checkbox" name="remember" id="remember">
                    <label for="remember">Lembrar-me neste dispositivo</label>
                </div>
                <button type="submit" class="btn-primary">Entrar →</button>
            </form>

            <p class="auth-switch">Ainda não tens conta? <a href="{{ url_for('auth.register') }}">Criar conta gratuita</a></p>
        </div>
    </div>
</div>
</body>
</html>
</file>

<file path="templates/auth/register.html">
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar conta · Verly</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Sora:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
</head>
<body class="auth-body">
<div class="auth-container">
    <div class="auth-left">
        <div class="auth-logo-wrap">
            <div class="auth-logo-icon">
                <img src="{{ url_for('static', filename='img/logo.png') }}" alt="Verly" style="height:48px;width:auto;">
            </div>
            <span class="auth-brand-name">Verly</span>
        </div>

        <div class="auth-hero">
            <h1>Começa a <span>verificar</span> as tuas finanças hoje.</h1>
            <p>Junta-te ao Verly e deixa a IA tratar das tuas faturas, garantias e prazos.</p>
        </div>

        <div class="auth-features">
            <div class="auth-feature">
                <div class="auth-feature-dot"></div>
                <span>Upload de PDFs e imagens de faturas</span>
            </div>
            <div class="auth-feature">
                <div class="auth-feature-dot"></div>
                <span>Dados isolados e privados por utilizador</span>
            </div>
            <div class="auth-feature">
                <div class="auth-feature-dot"></div>
                <span>Assistente IA para dúvidas sobre os teus gastos</span>
            </div>
        </div>
    </div>

    <div class="auth-right">
        <div class="auth-card">
            <p class="auth-sub" style="margin-bottom:4px;font-size:12px;letter-spacing:1px;text-transform:uppercase;color:var(--text-sub);font-weight:600;">Novo utilizador</p>
            <h2 class="auth-card-title">Criar conta</h2>
            <p class="auth-sub">É rápido e gratuito. Começa agora.</p>

            {% with messages = get_flashed_messages(with_categories=true) %}
                {% if messages %}{% for category, message in messages %}
                    <div class="flash flash-{{ category }}">{{ message }}</div>
                {% endfor %}{% endif %}
            {% endwith %}

            <form method="POST">
                <div class="form-group">
                    <label>Nome</label>
                    <input type="text" name="nome" placeholder="O teu nome" required autofocus>
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" name="email" placeholder="o.teu@email.com" required>
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" placeholder="Mínimo 6 caracteres" required>
                </div>
                <div class="form-group">
                    <label>Confirmar Password</label>
                    <input type="password" name="confirm_password" placeholder="Repete a password" required>
                </div>
                <button type="submit" class="btn-primary">Criar conta →</button>
            </form>

            <p class="auth-switch">Já tens conta? <a href="{{ url_for('auth.login') }}">Iniciar sessão</a></p>
        </div>
    </div>
</div>
</body>
</html>
</file>

<file path="templates/chat.html">
{% extends 'base.html' %}
{% block title %}Assistente IA · Verly{% endblock %}

{% block content %}
<div class="chat-page">
    <div class="chat-topbar">
        <div class="chat-topbar-left">
            <div class="status-dot"></div>
            <h1>Assistente Verly</h1>
        </div>
        <button class="btn-ghost" onclick="clearChat()">Limpar histórico</button>
    </div>

    <div id="messages" class="messages-area">
        {% if conversas %}
            {% for c in conversas %}
            <div class="msg user">
                <div class="msg-avatar">{{ current_user.nome[0].upper() }}</div>
                <div class="msg-bubble">{{ c.pergunta }}</div>
            </div>
            <div class="msg bot">
                <div class="msg-avatar">✦</div>
                <div class="msg-bubble">{{ c.resposta }}</div>
            </div>
            {% endfor %}
        {% else %}
        <div class="empty-chat" id="emptyChat">
            <div class="empty-chat-icon">✦</div>
            <h3>Assistente Verly</h3>
            <p>Faz perguntas sobre as tuas faturas ou gastos.</p>
        </div>
        {% endif %}
    </div>

    <div class="chat-input-area">
        <textarea id="userInput" placeholder="Pergunta algo..."
            onkeydown="handleKey(event)" oninput="autoResize(this)" rows="1"></textarea>
        <button class="btn-send" id="btnSend" onclick="sendMessage()">↑</button>
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
let emptyRemoved = {{ 'true' if conversas else 'false' }};

window.addEventListener('load', () => {
    const m = document.getElementById('messages');
    m.scrollTop = m.scrollHeight;
});

function removeEmpty() {
    if (!emptyRemoved) {
        const el = document.getElementById('emptyChat');
        if (el) el.remove();
        emptyRemoved = true;
    }
}

function addMsg(role, text, avatar) {
    removeEmpty();

    const m = document.getElementById('messages');
    const d = document.createElement('div');
    d.className = 'msg ' + role;

    d.innerHTML = `
        <div class="msg-avatar">${avatar}</div>
        <div class="msg-bubble">${text}</div>
    `;

    m.appendChild(d);
    m.scrollTop = m.scrollHeight;

    return d.querySelector('.msg-bubble');
}

// 🔥 STREAMING REAL
async function sendMessage() {
    const input = document.getElementById('userInput');
    const btn = document.getElementById('btnSend');

    const text = input.value.trim();
    if (!text) return;

    addMsg('user', text, '{{ current_user.nome[0].upper() }}');

    input.value = '';
    input.style.height = 'auto';
    btn.disabled = true;

    // cria mensagem vazia do bot
    const bubble = addMsg('bot', '', '✦');

    let fullText = "";

    try {
        const res = await fetch('/chat/stream', {
            method: 'POST',
            headers: {'Content-Type':'application/json'},
            body: JSON.stringify({message: text})
        });

        const reader = res.body.getReader();
        const decoder = new TextDecoder("utf-8");

        while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            const chunk = decoder.decode(value);
            const lines = chunk.split("\n");

            lines.forEach(line => {
                if (line.startsWith("data: ")) {
                    const t = line.replace("data: ", "");
                    fullText += t;

                    // efeito cursor
                    bubble.innerHTML = fullText + '<span class="cursor">▍</span>';

                    const m = document.getElementById('messages');
                    m.scrollTop = m.scrollHeight;
                }
            });
        }

        // remove cursor no fim
        bubble.innerHTML = fullText;

    } catch (e) {
        bubble.innerHTML = "Erro de ligação.";
    }

    btn.disabled = false;
}

async function clearChat() {
    if (!confirm('Apagar todo o histórico?')) return;
    await fetch('/chat/clear', {method:'POST'});
    location.reload();
}

function handleKey(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
    }
}

function autoResize(el) {
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight, 120) + 'px';
}
</script>

<style>
.cursor {
    display: inline-block;
    margin-left: 2px;
    animation: blink 1s infinite;
}

@keyframes blink {
    0% {opacity: 1;}
    50% {opacity: 0;}
    100% {opacity: 1;}
}
</style>
{% endblock %}
</file>

