            <ul class="sidenav-menu">
                <li>
                    <a href="{{ url_for('perfil.perfil') }}"
                       class="nav-link {% if request.endpoint == 'perfil.perfil' %}active{% endif %}"
                       data-tooltip="Perfil">
                        <span class="nav-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                        </span>
                        <span class="nav-label">Perfil</span>
                    </a>
                </li>
                <li>
                    <a href="{{ url_for('configuracoes.configuracoes') }}"
                       class="nav-link {% if request.endpoint and 'configuracoes' in request.endpoint %}active{% endif %}"
                       data-tooltip="Configurações">
                        <span class="nav-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="3"/>
                                <path d="M19.07 4.93l-1.41 1.41M5.34 18.66l-1.41 1.41M20 12h2M2 12h2M19.07 19.07l-1.41-1.41M5.34 5.34 3.93 3.93M12 20v2M12 2v2"/>
                            </svg>
