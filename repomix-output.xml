                        </div>
                    </td>
                    <td>
                        <select class="cat-select" onchange="editarCategoria({{ f.id }}, this.value)" onclick="event.stopPropagation()">
                            {% for cat in categorias %}
                            <option value="{{ cat }}" {% if cat == f.categoria %}selected{% endif %}>{{ cat }}</option>
                            {% endfor %}
                        </select>
                    </td>
                    <td class="text-muted">{{ f.data_compra or '—' }}</td>
                    <td class="{% if f.total and f.total > 100 %}text-danger{% endif %}" style="font-weight:600;">
                        {% if f.total %}{{ "%.2f"|format(f.total) }} €{% else %}—{% endif %}
                    </td>
                    <td onclick="event.stopPropagation()">
                        {% if f.items_list %}
                        <div class="items-chip">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                            {{ f.items_list|length }}
                            <div class="items-tooltip">
                                <ul>
                                {% for item in f.items_list[:6] %}
                                    <li>{{ item }}</li>
                                {% endfor %}
                                {% if f.items_list|length > 6 %}
                                    <li style="color:var(--text-muted);">+{{ f.items_list|length - 6 }} mais...</li>
                                {% endif %}
                                </ul>
                            </div>
                        </div>
                        {% else %}
                        <span style="color:var(--text-sub);font-size:12px;">—</span>
                        {% endif %}
                    </td>
                    <td>
                        <div style="display:flex;flex-direction:column;gap:3px;">
                            {% if f.data_devolucao %}
                            <span style="font-size:11px;color:var(--yellow);">Dev: {{ f.data_devolucao }}</span>
                            {% endif %}
                            {% if f.data_garantia %}
                            <span style="font-size:11px;color:var(--green);">Gar: {{ f.data_garantia }}</span>
                            {% endif %}
                            {% if not f.data_devolucao and not f.data_garantia %}
                            <span style="color:var(--text-sub);font-size:12px;">—</span>
                            {% endif %}
                        </div>
                    </td>
                    <td onclick="event.stopPropagation()">
                        <div style="display:flex;gap:6px;align-items:center;">
                            <a href="/faturas/{{ f.id }}" style="display:flex;align-items:center;padding:5px 10px;background:var(--surface3);border:1px solid var(--border);border-radius:7px;color:var(--text-muted);font-size:12px;text-decoration:none;gap:4px;transition:all 0.2s;" onmouseover="this.style.borderColor='var(--brand)';this.style.color='var(--brand)'" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-muted)'">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                Ver
                            </a>
                            <button class="btn-delete" onclick="deleteFatura({{ f.id }})">✕</button>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <div class="empty-card">
            <div style="width:48px;height:48px;background:var(--surface2);border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <p>Nenhuma fatura encontrada.<br>
            {% if search or categoria_sel %}Tenta outros filtros.{% else %}Submete uma fatura acima para começar.{% endif %}</p>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
let selectedFile = null;

function goToDetail(e, id) {
    window.location.href = '/faturas/' + id;
}

function handleFileSelect(input) {
    selectedFile = input.files[0];
    if (selectedFile) {
        document.getElementById('uploadLabel').textContent = selectedFile.name;
        document.getElementById('uploadSub').textContent = (selectedFile.size / 1024).toFixed(1) + ' KB';
        document.getElementById('btnUpload').style.display = 'block';
    }
}

const zone = document.getElementById('uploadZone');
zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-over'); });
zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
zone.addEventListener('drop', e => {
    e.preventDefault(); zone.classList.remove('drag-over');
    const file = e.dataTransfer.files[0];
    if (file) {
        selectedFile = file;
        document.getElementById('uploadLabel').textContent = file.name;
        document.getElementById('uploadSub').textContent = (file.size / 1024).toFixed(1) + ' KB';
        document.getElementById('btnUpload').style.display = 'block';
    }
});

async function uploadFile() {
    if (!selectedFile) return;
    const btn = document.getElementById('btnUpload');
    btn.disabled = true; btn.textContent = 'A analisar...';
    setStatus('loading', 'A analisar a fatura com IA...');
    const formData = new FormData();
    formData.append('file', selectedFile);
    try {
        const res = await fetch('/faturas/upload', { method: 'POST', body: formData });
        const data = await res.json();
        if (data.success) {
            setStatus('success', `✓ ${data.message} — ${data.loja} · ${data.categoria}`);
            setTimeout(() => location.reload(), 1500);
        } else {
            setStatus('error', '✗ ' + data.message);
        }
    } catch(e) { setStatus('error', '✗ Erro de ligação.'); }
    btn.disabled = false; btn.textContent = 'Analisar com IA →';
}

function setStatus(type, msg) {
    const el = document.getElementById('uploadStatus');
    el.className = 'upload-status ' + type;
    el.textContent = msg;
}

async function editarCategoria(id, valor) {
    await fetch(`/faturas/editar/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ categoria: valor })
    });
}

async function deleteFatura(id) {
    if (!confirm('Remover esta fatura?')) return;
    const res = await fetch(`/faturas/delete/${id}`, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) document.getElementById('row-' + id).remove();
}
</script>
{% endblock %}
</file>

