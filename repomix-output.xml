                            <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/>
                        </svg>
                    </span>
                    <span>Faturas</span>
                </a>
            </li>
            <li>
                <a href="{{ url_for('chat.chat') }}" class="nav-link {% if request.endpoint == 'chat.chat' %}active{% endif %}">
                    <span class="nav-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                    </span>
                    <span>Assistente IA</span>
                </a>
            </li>
            <li>
                <a href="{{ url_for('metas.metas') }}" class="nav-link {% if request.endpoint and 'metas' in request.endpoint %}active{% endif %}">
                    <span class="nav-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
                        </svg>
                    </span>
                    <span>Metas</span>
                </a>
            </li>
        </ul>

        <span class="sidenav-section">Ferramentas</span>
        <ul class="sidenav-menu">
            <li>
                <a href="{{ url_for('scoring.analisar') }}" class="nav-link {% if request.endpoint and 'scoring' in request.endpoint %}active{% endif %}">
                    <span class="nav-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                        </svg>
                    </span>
                    <span>Score de Compras</span>
                </a>
            </li>
            <li>
                <a href="{{ url_for('subscriptions.subscriptions') }}" class="nav-link {% if request.endpoint and 'subscriptions' in request.endpoint %}active{% endif %}">
                    <span class="nav-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    </span>
                    <span>Leak Detector</span>
                </a>
            </li>
            <li>
                <a href="{{ url_for('impulse.impulse') }}" class="nav-link {% if request.endpoint and 'impulse' in request.endpoint %}active{% endif %}">
                    <span class="nav-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                    </span>
                    <span>Impulse Control</span>
                </a>
            </li>
            <li>
                <a href="{{ url_for('reports.relatorio') }}" class="nav-link {% if request.endpoint and 'reports' in request.endpoint %}active{% endif %}">
                    <span class="nav-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                        </svg>
                    </span>
                    <span>Relatório Mensal</span>
                </a>
            </li>
            <li>
                <a href="{{ url_for('personality.personality') }}" class="nav-link {% if request.endpoint and 'personality' in request.endpoint %}active{% endif %}">
                    <span class="nav-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
