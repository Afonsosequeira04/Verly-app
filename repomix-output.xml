        </div><!-- /sidenav-scroll -->

        <!-- Footer: utilizador + logout -->
        <div class="sidenav-footer">
            <div class="user-info">
                <div class="user-avatar">{{ current_user.nome[0].upper() }}</div>
                <div class="user-details">
                    <span class="user-name">{{ current_user.nome }}</span>
                    <span class="user-role">{{ current_user.personalidade|capitalize if current_user.personalidade else 'Calmo' }}</span>
                </div>
            </div>
            <a href="{{ url_for('auth.logout') }}" class="btn-logout" title="Sair">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
            </a>
        </div>
    </nav>

    <main class="main-content" id="mainContent">
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                <div class="flash-messages">
                    {% for category, message in messages %}
                        <div class="flash flash-{{ category }}">{{ message }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endwith %}
        {% block content %}{% endblock %}
    </main>
</div>

<script src="{{ url_for('static', filename='js/main.js') }}"></script>
<script>
// ── Sidebar toggle ────────────────────────────────────────────────────────────
(function () {
    const nav    = document.getElementById('sidenav');
    const main   = document.getElementById('mainContent');
    const toggle = document.getElementById('navToggle');
    const icon   = document.getElementById('toggleIcon');
    const KEY    = 'verly_nav_collapsed';

    const ICON_HAMBURGER = `
        <line x1="3" y1="6"  x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>`;
    const ICON_CLOSE = `
        <line x1="18" y1="6" x2="6"  y2="18"/>
        <line x1="6"  y1="6" x2="18" y2="18"/>`;

    function apply(collapsed) {
        nav.classList.toggle('collapsed', collapsed);
        main.style.marginLeft = collapsed ? 'var(--nav-collapsed)' : 'var(--nav-width)';
        icon.innerHTML        = collapsed ? ICON_CLOSE : ICON_HAMBURGER;
        toggle.title          = collapsed ? 'Expandir menu' : 'Colapsar menu';
        localStorage.setItem(KEY, collapsed ? '1' : '0');
    }

    apply(localStorage.getItem(KEY) === '1');
    toggle.addEventListener('click', () => apply(!nav.classList.contains('collapsed')));
})();
</script>
{% block extra_scripts %}{% endblock %}

<script>
// ── Theme toggle ───────────────────────────────────────────────────────────────
(function () {
    const THEME_KEY = 'verly_theme';
    const MOON_ICON = `<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>`;
    const SUN_ICON  = `<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>`;

    const btn  = document.getElementById('themeToggle');
    const icon = document.getElementById('themeIcon');
    const html = document.documentElement;

    function applyTheme(theme) {
        html.setAttribute('data-theme', theme);
        icon.innerHTML = theme === 'light' ? MOON_ICON : SUN_ICON;
        btn.title      = theme === 'light' ? 'Mudar para modo escuro' : 'Mudar para modo claro';
        localStorage.setItem(THEME_KEY, theme);
    }

    const saved = localStorage.getItem(THEME_KEY) || 'dark';
    applyTheme(saved);

    btn.addEventListener('click', () => {
        const current = html.getAttribute('data-theme') || 'dark';
        applyTheme(current === 'dark' ? 'light' : 'dark');
    });
})();

// ── CSRF: intercepta todos os fetch() ─────────────────────────────────────────
(function () {
    const _originalFetch = window.fetch;
    window.fetch = function(url, opts) {
        opts = opts || {};
        opts.headers = opts.headers || {};
        const method = (opts.method || 'GET').toUpperCase();
        if (['POST', 'PUT', 'PATCH', 'DELETE'].includes(method)) {
            const csrfToken = document.querySelector('meta[name="csrf-token"]') &&
                              document.querySelector('meta[name="csrf-token"]').content;
            if (csrfToken) {
                if (opts.headers['Content-Type'] === 'application/json' || typeof opts.body === 'string') {
                    opts.headers['X-CSRFToken'] = csrfToken;
                }
                if (opts.body instanceof FormData) {
                    opts.body.set('csrf_token', csrfToken);
                }
            }
        }
        return _originalFetch(url, opts);
    };
})();

// ── Notificações ──────────────────────────────────────────────────────────────
(function () {
    let panelOpen   = false;
    let notifLoaded = false;

    const URGENCIA_CLASSES = {
        'alta':  'notif-urgencia-alta',
        'media': 'notif-urgencia-media',
        'info':  'notif-urgencia-info',
    };

    function toggleNotifPanel(e) {
        e && e.stopPropagation();
        panelOpen = !panelOpen;
        const panel = document.getElementById('notifPanel');
        panel.classList.toggle('open', panelOpen);
        if (panelOpen) {
            // Position panel below the bell button, aligned to its left edge
            const bell = document.getElementById('notifBell');
            const rect = bell.getBoundingClientRect();
            panel.style.top  = (rect.bottom + 8) + 'px';
            panel.style.left = rect.left + 'px';
            // Keep inside viewport horizontally
            const panelW = 300;
            if (rect.left + panelW > window.innerWidth - 8) {
                panel.style.left = (window.innerWidth - panelW - 8) + 'px';
            }
            if (!notifLoaded) loadNotificacoes();
        }
    }

    // Expose globally so the bell button onclick can call it
    window.toggleNotifPanel = toggleNotifPanel;

    // Close panel when clicking outside
    document.addEventListener('click', function(e) {
        if (panelOpen && !document.getElementById('notifWrap').contains(e.target)) {
            panelOpen = false;
            document.getElementById('notifPanel').classList.remove('open');
        }
    });

    async function loadNotificacoes() {
        notifLoaded = true;
        try {
            const res  = await fetch('/notificacoes/api');
            const data = await res.json();

            if (!data.success) return;

            const badge = document.getElementById('notifBadge');
            const count = document.getElementById('notifCount');
            const list  = document.getElementById('notifList');

            const n = data.total;

            // Badge
            if (n > 0) {
                badge.textContent = n > 9 ? '9+' : String(n);
                badge.classList.add('visible');
            } else {
                badge.classList.remove('visible');
            }
            count.textContent = n > 0 ? `${n} alerta${n !== 1 ? 's' : ''}` : 'Tudo em ordem';

            if (n === 0) {
                list.innerHTML = `
                    <div class="notif-empty">
                        <div class="notif-empty-icon">✅</div>
                        Nenhuma notificação por agora.
                    </div>`;
                return;
            }

            list.innerHTML = data.notificacoes.map(notif => `
                <div class="notif-item ${URGENCIA_CLASSES[notif.urgencia] || ''}"
                     onclick="window.location.href='${notif.link || '#'}'">
                    <div class="notif-item-icon">${notif.icone}</div>
                    <div class="notif-item-body">
                        <div class="notif-item-title">${notif.titulo}</div>
                        <div class="notif-item-msg">${notif.mensagem}</div>
                    </div>
                </div>
            `).join('');

        } catch(e) {
            console.warn('Notificações não carregaram:', e);
        }
    }

    // Load badge count on page load (without opening panel)
    async function preloadBadge() {
        try {
            const res  = await fetch('/notificacoes/api');
            const data = await res.json();
            if (data.success && data.total > 0) {
                const badge = document.getElementById('notifBadge');
                badge.textContent = data.total > 9 ? '9+' : String(data.total);
                badge.classList.add('visible');
            }
        } catch(_) {}
    }

    // Slight delay so it doesn't block page render
    setTimeout(preloadBadge, 800);
})();
</script>
</body>
