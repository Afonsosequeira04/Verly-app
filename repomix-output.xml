{% block extra_scripts %}
<script>
let personalidadeAtual = '{{ personalidade_atual }}';
function selecionarPersonalidade(key, btn) {
    personalidadeAtual = key;
    document.querySelectorAll('.pers-pill').forEach(b => {
        const active = b.dataset.p === key;
        b.style.background  = active ? 'rgba(123,97,255,0.1)' : 'var(--surface2)';
        b.style.color       = active ? 'var(--brand-2)' : 'var(--text-muted)';
        b.style.borderColor = active ? 'var(--brand-2)' : 'var(--border)';
    });
    fetch('/personality/set',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({personalidade:key})});
}
async function analisarImpulso() {
    const produto = document.getElementById('impulseInput').value.trim();
    if (!produto) { alert('Descreve o que queres comprar.'); return; }
    document.getElementById('impulseResult').style.display = 'block';
    document.getElementById('impulseLoading').style.display = 'block';
    document.getElementById('impulseContent').style.display = 'none';
    try {
        const res = await fetch('/impulse/analyze',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({produto,personalidade:personalidadeAtual})});
        const data = await res.json();
        document.getElementById('impulseLoading').style.display = 'none';
        if (data.success) {
            const r = data.resultado;
            document.getElementById('resAnalise').textContent = r.analise;
            document.getElementById('resAlternativa').textContent = r.alternativa;
            if (r.aguardar) {
                document.getElementById('bannerAguardar').style.display='block';
                document.getElementById('bannerOk').style.display='none';
                document.getElementById('resVeredicto').textContent=r.veredicto;
            } else {
                document.getElementById('bannerAguardar').style.display='none';
                document.getElementById('bannerOk').style.display='block';
                document.getElementById('resVeredictoOk').textContent=r.veredicto;
            }
            document.getElementById('impulseContent').style.display='block';
        } else { alert('Erro: '+(data.message||'Tenta de novo.')); document.getElementById('impulseResult').style.display='none'; }
    } catch(e) { alert('Erro de ligação.'); document.getElementById('impulseResult').style.display='none'; }
}
document.getElementById('impulseInput').addEventListener('keydown',e=>{if(e.key==='Enter'&&e.ctrlKey)analisarImpulso();});
</script>
{% endblock %}
