}
.field-input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(74,58,255,0.12); }
.field-input:disabled { opacity: 0.3; cursor: not-allowed; }

.check-row {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 14px;
    background: var(--surface2); border: 1px solid var(--border); border-radius: 10px;
    cursor: pointer; transition: border-color 0.2s;
}
.check-row:hover { border-color: var(--border-hover); }
.check-row input[type=checkbox] { accent-color: var(--brand); width: 15px; height: 15px; flex-shrink: 0; cursor: pointer; }
.check-row span { font-size: 13px; color: var(--text-sub); }

.card-danger-zone {
    background: rgba(255,71,87,0.04); border: 1px solid rgba(255,71,87,0.14);
    border-radius: var(--radius); padding: 24px; margin-top: 20px;
}
.card-danger-zone h3 {
    font-size: 12px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 1px; color: #FF4757; margin-bottom: 8px;
    display: flex; align-items: center; gap: 8px;
}
.card-danger-zone p { font-size: 13px; color: var(--text-muted); line-height: 1.6; margin-bottom: 16px; }
.btn-danger-outline {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 20px; border-radius: 10px;
    border: 1px solid rgba(255,71,87,0.35); background: transparent;
    color: #FF4757; font-size: 13px; font-weight: 600;
    cursor: pointer; font-family: 'Outfit', sans-serif; transition: all 0.2s;
}
.btn-danger-outline:hover { background: rgba(255,71,87,0.08); border-color: #FF4757; }
.avatar-wrapper.uploading { opacity: 0.6; pointer-events: none; }
</style>
{% endblock %}

{% block content %}
<div class="page-header">
