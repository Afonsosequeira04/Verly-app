<file path="templates/perfil.html">
{% extends 'base.html' %}
{% block title %}Perfil · Verly{% endblock %}

{% block extra_head %}
<style>
.perfil-hero {
    background: linear-gradient(135deg, rgba(74,58,255,0.12) 0%, rgba(123,97,255,0.06) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 32px;
    display: flex;
    align-items: center;
    gap: 28px;
    margin-bottom: 24px;
    position: relative;
    overflow: hidden;
}
.perfil-hero::before {
    content: '';
    position: absolute;
    top: -80px; right: -80px;
    width: 240px; height: 240px;
    background: radial-gradient(circle, rgba(74,58,255,0.12), transparent 70%);
    pointer-events: none;
}
.avatar-wrapper {
    position: relative;
    flex-shrink: 0;
    cursor: pointer;
}
.avatar-wrapper:hover .avatar-overlay { opacity: 1; }
.avatar-img {
    width: 80px; height: 80px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    box-shadow: 0 0 0 3px rgba(74,58,255,0.3);
}
.avatar-initial {
    width: 80px; height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    display: flex; align-items: center; justify-content: center;
    font-family: 'Sora', sans-serif;
    font-size: 30px; font-weight: 700; color: #fff;
    box-shadow: 0 0 0 3px rgba(74,58,255,0.3);
}
.avatar-overlay {
    position: absolute; inset: 0;
    border-radius: 50%;
    background: rgba(0,0,0,0.55);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 2px;
    opacity: 0;
    transition: opacity 0.2s;
}
.avatar-overlay svg { color: #fff; }
.avatar-overlay span { font-size: 10px; font-weight: 600; color: #fff; }
#avatarInput { display: none; }
.perfil-hero-info h2 {
    font-family: 'Sora', sans-serif;
    font-size: 22px; font-weight: 700;
    color: var(--text); margin-bottom: 4px;
}
.perfil-hero-info p { font-size: 13px; color: var(--text-muted); }
.hero-meta { font-size: 11px; color: var(--text-sub); margin-top: 6px; display: flex; align-items: center; gap: 5px; }

.perfil-stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 24px;
}
.perfil-stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px 16px;
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    transition: border-color 0.2s;
}
.perfil-stat-card:hover { border-color: var(--border-hover); }
.stat-icon-wrap {
    width: 40px; height: 40px;
    border-radius: 11px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 2px;
}
.stat-icon-wrap.blue   { background: rgba(74,58,255,0.12);  color: var(--brand-2); }
.stat-icon-wrap.green  { background: rgba(0,214,143,0.10);  color: #00D68F; }
.stat-icon-wrap.yellow { background: rgba(255,184,0,0.10);  color: #FFB800; }
.perfil-stat-val {
    font-family: 'Sora', sans-serif;
    font-size: 24px; font-weight: 700; color: var(--text);
}
.perfil-stat-label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.8px; }

.perfil-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}
@media (max-width: 860px) { .perfil-grid-2 { grid-template-columns: 1fr; } }

.field-group { display: flex; flex-direction: column; gap: 16px; }
.field-label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.8px;
    text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px; display: block;
}
.field-input {
    width: 100%; background: var(--surface2);
    border: 1px solid var(--border); border-radius: 10px;
    color: var(--text); font-family: 'Outfit', sans-serif; font-size: 14px;
    padding: 11px 14px; outline: none; box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
}
.field-input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(74,58,255,0.12); }
.field-input:disabled { opacity: 0.3; cursor: not-allowed; }

.check-row {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 14px;
    background: var(--surface2); border: 1px solid var(--border); border-radius: 10px;
    cursor: pointer; transition: border-color 0.2s;
}
.check-row:hover { border-color: var(--border-hover); }
.check-row input[type=checkbox] { accent-color: var(--brand); width: 15px; height: 15px; flex-shrink: 0; cursor: pointer; }
.check-row span { font-size: 13px; color: var(--text-sub); }

.card-danger-zone {
    background: rgba(255,71,87,0.04); border: 1px solid rgba(255,71,87,0.14);
    border-radius: var(--radius); padding: 24px; margin-top: 20px;
}
.card-danger-zone h3 {
    font-size: 12px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 1px; color: #FF4757; margin-bottom: 8px;
    display: flex; align-items: center; gap: 8px;
}
.card-danger-zone p { font-size: 13px; color: var(--text-muted); line-height: 1.6; margin-bottom: 16px; }
.btn-danger-outline {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 20px; border-radius: 10px;
    border: 1px solid rgba(255,71,87,0.35); background: transparent;
    color: #FF4757; font-size: 13px; font-weight: 600;
    cursor: pointer; font-family: 'Outfit', sans-serif; transition: all 0.2s;
}
.btn-danger-outline:hover { background: rgba(255,71,87,0.08); border-color: #FF4757; }
.avatar-wrapper.uploading { opacity: 0.6; pointer-events: none; }
</style>
{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1 class="page-title">Perfil</h1>
        <p class="page-sub">Gere a tua conta e preferências.</p>
    </div>
</div>

<div class="perfil-hero">
    <div class="avatar-wrapper" id="avatarWrapper" onclick="document.getElementById('avatarInput').click()" title="Alterar foto de perfil">
        {% if current_user.avatar %}
            <img class="avatar-img" id="avatarPreview"
                 src="{{ url_for('perfil.get_avatar', user_id=current_user.id) }}" alt="Avatar">
        {% else %}
            <div class="avatar-initial" id="avatarPreview">{{ current_user.nome[0].upper() }}</div>
        {% endif %}
        <div class="avatar-overlay">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
            </svg>
            <span>Alterar foto</span>
        </div>
        <input type="file" id="avatarInput" accept="image/png,image/jpeg,image/jpg,image/webp,image/gif">
    </div>

    <div class="perfil-hero-info">
        <h2>{{ current_user.nome }}</h2>
        <p>{{ current_user.email }}</p>
        <p class="hero-meta">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Membro desde {{ current_user.criado_em.strftime('%d/%m/%Y') }}
        </p>
    </div>
</div>

<div class="perfil-stats-row">
    <div class="perfil-stat-card">
        <div class="stat-icon-wrap blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
        </div>
        <span class="perfil-stat-val">{{ num_faturas }}</span>
        <span class="perfil-stat-label">Faturas</span>
    </div>
    <div class="perfil-stat-card">
        <div class="stat-icon-wrap green">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
        </div>
        <span class="perfil-stat-val">{{ num_conversas }}</span>
        <span class="perfil-stat-label">Conversas IA</span>
    </div>
    <div class="perfil-stat-card">
        <div class="stat-icon-wrap yellow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="1" x2="12" y2="23"/>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
        </div>
        <span class="perfil-stat-val">{{ "%.0f"|format(total_gasto) }}€</span>
        <span class="perfil-stat-label">Total Gasto</span>
    </div>
</div>

<div class="perfil-grid-2">
    <div class="card">
        <div class="card-header"><h3>Informação Pessoal</h3></div>
        <div class="card-body">
            <form method="POST" action="{{ url_for('perfil.atualizar') }}">
                <div class="field-group">
                    <div>
                        <label class="field-label">Nome</label>
                        <input class="field-input" type="text" name="nome" value="{{ current_user.nome }}" required>
                    </div>
                    <div>
                        <label class="field-label">Email</label>
                        <input class="field-input" type="email" value="{{ current_user.email }}" disabled>
                    </div>
                    <div>
                        <label class="field-label">Email para Notificações</label>
                        <input class="field-input" type="email" name="email_notificacoes"
                               value="{{ current_user.email_notificacoes or '' }}" placeholder="outro@email.com">
                    </div>
                    <label class="check-row">
                        <input type="checkbox" name="notificacoes_email" {% if current_user.notificacoes_email %}checked{% endif %}>
                        <span>Receber alertas de garantia por email</span>
                    </label>
                    <button type="submit" class="btn-primary" style="width:100%;">Guardar Alterações</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h3>Alterar Password</h3></div>
        <div class="card-body">
            <form method="POST" action="{{ url_for('perfil.alterar_password') }}">
                <div class="field-group">
                    <div>
                        <label class="field-label">Password Atual</label>
                        <input class="field-input" type="password" name="password_atual" required placeholder="••••••••">
                    </div>
                    <div>
                        <label class="field-label">Nova Password</label>
                        <input class="field-input" type="password" name="password_nova" required placeholder="Mínimo 6 caracteres">
                    </div>
                    <div>
                        <label class="field-label">Confirmar Nova Password</label>
                        <input class="field-input" type="password" name="confirmar_password" required placeholder="Repete a password">
                    </div>
                    <button type="submit" class="btn-primary" style="width:100%;margin-top:4px;">Alterar Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="card-danger-zone">
    <h3>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        Zona de Perigo
    </h3>
    <p>Eliminar conta apaga permanentemente todos os teus dados, faturas e histórico de conversas. Esta ação é irreversível.</p>
    <button class="btn-danger-outline" onclick="confirmarEliminar()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
            <path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
        </svg>
        Eliminar Conta Permanentemente
    </button>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
document.getElementById('avatarInput').addEventListener('change', async function () {
    const file = this.files[0];
    if (!file) return;

    const wrapper = document.getElementById('avatarWrapper');
    wrapper.classList.add('uploading');

    const fd = new FormData();
    fd.append('avatar', file);

    try {
        const res  = await fetch('{{ url_for("perfil.upload_avatar") }}', { method: 'POST', body: fd });
        const data = await res.json();

        if (data.success) {
            const preview = document.getElementById('avatarPreview');
            const newSrc  = data.avatar_url + '?t=' + Date.now();
            if (preview.tagName === 'DIV') {
                const img = document.createElement('img');
                img.className = 'avatar-img';
                img.id = 'avatarPreview';
                img.alt = 'Avatar';
                img.src = newSrc;
                preview.replaceWith(img);
            } else {
                preview.src = newSrc;
            }
        } else {
            alert(data.message || 'Erro ao fazer upload.');
        }
    } catch (e) {
        alert('Erro de rede. Tenta novamente.');
    } finally {
        wrapper.classList.remove('uploading');
        this.value = '';
    }
});

function confirmarEliminar() {
    const conf = prompt('Escreve "ELIMINAR" para confirmar:');
    if (conf === 'ELIMINAR') {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '{{ url_for("perfil.eliminar_conta") }}';
        document.body.appendChild(form);
        form.submit();
    }
}
</script>
{% endblock %}
</file>

<file path="templates/subscriptions.html">
{% extends 'base.html' %}
{% block title %}Leak Detector · Verly{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1 class="page-title">Subscription Leak Detector</h1>
        <p class="page-sub">Descobre subscrições esquecidas que estão a drenar a tua conta todos os meses</p>
    </div>
</div>

<!-- MÉTRICAS RESUMO -->
<div class="metrics-grid" style="grid-template-columns: repeat(3,1fr); margin-bottom:24px;">
    <div class="metric-card">
        <div class="metric-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
        </div>
        <div class="metric-body">
            <span class="metric-label">Desperdiçado / mês</span>
            <span class="metric-value metric-value-sm" style="color:var(--red)">{{ '%.2f'|format(total_mensal_desperdicado) }}€</span>
            <span class="metric-trend trend-bad">≈ {{ '%.0f'|format(total_anual_desperdicado) }}€/ano</span>
        </div>
    </div>
    <div class="metric-card">
        <div class="metric-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
            </svg>
        </div>
        <div class="metric-body">
            <span class="metric-label">Subscr. saudáveis</span>
            <span class="metric-value metric-value-sm" style="color:var(--green)">{{ count_ok }}</span>
            <span class="metric-trend trend-ok">{{ '%.2f'|format(total_mensal_ok) }}€/mês</span>
        </div>
    </div>
    <div class="metric-card">
        <div class="metric-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--yellow)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
        </div>
        <div class="metric-body">
            <span class="metric-label">Em risco</span>
            <span class="metric-value metric-value-sm" style="color:var(--yellow)">{{ count_danger + count_warning }}</span>
            <span class="metric-trend trend-bad">{{ count_danger }} para cancelar</span>
        </div>
    </div>
</div>

<!-- UPLOAD EXTRATO — zona principal de ação -->
<div class="card" style="margin-bottom:24px;">
    <div class="card-header">
        <h3>Analisar Extrato Bancário</h3>
        <span style="font-size:12px;color:var(--text-muted)">TXT ou CSV exportado do teu banco</span>
    </div>
    <div class="card-body">
        <!-- Upload zone com z-index corretamente gerido -->
        <div class="upload-zone-lg" id="dropZone">
            <!-- O input fica por cima de tudo via z-index:2 no CSS -->
            <input type="file" id="extratoInput" accept=".txt,.csv" onchange="analisarExtrato(this.files[0])">
            <span class="uz-icon">📄</span>
            <span class="uz-title">Arrasta o extrato aqui ou clica para escolher</span>
            <span class="uz-sub">Suporta extratos em TXT e CSV de qualquer banco português</span>
            <div class="uz-formats">
                <span class="uz-format-tag">.txt</span>
                <span class="uz-format-tag">.csv</span>
            </div>
        </div>

        <div id="uploadStatus" style="display:none; margin-top:16px; padding:12px 16px; border-radius:9px; font-size:13px; font-weight:500;"></div>
    </div>
</div>

<!-- RESULTADO DO EXTRATO (aparece após upload) -->
<div id="resultadoExtrato" style="display:none; margin-bottom:24px;"></div>

{% if subscriptions %}
<!-- SUBSCRIÇÕES DAS FATURAS -->
<div class="card" style="margin-bottom:24px;">
    <div class="card-header">
        <h3>Subscrições nas Faturas</h3>
        <span style="font-size:12px;color:var(--text-muted)">{{ subscriptions|length }} serviço(s) detetado(s)</span>
    </div>
    <div class="card-body" style="padding:0;">
        {% for sub in subscriptions %}
        <div style="display:flex;align-items:center;gap:14px;padding:14px 18px;border-bottom:1px solid var(--border);transition:background var(--transition);"
             onmouseover="this.style.background='var(--surface2)'" onmouseout="this.style.background='transparent'">
            <div style="width:40px;height:40px;border-radius:10px;flex-shrink:0;
                background:{% if sub.risk == 'danger' %}var(--red-bg){% elif sub.risk == 'warning' %}var(--yellow-bg){% else %}var(--green-bg){% endif %};
                display:flex;align-items:center;justify-content:center;font-size:19px;">
                {{ sub.icone }}
            </div>
            <div style="flex:1;min-width:0;">
                <div style="font-size:13.5px;font-weight:700;color:var(--text);margin-bottom:2px;">{{ sub.nome }}</div>
                <div style="font-size:12px;color:var(--text-muted);">{{ sub.alerta }}</div>
            </div>
            <div style="text-align:right;flex-shrink:0;">
                <div style="font-size:15px;font-weight:800;font-family:'JetBrains Mono',monospace;
                    color:{% if sub.risk == 'danger' %}var(--red){% elif sub.risk == 'warning' %}var(--yellow){% else %}var(--green){% endif %};">
                    {{ '%.2f'|format(sub.preco_mensal) }}€/mês
                </div>
                <span class="db-badge db-badge-{% if sub.risk == 'danger' %}danger{% elif sub.risk == 'warning' %}warning{% else %}ok{% endif %}" style="margin-top:5px;">
                    {{ sub.risk_label }}
                </span>
            </div>
        </div>
        {% endfor %}
    </div>
</div>

{% if total_mensal_desperdicado > 0 %}
<div style="background:var(--red-bg);border:1px solid rgba(244,63,94,0.18);border-radius:var(--radius);padding:18px 20px;margin-bottom:24px;">
    <div style="font-size:10px;font-weight:700;letter-spacing:1px;color:var(--red);margin-bottom:8px;text-transform:uppercase;">⚠ Resumo de Impacto</div>
    <div style="font-size:14px;color:var(--text);line-height:1.7;">
        Estás a desperdiçar <strong style="color:var(--red)">{{ '%.2f'|format(total_mensal_desperdicado) }}€/mês</strong>
        em subscrições. São <strong style="color:var(--red)">{{ '%.0f'|format(total_anual_desperdicado) }}€/ano</strong> a ir pelo cano.
    </div>
</div>
{% endif %}

{% else %}
<div class="card">
    <div class="empty-card">
        <span>🛡️</span>
        <p>Carrega o teu extrato bancário acima para detetar subscrições automaticamente.<br>
        Ou adiciona faturas em <a href="{{ url_for('faturas.faturas') }}">Faturas</a> para análise.</p>
    </div>
</div>
{% endif %}

{% block extra_scripts %}
<script>
// ─── Drag & drop events ───────────────────────────────────────────────────────
const dropZone = document.getElementById('dropZone');

dropZone.addEventListener('dragover', e => {
    e.preventDefault();
    dropZone.classList.add('drag-over');
});
dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    const file = e.dataTransfer.files[0];
    if (file) analisarExtrato(file);
});

// ─── Upload & analyze ────────────────────────────────────────────────────────
async function analisarExtrato(file) {
    if (!file) return;

    const status    = document.getElementById('uploadStatus');
    const resultado = document.getElementById('resultadoExtrato');

    // Reset
    status.className = '';
    status.style.display = 'block';
    status.style.background = 'var(--surface2)';
    status.style.border = '1px solid var(--border)';
    status.style.color = 'var(--text-muted)';
    status.innerHTML = `⏳ A analisar <strong>${file.name}</strong>…`;
    resultado.style.display = 'none';

    const formData = new FormData();
    formData.append('extrato', file);

    try {
        const res  = await fetch('/subscriptions/analisar-extrato', { method: 'POST', body: formData });
        const data = await res.json();

        if (!data.success) {
            status.style.background = 'var(--red-bg)';
            status.style.border = '1px solid rgba(244,63,94,0.2)';
            status.style.color = 'var(--red)';
            status.innerHTML = `❌ ${data.error}`;
            return;
        }

        status.style.background = 'var(--green-bg)';
        status.style.border = '1px solid rgba(34,211,160,0.2)';
        status.style.color = 'var(--green)';
        status.innerHTML = `✓ Extrato analisado — ${data.total_movimentos} movimentos lidos`;

        if (!data.subscriptions || !data.subscriptions.length) {
            resultado.style.display = 'block';
            resultado.innerHTML = `
                <div class="card">
                    <div class="card-body" style="text-align:center;padding:40px;color:var(--text-muted);">
                        ✅ Nenhuma subscrição recorrente detetada neste extrato.
                    </div>
                </div>`;
            return;
        }

        const riskColor = { danger: 'var(--red)', warning: 'var(--yellow)', ok: 'var(--green)' };
        const riskBg    = { danger: 'var(--red-bg)', warning: 'var(--yellow-bg)', ok: 'var(--green-bg)' };
        const badgeClass = { danger: 'db-badge-danger', warning: 'db-badge-warning', ok: 'db-badge-ok' };

        const linhas = data.subscriptions.map(s => `
            <div style="display:flex;align-items:center;gap:14px;padding:14px 18px;border-bottom:1px solid var(--border);">
                <div style="width:40px;height:40px;border-radius:10px;background:${riskBg[s.risk]};
                    display:flex;align-items:center;justify-content:center;font-size:19px;flex-shrink:0;">
                    ${s.icone}
                </div>
                <div style="flex:1;min-width:0;">
                    <div style="font-size:13.5px;font-weight:700;color:var(--text);margin-bottom:2px;">${s.nome}</div>
                    <div style="font-size:12px;color:var(--text-muted);">${s.alerta}</div>
                </div>
                <div style="text-align:right;flex-shrink:0;">
                    <div style="font-size:15px;font-weight:800;font-family:'JetBrains Mono',monospace;color:${riskColor[s.risk]};">
                        ${s.preco_mensal.toFixed(2)}€/mês
                    </div>
                    <span class="db-badge ${badgeClass[s.risk]}" style="margin-top:5px;display:inline-block;">
                        ${s.risk_label}
                    </span>
                </div>
            </div>
        `).join('');

        const desperdicado = data.total_mensal_desperdicado.toFixed(2);
        const anual        = data.total_anual_desperdicado.toFixed(0);

        resultado.style.display = 'block';
        resultado.innerHTML = `
            <div class="card" style="margin-bottom:14px;">
                <div class="card-header">
                    <h3>Subscrições no Extrato</h3>
                    <span style="font-size:12px;color:var(--text-muted)">${data.subscriptions.length} detetada(s)</span>
                </div>
                <div class="card-body" style="padding:0;">${linhas}</div>
            </div>
            ${data.total_mensal_desperdicado > 0 ? `
            <div style="background:var(--red-bg);border:1px solid rgba(244,63,94,0.18);border-radius:var(--radius);padding:18px 20px;">
                <div style="font-size:10px;font-weight:700;letter-spacing:1px;color:var(--red);margin-bottom:8px;text-transform:uppercase;">⚠ Resumo de Impacto</div>
                <div style="font-size:14px;color:var(--text);line-height:1.7;">
                    Encontrámos <strong style="color:var(--red)">${desperdicado}€/mês</strong> em subscrições recorrentes —
                    isso são <strong style="color:var(--red)">${anual}€/ano</strong>.
                </div>
            </div>` : ''}
        `;
    } catch (err) {
        status.style.background = 'var(--red-bg)';
        status.style.border = '1px solid rgba(244,63,94,0.2)';
        status.style.color = 'var(--red)';
        status.innerHTML = '❌ Erro de ligação ao analisar o ficheiro.';
    }
}
</script>
{% endblock %}
{% endblock %}
</file>

<file path="verly-mobile/src/screens/FaturasScreen.js">
/**
 * src/screens/FaturasScreen.js
 * Faturas com swipe actions — swipe esquerda: apagar | swipe direita: score + arquivar
 * Pesquisa integrada, upload no header, pull-to-refresh.
 */

import React, { useState, useCallback, useRef } from 'react';
import {
  View, Text, FlatList, TouchableOpacity, StyleSheet,
  TextInput, RefreshControl, ActivityIndicator, Alert,
  Animated, PanResponder, Dimensions, Image,
} from 'react-native';
import { useFocusEffect } from '@react-navigation/native';
import * as ImagePicker   from 'expo-image-picker';
import * as DocumentPicker from 'expo-document-picker';
import {
  Search, Upload, Trash2, Star, Archive,
  ChevronRight, AlertTriangle, Shield,
} from 'lucide-react-native';
import { faturasAPI } from '../services/api';
import { COLORS } from '../constants/theme';

const C = {
  brand:   '#6C5CE7',
  brandDim:'rgba(108,92,231,0.15)',
  bg:      '#0C0C14',
  surface: '#13131F',
  surface2:'#1C1C2E',
  border:  '#252540',
  text:    '#EEEEF8',
  textSub: '#7070A0',
  green:   '#00C896',
  red:     '#FF5370',
  yellow:  '#FFB300',
  orange:  '#FF7043',
};

const SCREEN_W = Dimensions.get('window').width;
const SWIPE_THRESHOLD = 60;
const SWIPE_FULL      = 100;

const CAT_COLORS = {
  'Tecnologia':     '#6C5CE7',
  'Alimentação':    '#00C896',
  'Vestuário':      '#FF7043',
  'Casa & Decoração':'#FFB300',
  'Saúde & Beleza': '#EC4899',
  'Desporto':       '#3B82F6',
  'Entretenimento': '#A855F7',
  'Transportes':    '#14B8A6',
  'Educação':       '#F59E0B',
  'Outros':         '#7070A0',
};

// ── Swipeable card ────────────────────────────────────────────────────────────

// ── Mapa de domínios para lojas portuguesas comuns ───────────────────────────
const MERCHANT_DOMAINS = {
  'worten': 'worten.pt', 'fnac': 'fnac.pt', 'continente': 'continente.pt',
  'pingo doce': 'pingodoce.pt', 'lidl': 'lidl.pt', 'aldi': 'aldi.pt',
  'ikea': 'ikea.com', 'zara': 'zara.com', 'pull&bear': 'pullandbear.com',
  'pull and bear': 'pullandbear.com', 'bershka': 'bershka.com',
  'stradivarius': 'stradivarius.com', 'mango': 'mango.com', 'h&m': 'hm.com',
  'sport zone': 'sportzone.pt', 'decathlon': 'decathlon.pt',
  'amazon': 'amazon.es', 'spotify': 'spotify.com', 'netflix': 'netflix.com',
  'apple': 'apple.com', 'google': 'google.com', 'uber': 'uber.com',
  'glovo': 'glovoapp.com', 'bolt': 'bolt.eu', 'mcdonald': 'mcdonalds.com',
  'kfc': 'kfc.com', 'burger king': 'burgerking.com', 'nandos': 'nandos.com',
  'el corte inglés': 'elcorteingles.pt', 'modelo': 'continente.pt',
  'intermarché': 'intermarche.pt', 'pingo': 'pingodoce.pt',
};

function getMerchantDomain(loja = '') {
  const lower = loja.toLowerCase().trim();
  for (const [key, domain] of Object.entries(MERCHANT_DOMAINS)) {
    if (lower.includes(key)) return domain;
  }
  // fallback: normaliza o nome
  return lower.replace(/[^a-z0-9]/g, '') + '.com';
}

function MerchantLogo({ loja, size = 42 }) {
  const [failed, setFailed] = useState(false);
  const domain = getMerchantDomain(loja);
  const initials = (loja || '?').split(' ').slice(0, 2).map(w => w[0] || '').join('').toUpperCase();

  return (
    <View style={{
      width: size, height: size, borderRadius: size * 0.28,
      backgroundColor: '#1C1C2E',
      borderWidth: 1, borderColor: '#252540',
      justifyContent: 'center', alignItems: 'center',
      marginRight: 12, overflow: 'hidden',
    }}>
      {!failed ? (
        <Image
          source={{ uri: `https://img.logo.dev/${domain}?token=pk_FYu-xwzARFCydRMNlm6imQ` }}
          style={{ width: size - 10, height: size - 10, borderRadius: 4 }}
          resizeMode="contain"
          onError={() => setFailed(true)}
        />
      ) : (
        <Text style={{ fontSize: size * 0.33, fontWeight: '800', color: C.brand }}>
          {initials}
        </Text>
      )}
    </View>
  );
}

function SwipeableFaturaCard({ fatura, onPress, onDelete, onScore }) {
  const translateX = useRef(new Animated.Value(0)).current;
  const isSwipingRef = useRef(false);

  const panResponder = useRef(
    PanResponder.create({
      onMoveShouldSetPanResponder: (_, g) =>
        Math.abs(g.dx) > 10 && Math.abs(g.dy) < 20,
      onPanResponderGrant: () => { isSwipingRef.current = true; },
      onPanResponderMove: (_, g) => {
        // Limita o range de swipe
        const x = Math.max(-SWIPE_FULL, Math.min(SWIPE_FULL, g.dx));
        translateX.setValue(x);
      },
      onPanResponderRelease: (_, g) => {
        isSwipingRef.current = false;
        if (g.dx < -SWIPE_THRESHOLD) {
          // Swipe esquerda — mostrar delete
          Animated.spring(translateX, { toValue: -SWIPE_FULL, useNativeDriver: true }).start();
        } else if (g.dx > SWIPE_THRESHOLD) {
          // Swipe direita — mostrar score
          Animated.spring(translateX, { toValue: SWIPE_FULL, useNativeDriver: true }).start();
        } else {
          // Volta ao centro
          Animated.spring(translateX, { toValue: 0, useNativeDriver: true }).start();
        }
      },
    })
  ).current;

  const resetSwipe = () => {
    Animated.spring(translateX, { toValue: 0, useNativeDriver: true }).start();
  };

  const accentColor = CAT_COLORS[fatura.categoria] || C.brand;
  const hasAlertas  = fatura.data_garantia || fatura.data_devolucao;

  return (
    <View style={styles.swipeContainer}>
      {/* Fundo esquerda — DELETE */}
      <View style={styles.bgLeft}>
        <TouchableOpacity
          style={styles.bgActionDelete}
          onPress={() => { resetSwipe(); onDelete(fatura.id); }}
        >
          <Trash2 size={22} color="#fff" strokeWidth={2} />
          <Text style={styles.bgActionText}>Apagar</Text>
        </TouchableOpacity>
      </View>

      {/* Fundo direita — SCORE */}
      <View style={styles.bgRight}>
        <TouchableOpacity
          style={styles.bgActionScore}
          onPress={() => { resetSwipe(); onScore(fatura); }}
        >
          <Star size={22} color="#fff" strokeWidth={2} />
          <Text style={styles.bgActionText}>Score</Text>
        </TouchableOpacity>
      </View>

      {/* Card deslizável */}
      <Animated.View
        style={[styles.card, { transform: [{ translateX }] }]}
        {...panResponder.panHandlers}
      >
        <TouchableOpacity
          style={styles.cardInner}
          onPress={() => { if (!isSwipingRef.current) { resetSwipe(); onPress(); } }}
          activeOpacity={0.8}
        >
          {/* Logo da marca */}
          <MerchantLogo loja={fatura.loja} />

          {/* Conteúdo */}
          <View style={styles.cardBody}>
            <View style={styles.cardTop}>
              <Text style={styles.cardLoja} numberOfLines={1}>{fatura.loja || 'Sem nome'}</Text>
              <Text style={[styles.cardTotal, (fatura.total || 0) > 150 && { color: C.red }]}>
                {(fatura.total || 0).toFixed(2)}€
              </Text>
            </View>

            <View style={styles.cardMeta}>
              <View style={[styles.catBadge, { backgroundColor: accentColor + '20', borderColor: accentColor + '40' }]}>
                <Text style={[styles.catBadgeText, { color: accentColor }]}>
                  {fatura.categoria || 'Outros'}
                </Text>
              </View>
              <Text style={styles.cardDate}>{fatura.data_compra || fatura.data_upload?.slice(0, 10) || '—'}</Text>
            </View>

            {hasAlertas && (
              <View style={styles.alertasRow}>
                {fatura.data_devolucao && (
                  <View style={styles.alertaTag}>
                    <AlertTriangle size={10} color={C.yellow} />
                    <Text style={[styles.alertaTagText, { color: C.yellow }]}>Dev: {fatura.data_devolucao}</Text>
                  </View>
                )}
                {fatura.data_garantia && (
                  <View style={styles.alertaTag}>
                    <Shield size={10} color={C.green} />
                    <Text style={[styles.alertaTagText, { color: C.green }]}>Gar: {fatura.data_garantia}</Text>
                  </View>
                )}
              </View>
            )}
          </View>

          <ChevronRight size={14} color={C.textSub} />
        </TouchableOpacity>
      </Animated.View>
    </View>
  );
}

// ── Ecrã principal ────────────────────────────────────────────────────────────

export default function FaturasScreen({ navigation }) {
  const [faturas,   setFaturas]   = useState([]);
  const [loading,   setLoading]   = useState(true);
  const [refreshing,setRefreshing]= useState(false);
  const [search,    setSearch]    = useState('');
  const [total,     setTotal]     = useState(0);
  const [uploading, setUploading] = useState(false);

  const fetchFaturas = async (q = '') => {
    try {
      const data = await faturasAPI.listar(q ? { q } : {});
      setFaturas(data.faturas || []);
      setTotal(data.total_gasto || data.total || 0);
    } catch (e) {
      Alert.alert('Erro', e.message);
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  };

  useFocusEffect(useCallback(() => { setLoading(true); fetchFaturas(); }, []));

  const handleSearch = (text) => {
    setSearch(text);
    fetchFaturas(text);
  };

  const handleDelete = (id) => {
    Alert.alert(
      'Eliminar fatura',
      'Esta ação é irreversível. Tens a certeza?',
      [
        { text: 'Cancelar', style: 'cancel' },
        {
          text: 'Eliminar', style: 'destructive',
          onPress: async () => {
            try {
              await faturasAPI.apagar(id);
              setFaturas(prev => prev.filter(f => f.id !== id));
            } catch (e) { Alert.alert('Erro', e.message); }
          },
        },
      ]
    );
  };

  const handleScore = (fatura) => {
    navigation.navigate('Score', { faturaId: fatura.id, prefill: { item: fatura.loja, categoria: fatura.categoria, preco: fatura.total } });
  };

  // ── Upload ──────────────────────────────────────────────────────────────────

  const _uploadFile = async (uri, name, type) => {
    setUploading(true);
    try {
      await faturasAPI.upload(uri, name, type);
      Alert.alert('Fatura enviada!', 'Pode demorar alguns segundos a processar.');
      fetchFaturas(search);
    } catch (e) {
      Alert.alert('Erro no upload', e.message);
    } finally {
      setUploading(false);
    }
  };

  const handleUpload = () => {
    Alert.alert('Carregar fatura', 'Escolhe a origem:', [
      { text: 'Cancelar', style: 'cancel' },
      {
        text: 'Câmara',
        onPress: async () => {
          const { status } = await ImagePicker.requestCameraPermissionsAsync();
          if (status !== 'granted') { Alert.alert('Permissão negada'); return; }
          const r = await ImagePicker.launchCameraAsync({ quality: 0.85 });
          if (!r.canceled) {
            const a = r.assets[0];
            await _uploadFile(a.uri, a.fileName || 'fatura.jpg', 'image/jpeg');
          }
        },
      },
      {
        text: 'Galeria',
        onPress: async () => {
          const r = await ImagePicker.launchImageLibraryAsync({ quality: 0.85 });
          if (!r.canceled) {
            const a = r.assets[0];
            await _uploadFile(a.uri, a.fileName || 'fatura.jpg', 'image/jpeg');
          }
        },
      },
      {
        text: 'PDF',
        onPress: async () => {
          const r = await DocumentPicker.getDocumentAsync({ type: 'application/pdf' });
          if (!r.canceled) {
            const f = r.assets[0];
            await _uploadFile(f.uri, f.name, 'application/pdf');
          }
        },
      },
    ]);
  };

  if (loading) {
    return <View style={styles.center}><ActivityIndicator size="large" color={C.brand} /></View>;
  }

  return (
    <View style={styles.root}>
      {/* ── Header ── */}
      <View style={styles.header}>
        <View>
          <Text style={styles.title}>Faturas</Text>
          <Text style={styles.sub}>{faturas.length} faturas · {(total || 0).toFixed(2)}€</Text>
        </View>
        <TouchableOpacity
          style={[styles.uploadBtn, uploading && { opacity: 0.6 }]}
          onPress={handleUpload}
          disabled={uploading}
        >
          {uploading
            ? <ActivityIndicator color="#fff" size="small" />
            : <>
                <Upload size={14} color="#fff" strokeWidth={2.5} />
                <Text style={styles.uploadBtnText}>Upload</Text>
              </>
          }
        </TouchableOpacity>
      </View>

      {/* ── Pesquisa ── */}
      <View style={styles.searchWrap}>
        <Search size={16} color={C.textSub} />
        <TextInput
          style={styles.searchInput}
          value={search}
          onChangeText={handleSearch}
          placeholder="Pesquisar loja, categoria..."
          placeholderTextColor={C.textSub}
        />
        {search.length > 0 && (
          <TouchableOpacity onPress={() => handleSearch('')}>
            <Text style={{ color: C.textSub, fontSize: 16 }}>✕</Text>
          </TouchableOpacity>
        )}
      </View>

      {/* ── Dica de swipe (primeira vez) ── */}
      <View style={styles.swipeHint}>
        <Text style={styles.swipeHintText}>← Swipe para apagar  ·  Swipe para score →</Text>
      </View>

      {/* ── Lista ── */}
      <FlatList
        data={faturas}
        keyExtractor={item => String(item.id)}
        contentContainerStyle={styles.list}
        refreshControl={
          <RefreshControl
            refreshing={refreshing}
            onRefresh={() => { setRefreshing(true); fetchFaturas(search); }}
            tintColor={C.brand}
          />
        }
        renderItem={({ item }) => (
          <SwipeableFaturaCard
            fatura={item}
            onPress={() => navigation.navigate('FaturaDetalhe', { id: item.id })}
            onDelete={handleDelete}
            onScore={handleScore}
          />
        )}
        ListEmptyComponent={
          <View style={styles.empty}>
            <Text style={styles.emptyTitle}>
              {search ? `Sem resultados para "${search}"` : 'Nenhuma fatura ainda'}
            </Text>
            {!search && (
              <>
                <Text style={styles.emptySub}>Carrega a tua primeira fatura para começar a controlar as tuas finanças.</Text>
                <TouchableOpacity style={styles.emptyBtn} onPress={handleUpload}>
                  <Upload size={16} color="#fff" />
                  <Text style={styles.emptyBtnText}>Carregar fatura</Text>
                </TouchableOpacity>
              </>
            )}
          </View>
        }
      />
    </View>
  );
}

const styles = StyleSheet.create({
  root:   { flex: 1, backgroundColor: C.bg },
  center: { flex: 1, justifyContent: 'center', alignItems: 'center', backgroundColor: C.bg },

  header: {
    flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start',
    paddingHorizontal: 20, paddingTop: 16, paddingBottom: 12,
  },
  title: { fontSize: 28, fontWeight: '800', color: C.text, letterSpacing: -0.5 },
  sub:   { fontSize: 13, color: C.textSub, marginTop: 4 },
  uploadBtn: {
    flexDirection: 'row', alignItems: 'center', gap: 6,
    backgroundColor: C.brand, borderRadius: 12,
    paddingHorizontal: 14, paddingVertical: 9, marginTop: 4,
  },
  uploadBtnText: { color: '#fff', fontWeight: '700', fontSize: 13 },

  searchWrap: {
    flexDirection: 'row', alignItems: 'center', gap: 10,
    backgroundColor: C.surface, borderRadius: 14,
    marginHorizontal: 20, marginBottom: 8, paddingHorizontal: 14,
    borderWidth: 1, borderColor: C.border,
  },
  searchInput: { flex: 1, color: C.text, fontSize: 14, paddingVertical: 12 },

  swipeHint: { paddingHorizontal: 20, marginBottom: 8 },
  swipeHintText: { fontSize: 11, color: C.textSub, textAlign: 'center', fontStyle: 'italic' },

  list: { paddingHorizontal: 16, paddingBottom: 32 },

  // Swipe
  swipeContainer: { marginBottom: 10, position: 'relative', overflow: 'hidden', borderRadius: 16 },

  bgLeft: {
    position: 'absolute', right: 0, top: 0, bottom: 0,
    width: SWIPE_FULL, justifyContent: 'center', alignItems: 'center',
    backgroundColor: C.red, borderRadius: 16,
  },
  bgRight: {
    position: 'absolute', left: 0, top: 0, bottom: 0,
    width: SWIPE_FULL, justifyContent: 'center', alignItems: 'center',
    backgroundColor: C.brand, borderRadius: 16,
  },
  bgActionDelete: { alignItems: 'center', gap: 4 },
  bgActionScore:  { alignItems: 'center', gap: 4 },
  bgActionText:   { color: '#fff', fontSize: 10, fontWeight: '700', letterSpacing: 0.5 },

  card: {
    backgroundColor: C.surface,
    borderRadius: 16,
    borderWidth: 1,
    borderColor: C.border,
    overflow: 'hidden',
  },
  cardInner: {
    flexDirection: 'row', alignItems: 'center',
    paddingVertical: 14, paddingRight: 14,
  },
  accentLine: { width: 3, alignSelf: 'stretch', marginRight: 14, borderRadius: 2 },
  cardBody:   { flex: 1 },
  cardTop:    { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 8 },
  cardLoja:   { fontSize: 15, fontWeight: '700', color: C.text, flex: 1, marginRight: 8 },
  cardTotal:  { fontSize: 16, fontWeight: '900', color: C.text },
  cardMeta:   { flexDirection: 'row', alignItems: 'center', gap: 8 },
  catBadge:   { borderRadius: 6, paddingHorizontal: 8, paddingVertical: 3, borderWidth: 1 },
  catBadgeText:{ fontSize: 11, fontWeight: '700' },
  cardDate:   { fontSize: 12, color: C.textSub },
  alertasRow: { flexDirection: 'row', gap: 8, marginTop: 8 },
  alertaTag:  { flexDirection: 'row', alignItems: 'center', gap: 4 },
