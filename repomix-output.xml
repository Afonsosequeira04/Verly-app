    "alta":  {"cor": "#E24B4A", "fundo": "#FCEBEB", "label": "URGENTE"},
    "media": {"cor": "#BA7517", "fundo": "#FAEEDA", "label": "ATENÇÃO"},
    "info":  {"cor": "#185FA5", "fundo": "#E6F1FB", "label": "INFO"},
}

