    text-transform: uppercase;
    color: var(--text-sub);
    border-bottom: 1px solid var(--border);
}
.data-table td { padding: 13px 14px; border-bottom: 1px solid var(--border); color: var(--text); }
.data-table tr:last-child td { border-bottom: none; }
.data-table tr:hover td { background: var(--surface2); }
.text-muted { color: var(--text-muted) !important; }
.text-danger { color: var(--red) !important; }
.text-warning { color: var(--yellow) !important; }

.file-badge {
    font-size: 11px;
    background: var(--surface2);
    border: 1px solid var(--border);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    font-family: monospace;
    color: var(--text-muted);
}

.items-preview {
    font-size: 12px;
    color: var(--text-muted);
    cursor: help;
    border-bottom: 1px dashed var(--border);
}

/* ─── CATEGORY BADGE ─── */
.cat-badge {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 20px;
    background: var(--brand-light);
    color: var(--brand-2);
    border: 1px solid rgba(74,58,255,0.2);
    white-space: nowrap;
}

/* ─── FILTERS ─── */
.filtros-form { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.filtro-input {
    flex: 1;
    min-width: 200px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    padding: 9px 14px;
    outline: none;
    transition: border-color 0.2s;
}
.filtro-input:focus { border-color: var(--brand); }
.filtro-select {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    padding: 9px 14px;
    outline: none;
    cursor: pointer;
    transition: border-color 0.2s;
}
.filtro-select:focus { border-color: var(--brand); }

/* ─── INLINE EDIT ─── */
.editable {
    cursor: pointer;
    border-bottom: 1px dashed var(--border);
    transition: all 0.15s;
    padding-bottom: 1px;
}
.editable:hover { border-color: var(--brand); color: var(--brand-2); }
.inline-edit {
    background: var(--surface2);
    border: 1px solid var(--brand);
    border-radius: var(--radius-xs);
    color: var(--text);
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    padding: 4px 8px;
    outline: none;
    width: 120px;
}
.cat-select {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    color: var(--text);
    font-size: 12px;
    padding: 4px 8px;
    cursor: pointer;
    outline: none;
}

/* ─── CONVERSATIONS ─── */
.convo-list { list-style: none; }
.convo-item { padding: 13px 0; border-bottom: 1px solid var(--border); }
.convo-item:last-child { border-bottom: none; }
.convo-q { font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 4px; }
.convo-a { font-size: 12px; color: var(--text-muted); line-height: 1.5; margin-bottom: 4px; }
.convo-time { font-size: 11px; color: var(--text-sub); }

/* ─── EMPTY ─── */
.empty-card { text-align: center; padding: 48px 20px; color: var(--text-muted); }
.empty-card span { font-size: 36px; display: block; margin-bottom: 12px; opacity: 0.3; }
.empty-card p { font-size: 13px; line-height: 1.6; }

/* ─── UPLOAD ─── */
.upload-zone {
    border: 1.5px dashed var(--border);
    border-radius: var(--radius);
    padding: 36px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
    background: var(--surface2);
}
.upload-zone:hover, .upload-zone.drag-over {
    border-color: var(--brand);
    background: var(--brand-light);
}
.upload-zone input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
.upload-icon { font-size: 32px; margin-bottom: 10px; }
.upload-zone strong { display: block; font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 5px; }
.upload-zone p { font-size: 12px; color: var(--text-muted); }
.upload-status { margin-top: 12px; font-size: 13px; min-height: 20px; font-weight: 500; }
.upload-status.success { color: var(--green); }
.upload-status.error { color: var(--red); }
.upload-status.loading { color: var(--brand-2); }

/* ─── CHAT ─── */
.chat-page { display: flex; flex-direction: column; height: calc(100vh - 64px); margin: -32px -36px; }

.chat-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 28px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    flex-shrink: 0;
}
.chat-topbar-left { display: flex; align-items: center; gap: 12px; }
.chat-topbar h1 { font-family: 'Sora', sans-serif; font-size: 16px; font-weight: 700; }
.status-dot { width: 8px; height: 8px; background: var(--green); border-radius: 50%; box-shadow: 0 0 8px var(--green); }

.messages-area {
    flex: 1;
    overflow-y: auto;
    padding: 28px 36px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}
.messages-area::-webkit-scrollbar { width: 4px; }
.messages-area::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

.empty-chat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--text-muted);
    text-align: center;
    padding: 60px 20px;
}
.empty-chat-icon { font-size: 44px; opacity: 0.3; }
.empty-chat h3 { font-family: 'Sora', sans-serif; font-size: 18px; font-weight: 700; color: var(--text); opacity: 0.4; }
.empty-chat p { font-size: 13px; max-width: 300px; line-height: 1.7; }

.msg { display: flex; gap: 12px; max-width: 76%; animation: fadeUp 0.2s ease; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
.msg.user { align-self: flex-end; flex-direction: row-reverse; }
.msg-avatar {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    flex-shrink: 0;
    font-family: 'Sora', sans-serif;
}
.msg.bot .msg-avatar { background: linear-gradient(135deg, var(--brand), var(--brand-2)); color: white; font-size: 16px; }
.msg.user .msg-avatar { background: var(--surface2); border: 1px solid var(--border); color: var(--text); }
.msg-bubble { padding: 12px 16px; border-radius: 12px; font-size: 14px; line-height: 1.6; }
.msg.bot .msg-bubble { background: var(--surface); border: 1px solid var(--border); border-top-left-radius: 2px; }
.msg.user .msg-bubble { background: linear-gradient(135deg, var(--brand), var(--brand-2)); color: white; border-top-right-radius: 2px; box-shadow: var(--shadow-brand); }

.typing-indicator {
    display: flex;
    gap: 4px;
    padding: 14px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    border-top-left-radius: 2px;
    align-items: center;
}
.typing-indicator span { width: 6px; height: 6px; background: var(--text-sub); border-radius: 50%; animation: bounce 1.2s infinite; }
.typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
.typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
@keyframes bounce { 0%, 60%, 100% { transform: none; } 30% { transform: translateY(-5px); } }

.chat-input-area {
    padding: 16px 36px;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 10px;
    align-items: flex-end;
    background: var(--surface);
    flex-shrink: 0;
}
.chat-input-area textarea {
    flex: 1;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    padding: 12px 16px;
    resize: none;
    outline: none;
    transition: border-color 0.2s;
    line-height: 1.5;
    max-height: 120px;
}
.chat-input-area textarea:focus { border-color: var(--brand); }
.chat-input-area textarea::placeholder { color: var(--text-sub); }

.btn-send {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    border: none;
    border-radius: var(--radius-sm);
    color: white;
    font-size: 18px;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: var(--shadow-brand);
}
.btn-send:hover { opacity: 0.9; transform: scale(1.05); }
.btn-send:disabled { background: var(--surface2); color: var(--text-sub); cursor: not-allowed; transform: none; box-shadow: none; }

/* ─── PERFIL ─── */
.perfil-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.perfil-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.perfil-stat {
    text-align: center;
    padding: 20px 16px;
    background: var(--surface2);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    transition: all 0.2s;
}
.perfil-stat:hover { border-color: var(--border-hover); }
.ps-icon { display: block; font-size: 22px; margin-bottom: 10px; }
.ps-val { display: block; font-family: 'Sora', sans-serif; font-size: 22px; font-weight: 700; color: var(--brand-2); }
.ps-label { display: block; font-size: 11px; color: var(--text-sub); letter-spacing: 0.5px; margin-top: 3px; }

/* ─── FORM GROUPS ─── */
.form-group { margin-bottom: 18px; }
.form-group label { display: block; font-size: 11px; font-weight: 600; letter-spacing: 0.8px; text-transform: uppercase; color: var(--text-muted); margin-bottom: 7px; }
.form-group input {
    width: 100%;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    padding: 11px 16px;
    outline: none;
    transition: border-color 0.2s;
}
.form-group input:focus { border-color: var(--brand); }
.form-group input::placeholder { color: var(--text-sub); }

.form-check { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; font-size: 13px; color: var(--text-muted); }
.form-check input { width: auto; accent-color: var(--brand); }

/* ─── AUTH ─── */
.auth-body { background: var(--bg); }
.auth-container { display: flex; min-height: 100vh; }

.auth-left {
    width: 420px;
    background: var(--surface);
    border-right: 1px solid var(--border);
    padding: 60px 48px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
}

.auth-left::before {
    content: '';
    position: absolute;
    top: -100px;
    left: -100px;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(74,58,255,0.15), transparent 70%);
    pointer-events: none;
}

.auth-left::after {
    content: '';
    position: absolute;
    bottom: -80px;
    right: -80px;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(123,97,255,0.1), transparent 70%);
    pointer-events: none;
}

.auth-logo-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 48px;
    position: relative;
    z-index: 1;
}

.auth-logo-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 4px 16px rgba(74,58,255,0.5));
}

.auth-brand-name {
    font-family: 'Sora', sans-serif;
    font-size: 26px;
    font-weight: 700;
    background: linear-gradient(135deg, #7B61FF, #4A9FFF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.5px;
}

.auth-hero { position: relative; z-index: 1; }

.auth-hero h1 {
    font-family: 'Sora', sans-serif;
    font-size: 38px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -1px;
    color: var(--text);
    margin-bottom: 16px;
}

.auth-hero h1 span { color: var(--brand-2); }

.auth-hero p {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 280px;
}

.auth-features {
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    z-index: 1;
}

.auth-feature {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text-muted);
}

.auth-feature-dot {
    width: 6px;
    height: 6px;
    background: var(--brand-2);
    border-radius: 50%;
    flex-shrink: 0;
}

.auth-right { flex: 1; display: flex; align-items: center; justify-content: center; padding: 40px; }

.auth-card { width: 100%; max-width: 400px; }

.auth-card-title {
    font-family: 'Sora', sans-serif;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.5px;
    margin-bottom: 6px;
}

.auth-sub { font-size: 14px; color: var(--text-muted); margin-bottom: 32px; }

.auth-switch { margin-top: 22px; font-size: 13px; color: var(--text-muted); text-align: center; }

/* ─── DIVIDER ─── */
.divider { border: none; border-top: 1px solid var(--border); margin: 24px 0; }
