}
.perfil-hero-info p { font-size: 13px; color: var(--text-muted); }
.hero-meta { font-size: 11px; color: var(--text-sub); margin-top: 6px; display: flex; align-items: center; gap: 5px; }

.perfil-stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 24px;
}
.perfil-stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
