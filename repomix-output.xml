<file path="templates/faturas.html">
{% extends 'base.html' %}
{% block title %}Faturas · Verly{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1 class="page-title">Faturas</h1>
        <p class="page-sub">{{ faturas|length }} fatura(s) · Total filtrado: {{ "%.2f"|format(total_filtrado) }} €</p>
    </div>
    <a href="{{ url_for('exportar.exportar_pdf') }}" class="btn-ghost">⬇ Exportar PDF</a>
</div>

<!-- UPLOAD -->
<div class="card" style="margin-bottom:24px;">
    <div class="card-header"><h3>Submeter Nova Fatura</h3></div>
    <div class="card-body">
        <div class="upload-zone" id="uploadZone">
            <input type="file" id="fileInput" accept=".pdf,.png,.jpg,.jpeg,.txt" onchange="handleFileSelect(this)">
            <div class="upload-icon">📁</div>
            <strong id="uploadLabel">Arrastar ou clicar para selecionar</strong>
            <p id="uploadSub">PDF, PNG, JPG, TXT aceites</p>
        </div>
        <button class="btn-accent" id="btnUpload" style="display:none;margin-top:14px;" onclick="uploadFile()">
            Analisar com IA →
        </button>
        <div class="upload-status" id="uploadStatus"></div>
    </div>
</div>

<!-- FILTROS -->
<div class="card" style="margin-bottom:24px;">
    <div class="card-body" style="padding:16px 20px;">
        <form method="GET" action="{{ url_for('faturas.faturas') }}" class="filtros-form">
            <input type="text" name="q" value="{{ search }}" placeholder="🔍 Pesquisar loja, item..." class="filtro-input">
            <select name="categoria" class="filtro-select">
                <option value="">Todas as categorias</option>
                {% for cat in categorias %}
                <option value="{{ cat }}" {% if cat == categoria_sel %}selected{% endif %}>{{ cat }}</option>
                {% endfor %}
            </select>
            <select name="ordenar" class="filtro-select">
                <option value="recente" {% if ordenar == 'recente' %}selected{% endif %}>Mais recente</option>
                <option value="antigo" {% if ordenar == 'antigo' %}selected{% endif %}>Mais antigo</option>
                <option value="maior" {% if ordenar == 'maior' %}selected{% endif %}>Maior valor</option>
                <option value="menor" {% if ordenar == 'menor' %}selected{% endif %}>Menor valor</option>
            </select>
            <button type="submit" class="btn-accent">Filtrar</button>
            {% if search or categoria_sel %}
            <a href="{{ url_for('faturas.faturas') }}" class="btn-ghost">Limpar</a>
            {% endif %}
        </form>
    </div>
</div>

<!-- TABELA -->
<div class="card">
    <div class="card-header"><h3>Faturas Registadas</h3></div>
    <div class="card-body" style="padding:0;">
        {% if faturas %}
        <table class="data-table">
            <thead>
                <tr>
                    <th>Ficheiro</th>
                    <th>Loja</th>
                    <th>Categoria</th>
                    <th>Data Compra</th>
                    <th>Total</th>
                    <th>Devolução</th>
                    <th>Garantia</th>
                    <th>Items</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for f in faturas %}
                <tr id="row-{{ f.id }}">
                    <td><span class="file-badge">{{ f.nome_ficheiro }}</span></td>
                    <td>
                        <span class="editable" onclick="editarCampo({{ f.id }}, 'loja', this)">{{ f.loja or '—' }}</span>
                    </td>
                    <td>
                        <select class="cat-select" onchange="editarCategoria({{ f.id }}, this.value)">
                            {% for cat in categorias %}
                            <option value="{{ cat }}" {% if cat == f.categoria %}selected{% endif %}>{{ cat }}</option>
                            {% endfor %}
                        </select>
                    </td>
                    <td class="text-muted">{{ f.data_compra or '—' }}</td>
                    <td class="{% if f.total and f.total > 100 %}text-danger{% endif %}">
                        <span class="editable" onclick="editarCampo({{ f.id }}, 'total', this)">
                            {% if f.total %}{{ "%.2f"|format(f.total) }} €{% else %}—{% endif %}
                        </span>
                    </td>
                    <td class="{% if f.data_devolucao %}text-warning{% endif %}">{{ f.data_devolucao or '—' }}</td>
                    <td class="text-muted">{{ f.data_garantia or '—' }}</td>
                    <td>
                        {% if f.items_list %}
                        <span class="items-preview" title="{{ f.items_list|join(', ') }}">{{ f.items_list|length }} item(s)</span>
                        {% else %}—{% endif %}
                    </td>
                    <td><button class="btn-delete" onclick="deleteFatura({{ f.id }})">✕</button></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <div class="empty-card">
            <span>🧾</span>
            <p>Nenhuma fatura encontrada.<br>
            {% if search or categoria_sel %}Tenta outros filtros.{% else %}Submete uma fatura acima para começar.{% endif %}</p>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
let selectedFile = null;

function handleFileSelect(input) {
    selectedFile = input.files[0];
    if (selectedFile) {
        document.getElementById('uploadLabel').textContent = selectedFile.name;
        document.getElementById('uploadSub').textContent = (selectedFile.size / 1024).toFixed(1) + ' KB';
        document.getElementById('btnUpload').style.display = 'block';
    }
}

const zone = document.getElementById('uploadZone');
zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-over'); });
zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
zone.addEventListener('drop', e => {
    e.preventDefault(); zone.classList.remove('drag-over');
    const file = e.dataTransfer.files[0];
    if (file) {
        selectedFile = file;
        document.getElementById('uploadLabel').textContent = file.name;
        document.getElementById('uploadSub').textContent = (file.size / 1024).toFixed(1) + ' KB';
        document.getElementById('btnUpload').style.display = 'block';
    }
});

async function uploadFile() {
    if (!selectedFile) return;
    const btn = document.getElementById('btnUpload');
    btn.disabled = true; btn.textContent = 'A analisar...';
    setStatus('loading', '⏳ A analisar a fatura com IA...');
    const formData = new FormData();
    formData.append('file', selectedFile);
    try {
        const res = await fetch('/faturas/upload', { method: 'POST', body: formData });
        const data = await res.json();
        if (data.success) {
            setStatus('success', `✓ ${data.message} — ${data.loja} · ${data.categoria}`);
            setTimeout(() => location.reload(), 1500);
        } else {
            setStatus('error', '✗ ' + data.message);
        }
    } catch(e) { setStatus('error', '✗ Erro de ligação.'); }
    btn.disabled = false; btn.textContent = 'Analisar com IA →';
}

function setStatus(type, msg) {
    const el = document.getElementById('uploadStatus');
    el.className = 'upload-status ' + type;
    el.textContent = msg;
}

async function editarCategoria(id, valor) {
    await fetch(`/faturas/editar/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ categoria: valor })
    });
}

function editarCampo(id, campo, el) {
    const valor = el.textContent.replace(' €', '').trim();
    const input = document.createElement('input');
    input.type = 'text'; input.value = valor === '—' ? '' : valor;
    input.className = 'inline-edit';
    el.replaceWith(input);
    input.focus();
    input.addEventListener('blur', async () => {
        const novo = input.value.trim();
        const body = {};
        body[campo] = novo;
        await fetch(`/faturas/editar/${id}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        location.reload();
    });
    input.addEventListener('keydown', e => { if (e.key === 'Enter') input.blur(); });
}

async function deleteFatura(id) {
    if (!confirm('Remover esta fatura?')) return;
    const res = await fetch(`/faturas/delete/${id}`, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) document.getElementById('row-' + id).remove();
}
</script>
{% endblock %}
</file>

<file path="app/ai.py">
import os
import re
import json
from datetime import datetime, timedelta
from llama_index.core import (
    VectorStoreIndex, SimpleDirectoryReader,
    StorageContext, load_index_from_storage, Settings
)
from llama_index.llms.groq import Groq
from llama_index.embeddings.huggingface import HuggingFaceEmbedding
from dotenv import load_dotenv

load_dotenv()

api_key = os.getenv("GROQ_API_KEY")
Settings.llm = Groq(model="llama-3.3-70b-versatile", api_key=api_key)
Settings.embed_model = HuggingFaceEmbedding(model_name="sentence-transformers/all-MiniLM-L6-v2")


# ─── SYSTEM PROMPTS ──────────────────────────────────────────────────────────

SYSTEM_PROMPTS = {
    'savage': """És a Verly. Assistente financeira brutal e sem filtros.
REGRAS:
- Respostas CURTAS. Máximo 3-4 frases. Nunca mais.
- Tom direto e cortante. Sem "Olá", sem "Estou aqui para ajudar".
- Usa os dados reais das faturas. Nunca inventes valores.
- Quando o utilizador gasta mal, diz-lhe com exemplos concretos.
- Português de Portugal.""",

    'sarcastic': """És a Verly. Assistente financeira sarcástica e irónica.
REGRAS:
- Respostas CURTAS. Máximo 3-4 frases. Nunca mais.
- Tom irónico e espirituoso. Sem "Olá", sem introduções longas.
- Usa os dados reais das faturas. Nunca inventes valores.
- Sarcasmo inteligente que faça pensar.
- Português de Portugal.""",

    'calm': """És a Verly. Coach financeira empática e direta.
REGRAS:
- Respostas CURTAS e úteis. Máximo 3-4 frases. Nunca mais.
- Vai direto ao ponto. Sem "Olá", sem parágrafos longos.
- Usa os dados reais das faturas. Nunca inventes valores.
- Sê concreto: números, categorias, datas reais.
- Português de Portugal.""",

    'pro': """És a Verly. CFO pessoal analítico e preciso.
REGRAS:
- Respostas CURTAS e factuais. Máximo 3-4 frases. Nunca mais.
- Vai direto aos números. Sem introduções.
- Usa os dados reais das faturas. Nunca inventes valores.
- Foca em: totais, categorias, padrões de gasto.
- Português de Portugal.""",
}

DEFAULT_SYSTEM_PROMPT = SYSTEM_PROMPTS['calm']

CATEGORIAS_VALIDAS = [
    'Tecnologia', 'Alimentação', 'Vestuário', 'Casa & Decoração',
    'Saúde & Beleza', 'Desporto', 'Entretenimento', 'Transportes',
    'Educação', 'Outros'
]

CATEGORIA_MAP = {
    'tecnologia': 'Tecnologia',
    'alimentacao': 'Alimentação', 'alimentação': 'Alimentação',
    'vestuario': 'Vestuário', 'vestuário': 'Vestuário',
    'casa e decoracao': 'Casa & Decoração', 'casa & decoracao': 'Casa & Decoração',
    'casa & decoração': 'Casa & Decoração',
    'saude e beleza': 'Saúde & Beleza', 'saúde e beleza': 'Saúde & Beleza',
    'saude & beleza': 'Saúde & Beleza',
    'desporto': 'Desporto',
    'entretenimento': 'Entretenimento',
    'transportes': 'Transportes',
    'educacao': 'Educação', 'educação': 'Educação',
    'outros': 'Outros',
}


# ─── EXTRAÇÃO DIRETA DO TEXTO ─────────────────────────────────────────────────

def _extrair_campo(texto, *labels):
    for label in labels:
        pattern = rf'{re.escape(label)}\s*[:\-]\s*(.+)'
        match = re.search(pattern, texto, re.IGNORECASE)
        if match:
            return match.group(1).strip()
    return None


def _extrair_total(texto):
    patterns = [
        r'TOTAL\s+A\s+PAGAR\s*[:\-]\s*([\d]+[.,][\d]{2})',
        r'TOTAL\s*[:\-]\s*([\d]+[.,][\d]{2})\s*EUR',
        r'TOTAL\s*[:\-]\s*€?\s*([\d]+[.,][\d]{2})',
    ]
    for pattern in patterns:
        match = re.search(pattern, texto, re.IGNORECASE)
        if match:
            try:
                return float(match.group(1).replace(',', '.'))
            except ValueError:
                continue
    return None


def _normalizar_data(data_str):
    if not data_str:
        return None
    data_str = data_str.strip()
    for fmt in ['%d/%m/%Y', '%Y-%m-%d', '%d-%m-%Y', '%d/%m/%y', '%Y/%m/%d']:
        try:
            return datetime.strptime(data_str, fmt).strftime('%d/%m/%Y')
        except ValueError:
            continue
    return None


def _calcular_datas(data_compra_str):
    data_norm = _normalizar_data(data_compra_str)
    if not data_norm:
        return None, None
    try:
        data = datetime.strptime(data_norm, '%d/%m/%Y')
        return (
            (data + timedelta(days=30)).strftime('%d/%m/%Y'),
            data.replace(year=data.year + 3).strftime('%d/%m/%Y'),
        )
    except Exception:
        return None, None


def _extrair_items(texto):
    """
    Extrai o produto/serviço — o texto está na linha SEGUINTE ao label.
    Ex:
        PRODUTO / SERVICO ADQUIRIDO:
        Pack 3 T-Shirts mais Sweatshirt
    """
    patterns = [
        r'PRODUTO\s*/\s*SERVICO\s+ADQUIRIDO\s*[:\-]?\s*\n\s*(.+)',
        r'PRODUTO\s*[:\-]\s*\n\s*(.+)',
        r'DESCRI[CÇ][AÃ]O\s*[:\-]\s*\n\s*(.+)',
        r'ARTIGO\s*[:\-]\s*\n\s*(.+)',
        # Também tenta na mesma linha
        r'PRODUTO\s*/\s*SERVICO\s+ADQUIRIDO\s*[:\-]\s*(.+)',
        r'PRODUTO\s*[:\-]\s*(.+)',
    ]
    for pattern in patterns:
        match = re.search(pattern, texto, re.IGNORECASE)
        if match:
            item = match.group(1).strip()
            if len(item) > 3:
                return [item]
    return []


def extract_invoice_info_from_text(texto, filename):
    """Extrai info da fatura directamente por regex — sem IA."""
    loja = _extrair_campo(texto, 'LOJA', 'Loja / Fornecedor', 'Fornecedor', 'Empresa')
    if not loja or '@' in loja or '.pt' in loja or '.com' in loja:
        loja = os.path.splitext(filename)[0].replace('_', ' ').title()

    data_raw = _extrair_campo(texto, 'DATA DE COMPRA', 'Data de Compra', 'DATA', 'Data')
    data_compra = _normalizar_data(data_raw)

    total = _extrair_total(texto)

    cat_raw = _extrair_campo(texto, 'CATEGORIA')
    categoria = 'Outros'
    if cat_raw:
        cat_lower = cat_raw.lower().strip()
        categoria = CATEGORIA_MAP.get(cat_lower, 'Outros')
        if categoria == 'Outros':
            for key, val in CATEGORIA_MAP.items():
                if key in cat_lower:
                    categoria = val
                    break

    items = _extrair_items(texto)
    data_devolucao, data_garantia = _calcular_datas(data_compra)

    return {
        'loja': loja or 'Desconhecida',
        'data_compra': data_compra,
        'total': total or 0.0,
        'items': json.dumps(items, ensure_ascii=False),
        'categoria': categoria,
        'data_garantia': data_garantia,
        'data_devolucao': data_devolucao,
    }


# ─── ÍNDICE ───────────────────────────────────────────────────────────────────

def get_user_paths(base_upload, base_storage, user_id):
    data_dir = os.path.join(base_upload, str(user_id))
    storage_dir = os.path.join(base_storage, str(user_id))
    os.makedirs(data_dir, exist_ok=True)
    os.makedirs(storage_dir, exist_ok=True)
    return data_dir, storage_dir


def get_index(data_dir, storage_dir):
    if os.path.exists(storage_dir) and os.listdir(storage_dir):
        try:
            storage_context = StorageContext.from_defaults(persist_dir=storage_dir)
            return load_index_from_storage(storage_context)
        except Exception:
            pass
    if not os.path.exists(data_dir) or not os.listdir(data_dir):
        return None
    documents = SimpleDirectoryReader(data_dir).load_data()
    if not documents:
        return None
    index = VectorStoreIndex.from_documents(documents)
    index.storage_context.persist(persist_dir=storage_dir)
    return index


def rebuild_index(data_dir, storage_dir):
    import shutil
    if os.path.exists(storage_dir):
        shutil.rmtree(storage_dir)
    os.makedirs(storage_dir, exist_ok=True)
    documents = SimpleDirectoryReader(data_dir).load_data()
    index = VectorStoreIndex.from_documents(documents)
    index.storage_context.persist(persist_dir=storage_dir)
    return index


def chat_with_index(index, user_message, personalidade='calm'):
    system = SYSTEM_PROMPTS.get(personalidade, DEFAULT_SYSTEM_PROMPT)
    full_query = f"{system}\n\nPergunta: {user_message}"
    query_engine = index.as_query_engine(streaming=False)
    response = query_engine.query(full_query)
    return str(response)


# ─── EXTRAÇÃO COM IA (PDF / imagem) ──────────────────────────────────────────

def extract_invoice_info(index, filename):
    prompt = """Lê o documento e extrai APENAS dados escritos explicitamente. Não inventes nada.
Responde APENAS com JSON válido:
{
  "loja": "nome exacto da loja (nunca um email ou URL)",
  "data_compra": "DD/MM/YYYY ou null",
  "total": numero decimal ou null,
  "items": ["produto ou serviço comprado"],
  "categoria": "Tecnologia|Alimentação|Vestuário|Casa & Decoração|Saúde & Beleza|Desporto|Entretenimento|Transportes|Educação|Outros"
}"""

    try:
        query_engine = index.as_query_engine(streaming=False)
        response = query_engine.query(prompt)
        text = str(response).strip()

        if '```json' in text:
            text = text.split('```json')[1].split('```')[0].strip()
        elif '```' in text:
            text = text.split('```')[1].split('```')[0].strip()

        start = text.find('{')
        end = text.rfind('}') + 1
        if start != -1 and end > start:
            text = text[start:end]

        data = json.loads(text)
        data_compra = _normalizar_data(data.get('data_compra'))
        data_devolucao, data_garantia = _calcular_datas(data_compra)

        categoria = data.get('categoria', 'Outros')
        if categoria not in CATEGORIAS_VALIDAS:
            categoria = CATEGORIA_MAP.get(categoria.lower(), 'Outros')

        loja = data.get('loja') or ''
        if not loja or '@' in loja or 'http' in loja or loja.endswith('.pt') or loja.endswith('.com'):
            loja = os.path.splitext(filename)[0].replace('_', ' ').title()

        return {
            'loja': loja,
            'data_compra': data_compra,
            'total': float(data.get('total') or 0),
            'items': json.dumps(data.get('items') or [], ensure_ascii=False),
            'categoria': categoria,
            'data_garantia': data_garantia,
            'data_devolucao': data_devolucao,
        }
    except Exception:
        return {
            'loja': os.path.splitext(filename)[0].replace('_', ' ').title(),
            'data_compra': None,
            'total': 0.0,
            'items': '[]',
            'categoria': 'Outros',
            'data_garantia': None,
            'data_devolucao': None,
        }
