</div>

<div class="card-danger-zone">
    <h3>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        Zona de Perigo
    </h3>
    <p>Eliminar conta apaga permanentemente todos os teus dados, faturas e histórico de conversas. Esta ação é irreversível.</p>
    <button class="btn-danger-outline" onclick="confirmarEliminar()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
            <path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
        </svg>
        Eliminar Conta Permanentemente
    </button>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
document.getElementById('avatarInput').addEventListener('change', async function () {
    const file = this.files[0];
    if (!file) return;

    const wrapper = document.getElementById('avatarWrapper');
    wrapper.classList.add('uploading');

    const fd = new FormData();
    fd.append('avatar', file);

    try {
        const res  = await fetch('{{ url_for("perfil.upload_avatar") }}', { method: 'POST', body: fd });
        const data = await res.json();

        if (data.success) {
            const preview = document.getElementById('avatarPreview');
            const newSrc  = data.avatar_url + '?t=' + Date.now();
            if (preview.tagName === 'DIV') {
                const img = document.createElement('img');
                img.className = 'avatar-img';
                img.id = 'avatarPreview';
                img.alt = 'Avatar';
                img.src = newSrc;
                preview.replaceWith(img);
            } else {
                preview.src = newSrc;
            }
        } else {
            alert(data.message || 'Erro ao fazer upload.');
        }
    } catch (e) {
        alert('Erro de rede. Tenta novamente.');
    } finally {
        wrapper.classList.remove('uploading');
        this.value = '';
    }
});

function confirmarEliminar() {
    const conf = prompt('Escreve "ELIMINAR" para confirmar:');
    if (conf === 'ELIMINAR') {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '{{ url_for("perfil.eliminar_conta") }}';
        document.body.appendChild(form);
        form.submit();
    }
}
</script>
{% endblock %}
</file>

<file path="templates/subscriptions.html">
{% extends 'base.html' %}
{% block title %}Leak Detector · Verly{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1 class="page-title">Subscription Leak Detector</h1>
        <p class="page-sub">Descobre subscrições esquecidas que estão a drenar a tua conta todos os meses</p>
    </div>
</div>

<!-- MÉTRICAS RESUMO -->
<div class="metrics-grid" style="grid-template-columns: repeat(3,1fr); margin-bottom:24px;">
    <div class="metric-card">
        <div class="metric-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
        </div>
        <div class="metric-body">
            <span class="metric-label">Desperdiçado / mês</span>
            <span class="metric-value metric-value-sm" style="color:var(--red)">{{ '%.2f'|format(total_mensal_desperdicado) }}€</span>
            <span class="metric-trend trend-bad">≈ {{ '%.0f'|format(total_anual_desperdicado) }}€/ano</span>
        </div>
    </div>
    <div class="metric-card">
        <div class="metric-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
            </svg>
        </div>
        <div class="metric-body">
            <span class="metric-label">Subscr. saudáveis</span>
            <span class="metric-value metric-value-sm" style="color:var(--green)">{{ count_ok }}</span>
            <span class="metric-trend trend-ok">{{ '%.2f'|format(total_mensal_ok) }}€/mês</span>
        </div>
    </div>
    <div class="metric-card">
        <div class="metric-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--yellow)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
        </div>
        <div class="metric-body">
            <span class="metric-label">Em risco</span>
            <span class="metric-value metric-value-sm" style="color:var(--yellow)">{{ count_danger + count_warning }}</span>
            <span class="metric-trend trend-bad">{{ count_danger }} para cancelar</span>
        </div>
    </div>
</div>

<!-- UPLOAD EXTRATO — zona principal de ação -->
<div class="card" style="margin-bottom:24px;">
    <div class="card-header">
        <h3>Analisar Extrato Bancário</h3>
        <span style="font-size:12px;color:var(--text-muted)">TXT ou CSV exportado do teu banco</span>
    </div>
    <div class="card-body">
        <!-- Upload zone com z-index corretamente gerido -->
        <div class="upload-zone-lg" id="dropZone">
            <!-- O input fica por cima de tudo via z-index:2 no CSS -->
            <input type="file" id="extratoInput" accept=".txt,.csv" onchange="analisarExtrato(this.files[0])">
            <span class="uz-icon">📄</span>
            <span class="uz-title">Arrasta o extrato aqui ou clica para escolher</span>
            <span class="uz-sub">Suporta extratos em TXT e CSV de qualquer banco português</span>
            <div class="uz-formats">
                <span class="uz-format-tag">.txt</span>
                <span class="uz-format-tag">.csv</span>
            </div>
        </div>

        <div id="uploadStatus" style="display:none; margin-top:16px; padding:12px 16px; border-radius:9px; font-size:13px; font-weight:500;"></div>
    </div>
</div>

<!-- RESULTADO DO EXTRATO (aparece após upload) -->
<div id="resultadoExtrato" style="display:none; margin-bottom:24px;"></div>

{% if subscriptions %}
<!-- SUBSCRIÇÕES DAS FATURAS -->
<div class="card" style="margin-bottom:24px;">
    <div class="card-header">
        <h3>Subscrições nas Faturas</h3>
        <span style="font-size:12px;color:var(--text-muted)">{{ subscriptions|length }} serviço(s) detetado(s)</span>
    </div>
    <div class="card-body" style="padding:0;">
        {% for sub in subscriptions %}
        <div style="display:flex;align-items:center;gap:14px;padding:14px 18px;border-bottom:1px solid var(--border);transition:background var(--transition);"
             onmouseover="this.style.background='var(--surface2)'" onmouseout="this.style.background='transparent'">
            <div style="width:40px;height:40px;border-radius:10px;flex-shrink:0;
                background:{% if sub.risk == 'danger' %}var(--red-bg){% elif sub.risk == 'warning' %}var(--yellow-bg){% else %}var(--green-bg){% endif %};
                display:flex;align-items:center;justify-content:center;font-size:19px;">
                {{ sub.icone }}
            </div>
            <div style="flex:1;min-width:0;">
                <div style="font-size:13.5px;font-weight:700;color:var(--text);margin-bottom:2px;">{{ sub.nome }}</div>
                <div style="font-size:12px;color:var(--text-muted);">{{ sub.alerta }}</div>
            </div>
            <div style="text-align:right;flex-shrink:0;">
                <div style="font-size:15px;font-weight:800;font-family:'JetBrains Mono',monospace;
                    color:{% if sub.risk == 'danger' %}var(--red){% elif sub.risk == 'warning' %}var(--yellow){% else %}var(--green){% endif %};">
                    {{ '%.2f'|format(sub.preco_mensal) }}€/mês
                </div>
                <span class="db-badge db-badge-{% if sub.risk == 'danger' %}danger{% elif sub.risk == 'warning' %}warning{% else %}ok{% endif %}" style="margin-top:5px;">
                    {{ sub.risk_label }}
                </span>
            </div>
        </div>
        {% endfor %}
    </div>
</div>

{% if total_mensal_desperdicado > 0 %}
<div style="background:var(--red-bg);border:1px solid rgba(244,63,94,0.18);border-radius:var(--radius);padding:18px 20px;margin-bottom:24px;">
    <div style="font-size:10px;font-weight:700;letter-spacing:1px;color:var(--red);margin-bottom:8px;text-transform:uppercase;">⚠ Resumo de Impacto</div>
    <div style="font-size:14px;color:var(--text);line-height:1.7;">
        Estás a desperdiçar <strong style="color:var(--red)">{{ '%.2f'|format(total_mensal_desperdicado) }}€/mês</strong>
        em subscrições. São <strong style="color:var(--red)">{{ '%.0f'|format(total_anual_desperdicado) }}€/ano</strong> a ir pelo cano.
    </div>
</div>
{% endif %}

{% else %}
<div class="card">
    <div class="empty-card">
        <span>🛡️</span>
        <p>Carrega o teu extrato bancário acima para detetar subscrições automaticamente.<br>
        Ou adiciona faturas em <a href="{{ url_for('faturas.faturas') }}">Faturas</a> para análise.</p>
    </div>
</div>
{% endif %}

{% block extra_scripts %}
<script>
// ─── Drag & drop events ───────────────────────────────────────────────────────
const dropZone = document.getElementById('dropZone');

dropZone.addEventListener('dragover', e => {
    e.preventDefault();
    dropZone.classList.add('drag-over');
});
dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    const file = e.dataTransfer.files[0];
    if (file) analisarExtrato(file);
});

// ─── Upload & analyze ────────────────────────────────────────────────────────
async function analisarExtrato(file) {
    if (!file) return;

    const status    = document.getElementById('uploadStatus');
    const resultado = document.getElementById('resultadoExtrato');

    // Reset
    status.className = '';
    status.style.display = 'block';
    status.style.background = 'var(--surface2)';
    status.style.border = '1px solid var(--border)';
    status.style.color = 'var(--text-muted)';
    status.innerHTML = `⏳ A analisar <strong>${file.name}</strong>…`;
    resultado.style.display = 'none';

    const formData = new FormData();
    formData.append('extrato', file);

    try {
        const res  = await fetch('/subscriptions/analisar-extrato', { method: 'POST', body: formData });
        const data = await res.json();

        if (!data.success) {
            status.style.background = 'var(--red-bg)';
            status.style.border = '1px solid rgba(244,63,94,0.2)';
            status.style.color = 'var(--red)';
            status.innerHTML = `❌ ${data.error}`;
            return;
        }

        status.style.background = 'var(--green-bg)';
        status.style.border = '1px solid rgba(34,211,160,0.2)';
        status.style.color = 'var(--green)';
        status.innerHTML = `✓ Extrato analisado — ${data.total_movimentos} movimentos lidos`;

        if (!data.subscriptions || !data.subscriptions.length) {
            resultado.style.display = 'block';
            resultado.innerHTML = `
                <div class="card">
                    <div class="card-body" style="text-align:center;padding:40px;color:var(--text-muted);">
                        ✅ Nenhuma subscrição recorrente detetada neste extrato.
                    </div>
                </div>`;
            return;
        }

        const riskColor = { danger: 'var(--red)', warning: 'var(--yellow)', ok: 'var(--green)' };
        const riskBg    = { danger: 'var(--red-bg)', warning: 'var(--yellow-bg)', ok: 'var(--green-bg)' };
        const badgeClass = { danger: 'db-badge-danger', warning: 'db-badge-warning', ok: 'db-badge-ok' };

        const linhas = data.subscriptions.map(s => `
            <div style="display:flex;align-items:center;gap:14px;padding:14px 18px;border-bottom:1px solid var(--border);">
                <div style="width:40px;height:40px;border-radius:10px;background:${riskBg[s.risk]};
                    display:flex;align-items:center;justify-content:center;font-size:19px;flex-shrink:0;">
                    ${s.icone}
                </div>
                <div style="flex:1;min-width:0;">
                    <div style="font-size:13.5px;font-weight:700;color:var(--text);margin-bottom:2px;">${s.nome}</div>
                    <div style="font-size:12px;color:var(--text-muted);">${s.alerta}</div>
                </div>
                <div style="text-align:right;flex-shrink:0;">
                    <div style="font-size:15px;font-weight:800;font-family:'JetBrains Mono',monospace;color:${riskColor[s.risk]};">
                        ${s.preco_mensal.toFixed(2)}€/mês
                    </div>
                    <span class="db-badge ${badgeClass[s.risk]}" style="margin-top:5px;display:inline-block;">
                        ${s.risk_label}
                    </span>
                </div>
            </div>
        `).join('');

        const desperdicado = data.total_mensal_desperdicado.toFixed(2);
        const anual        = data.total_anual_desperdicado.toFixed(0);

        resultado.style.display = 'block';
        resultado.innerHTML = `
            <div class="card" style="margin-bottom:14px;">
                <div class="card-header">
                    <h3>Subscrições no Extrato</h3>
                    <span style="font-size:12px;color:var(--text-muted)">${data.subscriptions.length} detetada(s)</span>
                </div>
                <div class="card-body" style="padding:0;">${linhas}</div>
            </div>
            ${data.total_mensal_desperdicado > 0 ? `
            <div style="background:var(--red-bg);border:1px solid rgba(244,63,94,0.18);border-radius:var(--radius);padding:18px 20px;">
                <div style="font-size:10px;font-weight:700;letter-spacing:1px;color:var(--red);margin-bottom:8px;text-transform:uppercase;">⚠ Resumo de Impacto</div>
                <div style="font-size:14px;color:var(--text);line-height:1.7;">
                    Encontrámos <strong style="color:var(--red)">${desperdicado}€/mês</strong> em subscrições recorrentes —
                    isso são <strong style="color:var(--red)">${anual}€/ano</strong>.
                </div>
            </div>` : ''}
        `;
    } catch (err) {
        status.style.background = 'var(--red-bg)';
        status.style.border = '1px solid rgba(244,63,94,0.2)';
        status.style.color = 'var(--red)';
        status.innerHTML = '❌ Erro de ligação ao analisar o ficheiro.';
    }
}
</script>
