{% block extra_scripts %}
<script>
let usoSelecionado = 'monthly';

// Selecionar uso
function selecionarUso(uso, btn) {
    usoSelecionado = uso;
    document.querySelectorAll('.uso-btn').forEach(b => {
        b.style.background = 'var(--surface2)';
        b.style.color = 'var(--text-muted)';
        b.style.borderColor = 'var(--border)';
    });
    btn.style.background = 'rgba(123,97,255,0.12)';
    btn.style.color = 'var(--brand)';
    btn.style.borderColor = 'var(--brand)';
}

// Selecionar "Às vezes" por defeito ao carregar
window.addEventListener('DOMContentLoaded', () => {
    const btn = document.querySelector('[data-uso="monthly"]');
    if (btn) selecionarUso('monthly', btn);
});

const SCORE_COLORS = {
    green:  { stroke: '#00D68F', bg: 'rgba(0,214,143,0.12)', text: '#00D68F' },
    brand2: { stroke: '#7B61FF', bg: 'rgba(123,97,255,0.12)', text: '#7B61FF' },
    yellow: { stroke: '#FFB800', bg: 'rgba(255,184,0,0.12)', text: '#FFB800' },
    orange: { stroke: '#FF8C00', bg: 'rgba(255,140,0,0.12)', text: '#FF8C00' },
    red:    { stroke: '#FF4757', bg: 'rgba(255,71,87,0.12)', text: '#FF4757' },
    muted:  { stroke: 'var(--border)', bg: 'var(--surface2)', text: 'var(--text-muted)' },
};

const CHIP_STYLES = {
    good: 'background:rgba(0,214,143,0.12);color:#00D68F;border:1px solid rgba(0,214,143,0.25);',
    bad:  'background:rgba(255,71,87,0.12);color:#FF4757;border:1px solid rgba(255,71,87,0.25);',
    mid:  'background:var(--surface2);color:var(--text-sub);border:1px solid var(--border);',
};

async function analisarCompra() {
    const item      = document.getElementById('itemInput').value.trim();
    const preco     = parseFloat(document.getElementById('precoInput').value) || 0;
    const categoria = document.getElementById('categoriaInput').value;

    if (!item) {
        document.getElementById('itemInput').style.borderColor = '#FF4757';
        document.getElementById('itemInput').focus();
        return;
    }
    if (preco <= 0) {
        document.getElementById('precoInput').style.borderColor = '#FF4757';
        document.getElementById('precoInput').focus();
        return;
    }

    const btn = document.getElementById('btnAnalisar');
    btn.disabled = true;
    btn.textContent = 'A analisar...';

    try {
        const res = await fetch('/scoring/analisar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ item, preco, categoria, uso: usoSelecionado }),
        });
        const data = await res.json();

        if (!data.success) throw new Error(data.message || 'Erro');

        mostrarResultado(data.resultado);
    } catch (e) {
        alert('Erro: ' + e.message);
    } finally {
        btn.disabled = false;
        btn.textContent = 'Analisar Compra →';
    }
}

function mostrarResultado(r) {
    const colors = SCORE_COLORS[r.color] || SCORE_COLORS.muted;

    // Item name
    document.getElementById('resItem').textContent = r.item || 'Compra';

    // Label badge
    const lbl = document.getElementById('resLabel');
    lbl.textContent = r.label;
    lbl.style.cssText = `font-size:13px;font-weight:700;padding:4px 12px;border-radius:12px;background:${colors.bg};color:${colors.text};`;

    // Score number
    document.getElementById('scoreNum').textContent = r.score;

    // Score circle animation
    const circle = document.getElementById('scoreCircle');
    const circumference = 226;
    const offset = circumference - (r.score / 100) * circumference;
    setTimeout(() => {
        circle.style.strokeDashoffset = offset;
        circle.style.stroke = colors.stroke;
    }, 50);

    // Message
    document.getElementById('resMessage').textContent = r.message;

    // Chips
    const chipsEl = document.getElementById('resChips');
    chipsEl.innerHTML = (r.chips || []).map(c =>
        `<span style="font-size:12px;font-weight:600;padding:4px 10px;border-radius:10px;${CHIP_STYLES[c.type] || CHIP_STYLES.mid}">${c.text}</span>`
    ).join('');

    // Show
    const resDiv = document.getElementById('resultado');
    resDiv.style.display = 'block';
    resDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}
</script>
{% endblock %}
