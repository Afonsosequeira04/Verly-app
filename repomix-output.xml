                        <span class="nav-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="20" x2="18" y2="10"/>
                                <line x1="12" y1="20" x2="12" y2="4"/>
                                <line x1="6"  y1="20" x2="6"  y2="14"/>
                            </svg>
                        </span>
                        <span class="nav-label">Metas</span>
                    </a>
                </li>
            </ul>

            <!-- FERRAMENTAS -->
            <span class="sidenav-section">Ferramentas</span>
            <ul class="sidenav-menu">
                <li>
                    <a href="{{ url_for('scoring.analisar') }}"
                       class="nav-link {% if request.endpoint and 'scoring' in request.endpoint %}active{% endif %}"
                       data-tooltip="Score de Compras">
                        <span class="nav-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <polyline points="12 6 12 12 16 14"/>
