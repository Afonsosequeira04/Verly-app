<file path="templates/chat.html">
{% extends 'base.html' %}
{% block title %}Assistente IA · Verly{% endblock %}

{% block content %}
<div class="chat-page">
    <div class="chat-topbar">
        <div class="chat-topbar-left">
            <div class="status-dot"></div>
            <h1>Assistente Verly</h1>
        </div>
        <button class="btn-ghost" onclick="clearChat()">Limpar histórico</button>
    </div>

    <div id="messages" class="messages-area">
        {% if conversas %}
            {% for c in conversas %}
            <div class="msg user">
                <div class="msg-avatar">{{ current_user.nome[0].upper() }}</div>
                <div class="msg-bubble">{{ c.pergunta }}</div>
            </div>
            <div class="msg bot">
                <div class="msg-avatar">✦</div>
                <div class="msg-bubble">{{ c.resposta }}</div>
            </div>
            {% endfor %}
        {% else %}
        <div class="empty-chat" id="emptyChat">
            <div class="empty-chat-icon">✦</div>
            <h3>Assistente Verly</h3>
            <p>Faz perguntas sobre as tuas faturas ou gastos.</p>
        </div>
        {% endif %}
    </div>

    <div class="chat-input-area">
        <textarea id="userInput" placeholder="Pergunta algo..."
            onkeydown="handleKey(event)" oninput="autoResize(this)" rows="1"></textarea>
        <button class="btn-send" id="btnSend" onclick="sendMessage()">↑</button>
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
let emptyRemoved = {{ 'true' if conversas else 'false' }};

window.addEventListener('load', () => {
    const m = document.getElementById('messages');
    m.scrollTop = m.scrollHeight;
});

function removeEmpty() {
    if (!emptyRemoved) {
        const el = document.getElementById('emptyChat');
        if (el) el.remove();
        emptyRemoved = true;
    }
}

function addMsg(role, text, avatar) {
    removeEmpty();

    const m = document.getElementById('messages');
    const d = document.createElement('div');
    d.className = 'msg ' + role;

    d.innerHTML = `
        <div class="msg-avatar">${avatar}</div>
        <div class="msg-bubble">${text}</div>
    `;

    m.appendChild(d);
    m.scrollTop = m.scrollHeight;

    return d.querySelector('.msg-bubble');
}

// 🔥 STREAMING REAL
async function sendMessage() {
    const input = document.getElementById('userInput');
    const btn = document.getElementById('btnSend');

    const text = input.value.trim();
    if (!text) return;

    addMsg('user', text, '{{ current_user.nome[0].upper() }}');

    input.value = '';
    input.style.height = 'auto';
    btn.disabled = true;

    // cria mensagem vazia do bot
    const bubble = addMsg('bot', '', '✦');

    let fullText = "";

    try {
        const res = await fetch('/chat/stream', {
            method: 'POST',
            headers: {'Content-Type':'application/json'},
            body: JSON.stringify({message: text})
        });

        const reader = res.body.getReader();
        const decoder = new TextDecoder("utf-8");

        while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            const chunk = decoder.decode(value);
            const lines = chunk.split("\n");

            lines.forEach(line => {
                if (!line.startsWith("data: ")) return;
                const raw = line.slice(6).trim();
                if (raw === "[DONE]" || raw === "") return;

                try {
                    const parsed = JSON.parse(raw);
                    if (parsed.delta) {
                        fullText += parsed.delta;
                        bubble.innerHTML = fullText + '<span class="cursor">▍</span>';
                        const m = document.getElementById('messages');
                        m.scrollTop = m.scrollHeight;
                    }
                } catch (_) {
                    // texto simples de erro (ex: ⚠️ ...)
                    if (!raw.startsWith("{")) {
                        fullText += raw;
                        bubble.innerHTML = fullText + '<span class="cursor">▍</span>';
                    }
                }
            });
        }

        // remove cursor no fim
        bubble.innerHTML = fullText || "Sem resposta.";

    } catch (e) {
        bubble.innerHTML = "Erro de ligação.";
    }

    btn.disabled = false;
}

async function clearChat() {
    if (!confirm('Apagar todo o histórico?')) return;
    try {
        const r = await fetch('/chat/limpar', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'}
        });
        const data = await r.json();
        if (data.success) location.reload();
        else alert('Erro ao limpar o histórico.');
    } catch(e) {
        alert('Erro de ligação.');
    }
}

function handleKey(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
    }
}

function autoResize(el) {
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight, 120) + 'px';
}
</script>

<style>
.cursor {
    display: inline-block;
    margin-left: 2px;
    animation: blink 1s infinite;
}

@keyframes blink {
    0% {opacity: 1;}
    50% {opacity: 0;}
    100% {opacity: 1;}
}
</style>
{% endblock %}
</file>

<file path="templates/dashboard.html">
{% extends 'base.html' %}
{% block title %}Dashboard · Verly{% endblock %}
{% block extra_head %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-sub">Olá, {{ current_user.nome }}. Aqui está o teu resumo financeiro.</p>
    </div>
    <div style="display:flex;gap:10px;">
        <a href="{{ url_for('exportar.exportar_pdf') }}" class="btn-ghost">⬇ Exportar PDF</a>
        <a href="{{ url_for('faturas.faturas') }}" class="btn-accent">+ Nova Fatura</a>
    </div>
</div>

{% if alertas %}
<div class="alertas-section">
    {% for a in alertas %}
    <div class="alerta alerta-{{ a.urgencia }}">
        <span class="alerta-icon">{% if a.tipo == 'devolucao' %}↩{% else %}🛡{% endif %}</span>
        <div class="alerta-body">
            <strong>{% if a.tipo == 'devolucao' %}Devolução expira{% else %}Garantia expira{% endif %} em {{ a.dias }} dia(s)</strong>
            <span>{{ a.loja }} · {{ a.fatura }} · até {{ a.data }}</span>
        </div>
        <span class="alerta-badge">{{ a.tipo|upper }}</span>
    </div>
    {% endfor %}
</div>
{% endif %}

<!-- VERLY MOOD + STREAK + FEED -->
<div class="verly-alive-row">

    <!-- MOOD CARD -->
    <div class="verly-mood-card" style="--mood-color: {{ mood.cor }};">
        <div class="mood-glow"></div>
        <div class="mood-content">
            <div class="mood-icon">{{ mood.icon }}</div>
            <div class="mood-info">
                <span class="mood-label">Verly está</span>
                <span class="mood-estado">{{ mood.nivel|upper }}</span>
                <p class="mood-frase">"{{ mood.frase }}"</p>
            </div>
        </div>
        {% if orcamento > 0 %}
        <div class="mood-bar-wrap">
            <div class="mood-bar">
                <div class="mood-bar-fill" style="width: {{ [((total_gasto / orcamento) * 100)|round|int, 100]|min }}%;"></div>
            </div>
            <span class="mood-bar-label">{{ "%.0f"|format([((total_gasto / orcamento) * 100), 100]|min) }}% do orçamento</span>
        </div>
        {% endif %}
    </div>

    <!-- STREAK CARD -->
    <div class="verly-streak-card">
        <div class="streak-fire">🔥</div>
        <div class="streak-num">{{ streak }}</div>
        <div class="streak-label">dias sem compras impulsivas</div>
        <div class="streak-sub">
            {% if streak == 0 %}
            Recomeça hoje!
            {% elif streak < 7 %}
            Continua assim!
            {% elif streak < 30 %}
            Boa sequência! 💪
            {% else %}
            Incrível disciplina! 🏆
            {% endif %}
        </div>
    </div>

    <!-- FEED CARD -->
    <div class="verly-feed-card">
        <div class="feed-header">
            <span class="feed-title">O que a Verly pensa</span>
            <span class="feed-dot"></span>
        </div>
        <ul class="feed-list">
            {% for item in feed_verly %}
            <li class="feed-item feed-{{ item.tipo }}">
                <span class="feed-item-icon">{{ item.icone }}</span>
                <span class="feed-item-text">{{ item.texto }}</span>
            </li>
            {% endfor %}
        </ul>
    </div>

</div>

<!-- #7 COMPARAÇÃO MENSAL + #5 SCORE ÚLTIMA FATURA -->
{% if comparacao.variacao_pct is not none or score_ultima %}
<div class="db-row db-row-2" style="margin-bottom:20px;">

    {% if comparacao.variacao_pct is not none %}
    <div class="card db-compare-card">
        <div class="card-header">
            <h3>Comparação mensal</h3>
            <a href="{{ url_for('reports.relatorio') }}" class="card-link">Ver relatório →</a>
        </div>
        <div class="card-body">
            <div class="compare-row">
                <div class="compare-col">
                    <span class="compare-label">Mês anterior</span>
                    <span class="compare-val">{{ "%.2f"|format(comparacao.mes_anterior_total) }} €</span>
                </div>
                <div class="compare-arrow {{ 'compare-up' if comparacao.subiu else 'compare-down' }}">
                    {% if comparacao.subiu %}▲{% else %}▼{% endif %}
                    {{ comparacao.variacao_pct|abs }}%
                </div>
                <div class="compare-col compare-col-right">
                    <span class="compare-label">Este mês</span>
                    <span class="compare-val {{ 'text-danger' if comparacao.subiu else 'text-ok' }}">{{ "%.2f"|format(comparacao.mes_atual_total) }} €</span>
                </div>
            </div>
            {% if comparacao.top_cat_delta %}
            <div class="compare-insight">
                <span>{{ '📈' if comparacao.top_cat_delta_val > 0 else '📉' }}</span>
                <span>
                    <strong>{{ comparacao.top_cat_delta }}</strong>
                    {{ 'subiu' if comparacao.top_cat_delta_val > 0 else 'desceu' }}
                    {{ "%.0f"|format(comparacao.top_cat_delta_val|abs) }}€ vs mês anterior
                </span>
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}

    {% if score_ultima %}
    <div class="card db-score-card">
        <div class="card-header">
            <h3>Última compra</h3>
            <a href="{{ url_for('scoring.analisar') }}" class="card-link">Analisar fatura →</a>
        </div>
        <div class="card-body" style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;">
            <div class="score-ring" style="--score-color: {{ score_ultima.cor }};">
                <svg viewBox="0 0 80 80" width="80" height="80">
                    <circle cx="40" cy="40" r="32" fill="none" stroke="var(--border)" stroke-width="6"/>
                    <circle cx="40" cy="40" r="32" fill="none" stroke="{{ score_ultima.cor }}" stroke-width="6"
                        stroke-dasharray="{{ (score_ultima.score / 100 * 201)|round }} 201"
                        stroke-linecap="round" transform="rotate(-90 40 40)"/>
                    <text x="40" y="45" text-anchor="middle" font-size="18" font-weight="700" fill="{{ score_ultima.cor }}" font-family="Sora,sans-serif">{{ score_ultima.score }}</text>
                </svg>
            </div>
            <div>
                <div style="font-size:14px;font-weight:700;color:var(--text);">{{ score_ultima.loja }}</div>
                <div style="font-size:12px;color:var(--text-muted);">{{ "%.2f"|format(score_ultima.total) }}€ · {{ score_ultima.categoria }}</div>
                <div class="score-label-badge" style="background:{{ score_ultima.cor }}22;color:{{ score_ultima.cor }};margin-top:6px;">{{ score_ultima.label }}</div>
            </div>
        </div>
    </div>
    {% endif %}

</div>
{% endif %}

<!-- MÉTRICAS -->
<div class="db-metrics">
    <div class="db-metric">
        <span class="db-metric-label">Total Gasto</span>
        <span class="db-metric-value">{{ "%.2f"|format(total_gasto) }} €</span>
        {# #7 comparação vs mês anterior #}
        {% if comparacao.variacao_pct is not none %}
        <span class="db-metric-sub {{ 'db-sub-bad' if comparacao.subiu else 'db-sub-ok' }}">
            {{ '+' if comparacao.subiu else '' }}{{ comparacao.variacao_pct }}% vs mês anterior
        </span>
        {% else %}
        <span class="db-metric-sub db-sub-neutral">primeiro mês registado</span>
        {% endif %}
    </div>
    <div class="db-metric">
        <span class="db-metric-label">Faturas</span>
        <span class="db-metric-value">{{ num_faturas }}</span>
        <span class="db-metric-sub db-sub-neutral">registadas</span>
    </div>
    <div class="db-metric">
        <span class="db-metric-label">Desperdício estimado</span>
        <span class="db-metric-value {{ 'db-val-danger' if desperdicado_mes > 100 else '' }}">{{ "%.0f"|format(desperdicado_mes) }} €</span>
        <span class="db-metric-sub {{ 'db-sub-bad' if desperdicado_mes > 100 else 'db-sub-neutral' }}">este mês · <a href="{{ url_for('reports.relatorio') }}" style="color:var(--brand-2);font-size:11px;">ver relatório →</a></span>
    </div>
    <div class="db-metric">
        <span class="db-metric-label">Alertas</span>
        <span class="db-metric-value {% if alertas %}db-val-danger{% endif %}">{{ alertas|length }}</span>
        <span class="db-metric-sub {% if alertas %}db-sub-bad{% else %}db-sub-ok{% endif %}">
            {% if alertas %}requer atenção{% else %}tudo em ordem{% endif %}
        </span>
    </div>
</div>

<!-- LINHA 1: DONUT + BARRAS HORIZONTAIS -->
<div class="db-row db-row-3-1">
    <div class="card">
        <div class="card-header"><h3>Gastos por categoria</h3></div>
        <div class="card-body">
            {% if cat_labels != '[]' %}
            <div id="cat-legend" class="db-legend"></div>
            <div class="db-chart-wrap" style="height:220px;">
                <canvas id="catChart" role="img" aria-label="Gastos por categoria em gráfico donut"></canvas>
            </div>
            {% else %}
            <div class="empty-card"><span>📊</span><p>Carrega faturas para ver os gráficos.</p></div>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h3>Por loja</h3></div>
        <div class="card-body">
            {% if loja_labels != '[]' %}
            <div class="db-chart-wrap" style="height:260px;">
                <canvas id="lojaChart" role="img" aria-label="Gastos por loja em barras horizontais"></canvas>
            </div>
            {% else %}
            <div class="empty-card"><span>🏪</span><p>Sem dados ainda.</p></div>
            {% endif %}
        </div>
    </div>
</div>

<!-- LINHA 2: SUBSCRIÇÕES + EVOLUÇÃO -->
<div class="db-row db-row-2">
    <div class="card">
        <div class="card-header">
            <h3>Leak de subscrições</h3>
            <a href="{{ url_for('subscriptions.subscriptions') }}" class="card-link">Ver tudo →</a>
        </div>
        <div class="card-body">
            {% if subs_top %}
            <div class="db-waste-box">
                <div>
                    <div class="db-waste-label">Desperdício / mês</div>
                    <div class="db-waste-val">{{ "%.2f"|format(subs_total_mensal) }} €</div>
                    <div class="db-waste-annual">≈ {{ "%.0f"|format(subs_total_mensal * 12) }} € / ano</div>
                </div>
                <div style="display:flex;gap:8px;">
                    {% if subs_count_danger > 0 %}
                    <div class="db-counter db-counter-danger">
                        <div class="db-counter-val">{{ subs_count_danger }}</div>
                        <div class="db-counter-label">cancelar</div>
                    </div>
                    {% endif %}
                    {% if subs_count_warning > 0 %}
                    <div class="db-counter db-counter-warning">
                        <div class="db-counter-val">{{ subs_count_warning }}</div>
                        <div class="db-counter-label">suspeitas</div>
                    </div>
                    {% endif %}
                </div>
            </div>
            <div style="display:flex;flex-direction:column;gap:7px;">
                {% for s in subs_top %}
                <div class="db-sub-row">
                    <div class="db-sub-icon">{{ s.icone }}</div>
                    <div class="db-sub-info">
                        <div class="db-sub-name">{{ s.nome }}</div>
                        <div class="db-sub-desc">{{ s.alerta }}</div>
                    </div>
                    <div style="text-align:right;flex-shrink:0;">
                        <div class="db-sub-price">{{ "%.2f"|format(s.preco_mensal) }} €</div>
                        <span class="db-badge db-badge-{{ s.risk }}">{{ s.risk_label }}</span>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="empty-card">
                <span>📊</span>
                <p>Ainda sem subscrições. <a href="{{ url_for('subscriptions.subscriptions') }}">Carrega um extrato</a> para analisar.</p>
            </div>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h3>Evolução mensal</h3></div>
        <div class="card-body">
            {% if has_trend %}
            <div class="db-chart-wrap" style="height:220px;">
                <canvas id="trendChart" role="img" aria-label="Evolução do total gasto por mês em gráfico de linha"></canvas>
            </div>
            {% else %}
            <div class="empty-card"><span>📈</span><p>Sem dados ainda.</p></div>
            {% endif %}
        </div>
    </div>
</div>

<!-- LINHA 3: FATURAS + CONVERSAS -->
<div class="db-row db-row-2">
    <div class="card">
        <div class="card-header">
            <h3>Últimas Faturas</h3>
            <a href="{{ url_for('faturas.faturas') }}" class="card-link">Ver todas →</a>
        </div>
        <div class="card-body" style="padding:0;">
            {% if ultimas_faturas %}
            <table class="data-table">
                <thead><tr><th>Loja</th><th>Categoria</th><th>Total</th><th>Data</th></tr></thead>
                <tbody>
                    {% for f in ultimas_faturas %}
                    <tr>
                        <td>{{ f.loja or '—' }}</td>
                        <td><span class="cat-badge">{{ f.categoria or '—' }}</span></td>
                        <td class="{% if f.total and f.total > 100 %}text-danger{% endif %}">
                            {% if f.total %}{{ "%.2f"|format(f.total) }} €{% else %}—{% endif %}
                        </td>
                        <td class="text-muted">{{ f.data_upload.strftime('%d/%m/%Y') }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <div class="empty-card" style="padding:32px;"><span>🧾</span><p><a href="{{ url_for('faturas.faturas') }}">Submete a tua primeira fatura.</a></p></div>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>Conversas Recentes</h3>
            <div style="display:flex;align-items:center;gap:10px;">
                <button class="btn-clear-chat" onclick="limparChat()" title="Limpar histórico">🗑 Limpar</button>
                <a href="{{ url_for('chat.chat') }}" class="card-link">Ver todas →</a>
            </div>
        </div>
        <div class="card-body">
            {% if conversas_recentes %}
            <ul class="convo-list">
                {% for c in conversas_recentes %}
                <li class="convo-item">
                    <div class="convo-q">{{ c.pergunta[:80] }}{% if c.pergunta|length > 80 %}...{% endif %}</div>
                    <div class="convo-a">{{ c.resposta[:120] }}{% if c.resposta|length > 120 %}...{% endif %}</div>
                    <div class="convo-time">{{ c.timestamp.strftime('%d/%m %H:%M') }}</div>
                </li>
                {% endfor %}
            </ul>
            {% else %}
            <div class="empty-card"><span>💬</span><p>Ainda sem conversas com o assistente.</p></div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<style>
/* ── VERLY ALIVE ROW ─────────────────────────────────────────────── */
.verly-alive-row {
    display: grid;
    grid-template-columns: 1fr 180px 1fr;
    gap: 16px;
    margin-bottom: 20px;
}

/* MOOD CARD */
.verly-mood-card {
    position: relative;
    background: var(--surface2);
    border: 1px solid var(--mood-color, var(--border));
    border-radius: var(--radius);
    padding: 20px;
    overflow: hidden;
    transition: border-color 0.4s ease;
}
.mood-glow {
    position: absolute;
    top: -40px; left: -40px;
    width: 180px; height: 180px;
    border-radius: 50%;
    background: var(--mood-color, var(--accent));
    opacity: 0.06;
    filter: blur(40px);
    pointer-events: none;
}
.mood-content {
    display: flex;
    align-items: flex-start;
    gap: 14px;
}
.mood-icon {
    font-size: 32px;
    line-height: 1;
    flex-shrink: 0;
}
.mood-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.mood-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .8px;
    text-transform: uppercase;
    color: var(--text-muted);
}
.mood-estado {
    font-family: 'Sora', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--mood-color, var(--text));
    letter-spacing: -.3px;
}
.mood-frase {
    font-size: 12px;
    color: var(--text-sub);
    margin: 4px 0 0;
    font-style: italic;
    line-height: 1.4;
}
.mood-bar-wrap {
    margin-top: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
}
.mood-bar {
    flex: 1;
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
}
.mood-bar-fill {
    height: 100%;
    background: var(--mood-color, var(--accent));
    border-radius: 2px;
    transition: width 1s cubic-bezier(.4,0,.2,1);
}
.mood-bar-label {
    font-size: 11px;
    color: var(--text-muted);
    flex-shrink: 0;
}

/* STREAK CARD */
.verly-streak-card {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 4px;
}
.streak-fire {
    font-size: 28px;
    line-height: 1;
    margin-bottom: 4px;
    animation: pulse-fire 2s ease-in-out infinite;
}
@keyframes pulse-fire {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.12); }
}
.streak-num {
    font-family: 'Sora', sans-serif;
    font-size: 40px;
    font-weight: 700;
    color: #FF6B35;
    letter-spacing: -2px;
    line-height: 1;
}
.streak-label {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 4px;
    line-height: 1.3;
}
.streak-sub {
    font-size: 12px;
    color: var(--text-sub);
    margin-top: 6px;
    font-weight: 500;
}

/* FEED CARD */
.verly-feed-card {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.feed-header {
    display: flex;
    align-items: center;
    gap: 8px;
}
.feed-title {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .7px;
    text-transform: uppercase;
    color: var(--text-muted);
}
.feed-dot {
    width: 7px; height: 7px;
    background: #00D68F;
    border-radius: 50%;
    animation: blink 2s ease-in-out infinite;
}
@keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
}
.feed-list {
    list-style: none;
    padding: 0; margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.feed-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 9px 11px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border-left: 2px solid transparent;
    font-size: 12px;
    line-height: 1.45;
    color: var(--text-sub);
    transition: border-color 0.2s;
}
.feed-item.feed-alerta { border-left-color: var(--red); }
.feed-item.feed-positivo { border-left-color: var(--green); }
.feed-item.feed-insight { border-left-color: var(--accent); }
.feed-item.feed-info { border-left-color: var(--border); }
.feed-item-icon { flex-shrink: 0; font-size: 14px; }
.feed-item-text { flex: 1; }

/* ── MÉTRICAS ───────────────────────────────────────────────────── */
.db-metrics { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:20px; }
.db-metric { background:var(--surface2); border:1px solid var(--border); border-radius:var(--radius); padding:18px 20px; display:flex; flex-direction:column; gap:7px; }
.db-metric-label { font-size:11px; font-weight:600; letter-spacing:.8px; text-transform:uppercase; color:var(--text-muted); }
.db-metric-value { font-family:'Sora',sans-serif; font-size:28px; font-weight:700; letter-spacing:-.5px; line-height:1; color:var(--text); }
.db-val-danger { color:var(--red)!important; }
.db-metric-sub { font-size:11px; font-weight:500; }
.db-sub-ok { color:var(--green); }
.db-sub-bad { color:var(--red); }
.db-sub-neutral { color:var(--text-sub); }

.db-row { display:grid; gap:20px; margin-bottom:20px; }
.db-row-2 { grid-template-columns:1fr 1fr; }
.db-row-3-1 { grid-template-columns:2fr 1fr; }

.db-legend { display:flex; flex-wrap:wrap; gap:10px; margin-bottom:14px; }
.db-legend-item { display:flex; align-items:center; gap:5px; font-size:12px; color:var(--text-muted); }
.db-legend-dot { width:10px; height:10px; border-radius:2px; flex-shrink:0; }
.db-chart-wrap { position:relative; width:100%; }

.db-waste-box { background:rgba(255,71,87,.07); border:1px solid rgba(255,71,87,.15); border-radius:var(--radius-sm); padding:14px 16px; display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
.db-waste-label { font-size:10px; font-weight:600; letter-spacing:.6px; text-transform:uppercase; color:var(--red); margin-bottom:4px; }
.db-waste-val { font-size:26px; font-weight:700; color:var(--red); letter-spacing:-.5px; line-height:1; }
.db-waste-annual { font-size:11px; color:var(--red); opacity:.65; margin-top:4px; }
.db-counter { border-radius:var(--radius-sm); padding:8px 14px; text-align:center; border:1px solid; }
.db-counter-danger { background:rgba(255,71,87,.1); border-color:rgba(255,71,87,.2); }
.db-counter-warning { background:rgba(255,184,0,.1); border-color:rgba(255,184,0,.2); }
.db-counter-val { font-size:20px; font-weight:700; line-height:1; }
.db-counter-danger .db-counter-val { color:var(--red); }
.db-counter-warning .db-counter-val { color:var(--yellow); }
.db-counter-label { font-size:10px; color:var(--text-sub); margin-top:3px; }

.db-sub-row { display:flex; align-items:center; gap:10px; padding:9px 11px; background:var(--surface2); border-radius:var(--radius-sm); }
.db-sub-icon { font-size:18px; width:30px; text-align:center; flex-shrink:0; }
.db-sub-info { flex:1; min-width:0; }
.db-sub-name { font-size:13px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.db-sub-desc { font-size:11px; color:var(--text-muted); margin-top:1px; }
.db-sub-price { font-size:14px; font-weight:700; }
.db-badge { font-size:10px; padding:2px 7px; border-radius:4px; display:inline-block; margin-top:3px; }
.db-badge-danger { background:rgba(255,71,87,.12); color:var(--red); }
.db-badge-warning { background:rgba(255,184,0,.12); color:var(--yellow); }
.db-badge-ok { background:rgba(0,214,143,.12); color:var(--green); }

/* ── CARD BASE (usado pelos novos cards de comparação e score) ─── */
.card { background:var(--surface2); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; }
.card-header { display:flex; align-items:center; justify-content:space-between; padding:16px 20px 0; }
.card-header h3 { font-size:13px; font-weight:600; color:var(--text-muted); letter-spacing:.3px; margin:0; }
.card-link { font-size:11px; color:var(--brand-2); font-weight:500; transition:color .15s; }
.card-link:hover { color:var(--brand); }
.card-body { padding:16px 20px 20px; }

/* ── COMPARAÇÃO MENSAL ────────────────────────────────────────── */
.compare-row { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:16px 0 10px; }
.compare-col { display:flex; flex-direction:column; gap:4px; }
.compare-col-right { text-align:right; }
.compare-label { font-size:11px; color:var(--text-muted); font-weight:500; }
.compare-val { font-family:'Sora',sans-serif; font-size:22px; font-weight:700; color:var(--text); letter-spacing:-.5px; }
.compare-arrow { font-size:14px; font-weight:700; display:flex; flex-direction:column; align-items:center; gap:2px; padding:8px 12px; border-radius:8px; }
.compare-up { color:var(--red); background:rgba(255,71,87,.08); }
.compare-down { color:var(--green); background:rgba(0,214,143,.08); }
.compare-insight { display:flex; align-items:center; gap:8px; padding:10px 12px; background:var(--surface); border-radius:var(--radius-sm); font-size:12px; color:var(--text-sub); margin-top:4px; }
.compare-insight strong { color:var(--text); }
.text-ok { color:var(--green)!important; }
.text-danger { color:var(--red)!important; }

/* ── SCORE ÚLTIMA FATURA ─────────────────────────────────────── */
.score-label-badge { font-size:11px; font-weight:600; padding:3px 10px; border-radius:20px; display:inline-block; }

/* ── BOTÃO LIMPAR CHAT (no card de conversas) ────────────────── */
.btn-clear-chat { font-size:11px; color:var(--text-sub); background:none; border:none; cursor:pointer; padding:2px 6px; border-radius:4px; transition:color .15s; }
.btn-clear-chat:hover { color:var(--red); }
</style>

<script>
const PALETTE = ['#534AB7','#1D9E75','#D85A30','#BA7517','#D4537E','#378ADD','#639922','#A32D2D'];
const TEXT_MUTED = '#6B6B80';
const GRID_COLOR = 'rgba(255,255,255,0.05)';
const TT = { backgroundColor:'#1e1e28', titleColor:'#F0F0FA', bodyColor:'#6B6B80', borderColor:'rgba(255,255,255,0.08)', borderWidth:1, padding:10, cornerRadius:8 };

const catLabels = {{ cat_labels|safe }};
const catValues = {{ cat_values|safe }};

if (catLabels.length > 0) {
    const total = catValues.reduce((a,b) => a+b, 0);
    const legend = document.getElementById('cat-legend');
    catLabels.forEach((l, i) => {
        const el = document.createElement('span');
        el.style.cssText = 'display:flex;align-items:center;gap:5px;font-size:12px;color:#6B6B80;';
        el.innerHTML = `<span style="width:10px;height:10px;border-radius:2px;background:${PALETTE[i]};flex-shrink:0;"></span>${l} ${((catValues[i]/total)*100).toFixed(0)}%`;
        legend.appendChild(el);
    });

    new Chart(document.getElementById('catChart'), {
        type: 'doughnut',
        data: { labels: catLabels, datasets: [{ data: catValues, backgroundColor: PALETTE, borderWidth: 0, hoverOffset: 4, spacing: 2, borderRadius: 3 }] },
        options: {
            responsive: true, maintainAspectRatio: false, cutout: '68%',
            plugins: { legend: { display: false }, tooltip: { ...TT, callbacks: { label: ctx => ` ${ctx.label}: ${ctx.parsed.toFixed(2)} €` } } }
        }
    });
}

const lojaLabels = {{ loja_labels|safe }};
const lojaValues = {{ loja_values|safe }};

if (lojaLabels.length > 0) {
    const barH = Math.max(lojaLabels.length * 42 + 60, 200);
    document.querySelector('#lojaChart').parentElement.style.height = barH + 'px';

    new Chart(document.getElementById('lojaChart'), {
        type: 'bar',
        data: { labels: lojaLabels, datasets: [{ data: lojaValues, backgroundColor: PALETTE[0]+'30', borderColor: PALETTE[0], borderWidth: 1.5, borderRadius: 6, borderSkipped: false, hoverBackgroundColor: PALETTE[0]+'55' }] },
        options: {
            indexAxis: 'y', responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false }, tooltip: { ...TT, callbacks: { label: ctx => ` ${ctx.parsed.x.toFixed(2)} €` } } },
            scales: {
                x: { grid: { color: GRID_COLOR }, ticks: { color: TEXT_MUTED, font: { size:11, family:'Outfit' }, callback: v => v+'€' }, border: { display:false } },
                y: { grid: { display:false }, ticks: { color: TEXT_MUTED, font: { size:12, family:'Outfit' } }, border: { display:false } }
            }
        }
    });
}

const trendLabels = {{ trend_labels|safe }};
const trendValues = {{ trend_values|safe }};

if (trendLabels.length > 0) {
    new Chart(document.getElementById('trendChart'), {
        type: 'line',
        data: { labels: trendLabels, datasets: [{ data: trendValues, borderColor: PALETTE[0], borderWidth: 2, pointBackgroundColor: PALETTE[0], pointRadius: 4, pointHoverRadius: 6, fill: true, backgroundColor: function(ctx){ const g=ctx.chart.ctx.createLinearGradient(0,0,0,180); g.addColorStop(0,PALETTE[0]+'28'); g.addColorStop(1,PALETTE[0]+'00'); return g; }, tension: 0.4 }] },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display:false }, tooltip: { ...TT, callbacks: { label: ctx => ` ${ctx.parsed.y.toFixed(2)} €` } } },
            scales: {
                x: { grid: { display:false }, ticks: { color:TEXT_MUTED, font:{ size:11, family:'Outfit' } }, border: { display:false } },
                y: { grid: { color:GRID_COLOR }, ticks: { color:TEXT_MUTED, font:{ size:11, family:'Outfit' }, callback: v => v+'€' }, border: { display:false } }
            }
        }
    });
}
</script>

<script>
async function limparChat() {
    if (!confirm('Tens a certeza que queres apagar todo o histórico do chat?')) return;
    try {
        const r = await fetch('/chat/limpar', { method: 'POST', headers: {'Content-Type':'application/json'} });
        if ((await r.json()).success) {
            document.querySelector('.convo-list')?.remove();
            const body = document.querySelector('.card-body');
            if (body) body.innerHTML = '<div class="empty-card"><span>💬</span><p>Histórico apagado.</p></div>';
        }
    } catch(e) { alert('Erro ao limpar o chat.'); }
}
</script>
{% endblock %}
</file>

<file path="templates/faturas.html">
{% extends 'base.html' %}
{% block title %}Faturas · Verly{% endblock %}

{% block extra_head %}
<style>
/* ── Items chip ──────────────────────────────────────────── */
.items-chip { position:relative; display:inline-flex; align-items:center; gap:5px; background:var(--surface3); border:1px solid var(--border); border-radius:6px; padding:3px 10px; font-size:12px; color:var(--text-muted); cursor:default; }
.items-chip:hover { border-color:var(--border-hover); color:var(--text); }
.items-tooltip { display:none; position:absolute; bottom:calc(100% + 8px); left:50%; transform:translateX(-50%); background:var(--surface2); border:1px solid var(--border); border-radius:10px; padding:10px 14px; min-width:180px; max-width:260px; z-index:100; box-shadow:0 8px 32px rgba(0,0,0,0.5); }
.items-chip:hover .items-tooltip { display:block; }
.items-tooltip li { list-style:none; font-size:12px; color:var(--text); padding:3px 0; display:flex; align-items:center; gap:6px; }
.items-tooltip li::before { content:''; width:5px; height:5px; border-radius:50%; background:var(--brand); flex-shrink:0; }

.row-link { cursor:pointer; }
.row-link:hover td { background:rgba(74,58,255,0.04); }

/* ── Upload progress bar ─────────────────────────────────── */
.upload-progress-wrap {
    display: none;
    margin-top: 16px;
    animation: fadeIn 0.3s ease;
}
.upload-progress-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}
.upload-progress-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 8px;
}
.upload-spinner {
    width: 14px; height: 14px;
    border: 2px solid var(--border);
    border-top-color: var(--brand);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    flex-shrink: 0;
}
.upload-progress-pct {
    font-size: 12px;
    font-weight: 700;
    color: var(--brand-2);
}
.upload-progress-bar {
    height: 6px;
    background: var(--surface3);
    border-radius: 99px;
    overflow: hidden;
}
.upload-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--brand), var(--brand-2));
    border-radius: 99px;
    width: 0%;
    transition: width 0.4s cubic-bezier(.4,0,.2,1);
}
.upload-progress-steps {
    display: flex;
    gap: 20px;
    margin-top: 10px;
}
.upload-step {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    color: var(--text-sub);
    transition: color 0.3s;
}
.upload-step.active { color: var(--brand-2); font-weight: 600; }
.upload-step.done { color: var(--green); }
.upload-step-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--surface3);
    border: 1.5px solid var(--border);
    transition: all 0.3s;
    flex-shrink: 0;
}
.upload-step.active .upload-step-dot { background: var(--brand); border-color: var(--brand); box-shadow: 0 0 6px rgba(99,102,241,0.5); }
.upload-step.done .upload-step-dot { background: var(--green); border-color: var(--green); }

/* ── Upload result card ──────────────────────────────────── */
.upload-result-card {
    display: none;
    margin-top: 14px;
    padding: 14px 18px;
    border-radius: 10px;
    border: 1px solid;
    animation: slideUp 0.3s ease;
}
.upload-result-card.success { background: rgba(0,214,143,0.07); border-color: rgba(0,214,143,0.2); }
.upload-result-card.error   { background: rgba(244,63,94,0.07);  border-color: rgba(244,63,94,0.2); }
.upload-result-title {
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 6px;
}
.upload-result-card.success .upload-result-title { color: var(--green); }
.upload-result-card.error   .upload-result-title { color: var(--red); }
.upload-result-meta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}
.upload-result-chip {
    font-size: 11px;
    padding: 3px 9px;
    border-radius: 5px;
    background: var(--surface2);
    color: var(--text-muted);
    font-weight: 600;
}

/* ── Drop zone when file selected ───────────────────────── */
.upload-zone.has-file {
    border-color: var(--brand);
    background: var(--brand-light);
}
.upload-zone.uploading {
    pointer-events: none;
    opacity: 0.7;
}

/* ── Beautiful empty state ───────────────────────────────── */
.empty-faturas {
    padding: 64px 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
}
.empty-faturas-icon {
    width: 72px; height: 72px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
}
.empty-faturas-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 18px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.4px;
}
.empty-faturas-sub {
    font-size: 13px;
    color: var(--text-muted);
    max-width: 280px;
    line-height: 1.7;
}
.empty-faturas-actions {
    display: flex;
    gap: 10px;
    margin-top: 8px;
}
.empty-faturas-hint {
    margin-top: 20px;
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 12px;
    max-width: 480px;
}
.empty-hint-card {
    padding: 14px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-align: left;
}
.empty-hint-icon { font-size: 18px; margin-bottom: 6px; }
.empty-hint-title { font-size: 12px; font-weight: 700; color: var(--text); margin-bottom: 3px; }
.empty-hint-desc  { font-size: 11px; color: var(--text-muted); line-height: 1.5; }

/* ── Entry animations ────────────────────────────────────── */
@keyframes fadeIn   { from { opacity:0; }                       to { opacity:1; } }
@keyframes slideUp  { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }
@keyframes spin     { to { transform:rotate(360deg); } }

.page-header        { animation: slideUp 0.35s ease both; }
.card:nth-child(1)  { animation: slideUp 0.40s 0.05s ease both; }
.card:nth-child(2)  { animation: slideUp 0.40s 0.10s ease both; }
.card:nth-child(3)  { animation: slideUp 0.40s 0.15s ease both; }

/* filtros form */
.filtros-form {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
