<file path="templates/chat.html">
{% extends 'base.html' %}
{% block title %}Assistente IA · Verly{% endblock %}

{% block content %}
<div class="chat-page">
    <div class="chat-topbar">
        <div class="chat-topbar-left">
            <div class="status-dot"></div>
            <h1>Assistente Verly</h1>
        </div>
        <button class="btn-ghost" onclick="clearChat()">Limpar histórico</button>
    </div>

    <div id="messages" class="messages-area">
        {% if conversas %}
            {% for c in conversas %}
            <div class="msg user">
                <div class="msg-avatar">{{ current_user.nome[0].upper() }}</div>
                <div class="msg-bubble">{{ c.pergunta }}</div>
            </div>
            <div class="msg bot">
                <div class="msg-avatar">✦</div>
                <div class="msg-bubble">{{ c.resposta }}</div>
            </div>
            {% endfor %}
        {% else %}
        <div class="empty-chat" id="emptyChat">
            <div class="empty-chat-icon">✦</div>
            <h3>Assistente Verly</h3>
            <p>Faz perguntas sobre as tuas faturas, garantias ou gastos. Primeiro carrega uma fatura em <a href="{{ url_for('faturas.faturas') }}">Faturas</a>.</p>
        </div>
        {% endif %}
    </div>

    <div class="chat-input-area">
        <textarea id="userInput" placeholder="Pergunta algo sobre as tuas faturas..."
            onkeydown="handleKey(event)" oninput="autoResize(this)" rows="1"></textarea>
        <button class="btn-send" id="btnSend" onclick="sendMessage()">↑</button>
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
let emptyRemoved = {{ 'false' if not conversas else 'true' }};
window.addEventListener('load', () => { const m = document.getElementById('messages'); m.scrollTop = m.scrollHeight; });

function removeEmpty() {
    if (!emptyRemoved) { const el = document.getElementById('emptyChat'); if (el) el.remove(); emptyRemoved = true; }
}
function addMsg(role, text, avatar) {
    removeEmpty();
    const m = document.getElementById('messages');
    const d = document.createElement('div');
    d.className = 'msg ' + role;
    d.innerHTML = `<div class="msg-avatar">${avatar}</div><div class="msg-bubble">${text}</div>`;
    m.appendChild(d); m.scrollTop = m.scrollHeight;
}
function showTyping() {
    removeEmpty();
    const m = document.getElementById('messages');
    const d = document.createElement('div');
    d.className = 'msg bot'; d.id = 'typing';
    d.innerHTML = `<div class="msg-avatar">✦</div><div class="typing-indicator"><span></span><span></span><span></span></div>`;
    m.appendChild(d); m.scrollTop = m.scrollHeight;
}
function removeTyping() { const t = document.getElementById('typing'); if (t) t.remove(); }

async function sendMessage() {
    const input = document.getElementById('userInput');
    const btn = document.getElementById('btnSend');
    const text = input.value.trim();
    if (!text) return;
    addMsg('user', text, '{{ current_user.nome[0].upper() }}');
    input.value = ''; input.style.height = 'auto'; btn.disabled = true;
    showTyping();
    try {
        const res = await fetch('/chat/send', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({message: text}) });
        const data = await res.json();
        removeTyping(); addMsg('bot', data.response, '✦');
    } catch(e) { removeTyping(); addMsg('bot', 'Erro de ligação.', '✦'); }
    btn.disabled = false;
}
async function clearChat() {
    if (!confirm('Apagar todo o histórico?')) return;
    await fetch('/chat/clear', {method:'POST'});
    location.reload();
}
function handleKey(e) { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); } }
function autoResize(el) { el.style.height = 'auto'; el.style.height = Math.min(el.scrollHeight, 120) + 'px'; }
</script>
{% endblock %}
</file>

<file path="templates/dashboard.html">
{% extends 'base.html' %}
{% block title %}Dashboard · Verly{% endblock %}
{% block extra_head %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-sub">Olá, {{ current_user.nome }}. Aqui está o teu resumo financeiro.</p>
    </div>
    <div style="display:flex;gap:10px;">
        <a href="{{ url_for('exportar.exportar_pdf') }}" class="btn-ghost">⬇ Exportar PDF</a>
        <a href="{{ url_for('faturas.faturas') }}" class="btn-accent">+ Nova Fatura</a>
    </div>
</div>

<!-- ALERTAS -->
{% if alertas %}
<div class="alertas-section">
    {% for a in alertas %}
    <div class="alerta alerta-{{ a.urgencia }}">
        <span class="alerta-icon">{% if a.tipo == 'devolucao' %}↩{% else %}🛡{% endif %}</span>
        <div class="alerta-body">
            <strong>{% if a.tipo == 'devolucao' %}Devolução expira{% else %}Garantia expira{% endif %} em {{ a.dias }} dia(s)</strong>
            <span>{{ a.loja }} · {{ a.fatura }} · até {{ a.data }}</span>
        </div>
        <span class="alerta-badge">{{ a.tipo|upper }}</span>
    </div>
    {% endfor %}
</div>
{% endif %}

<!-- MÉTRICAS -->
<div class="metrics-grid">
