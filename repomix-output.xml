{% block extra_scripts %}
<script>
let selectedFile = null;

/* ── Navigation ───────────────────────────────────────────── */
function goToDetail(e, id) {
    window.location.href = '/faturas/' + id;
}

/* ── File select ──────────────────────────────────────────── */
function handleFileSelect(input) {
    selectedFile = input.files[0];
    if (!selectedFile) return;

    const zone = document.getElementById('uploadZone');
    zone.classList.add('has-file');
    document.getElementById('uploadLabel').textContent = selectedFile.name;
    document.getElementById('uploadSub').textContent =
        (selectedFile.size / 1024).toFixed(1) + ' KB · pronto para analisar';
    document.getElementById('btnUpload').style.display = 'block';

    // Reset result card if re-selecting
    const res = document.getElementById('uploadResult');
    res.style.display = 'none';
    res.className = 'upload-result-card';
}

/* ── Drag & drop ──────────────────────────────────────────── */
const zone = document.getElementById('uploadZone');
zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-over'); });
zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
zone.addEventListener('drop', e => {
    e.preventDefault();
    zone.classList.remove('drag-over');
    const file = e.dataTransfer.files[0];
    if (file) {
        selectedFile = file;
        zone.classList.add('has-file');
        document.getElementById('uploadLabel').textContent = file.name;
        document.getElementById('uploadSub').textContent = (file.size / 1024).toFixed(1) + ' KB · pronto para analisar';
        document.getElementById('btnUpload').style.display = 'block';
    }
});

/* ── Progress helpers ─────────────────────────────────────── */
function setProgress(pct, label) {
    document.getElementById('progressFill').style.width = pct + '%';
    document.getElementById('progressPct').textContent = pct + '%';
    if (label) document.getElementById('progressLabel').textContent = label;
}

function setStep(active) {
    // active: 1, 2 or 3
    ['step1','step2','step3'].forEach((id, i) => {
        const el = document.getElementById(id);
        el.className = 'upload-step';
        if (i + 1 < active)   el.classList.add('done');
        if (i + 1 === active) el.classList.add('active');
    });
}

function showProgress(show) {
    document.getElementById('uploadProgress').style.display = show ? 'block' : 'none';
}

/* ── Main upload ──────────────────────────────────────────── */
async function uploadFile() {
    if (!selectedFile) return;

    const btn  = document.getElementById('btnUpload');
    const zone = document.getElementById('uploadZone');

    // Prepare UI
    btn.style.display = 'none';
    zone.classList.add('uploading');
    document.getElementById('uploadResult').style.display = 'none';
    showProgress(true);

    // Step 1 — Sending
    setStep(1);
    setProgress(10, 'A enviar ficheiro...');

    const formData = new FormData();
    formData.append('file', selectedFile);

    // Simulate step progression while waiting (IA can take 5-15s)
    const progressInterval = simulateProgress();

    try {
        const res  = await fetch('/faturas/upload', { method: 'POST', body: formData });
        clearInterval(progressInterval);

        const data = await res.json();

        if (data.success) {
            // Step 3 — Done
            setStep(3);
            setProgress(100, 'Concluído!');

            setTimeout(() => {
                showProgress(false);
                showResult(true, data);
                zone.classList.remove('uploading');

                // Reload after 2s so the new row appears
                setTimeout(() => location.reload(), 2000);
            }, 500);

        } else {
            clearInterval(progressInterval);
            setProgress(100, 'Erro');
            setTimeout(() => {
                showProgress(false);
                showResult(false, data);
                zone.classList.remove('uploading');
                btn.style.display = 'block';
            }, 300);
        }

    } catch(e) {
        clearInterval(progressInterval);
        showProgress(false);
        showResult(false, { message: 'Erro de ligação. Verifica a tua rede.' });
        zone.classList.remove('uploading');
        btn.style.display = 'block';
    }
}

/* ── Simulate progress (IA takes time) ───────────────────── */
function simulateProgress() {
    let pct = 10;
    return setInterval(() => {
        if (pct < 30) {
            pct += 5;
            setStep(1);
            setProgress(pct, 'A enviar ficheiro...');
        } else if (pct < 70) {
            if (pct === 30) setStep(2);
            pct += 2;
            setProgress(pct, 'A extrair dados com IA...');
        } else if (pct < 88) {
            pct += 1;
            setProgress(pct, 'A categorizar e calcular garantias...');
        }
        // Stop at 88 — real response sets 100
    }, 300);
}

/* ── Show result card ─────────────────────────────────────── */
function showResult(ok, data) {
    setStep(ok ? 4 : 0);
    const card = document.getElementById('uploadResult');
    card.className = 'upload-result-card ' + (ok ? 'success' : 'error');
    document.getElementById('resultTitle').textContent =
        ok ? '✓ Fatura analisada com sucesso!' : '✗ ' + (data.message || 'Erro desconhecido');

    const meta = document.getElementById('resultMeta');
    if (ok && data.loja) {
        meta.innerHTML = `
            <span class="upload-result-chip">🏪 ${data.loja}</span>
            ${data.total ? `<span class="upload-result-chip">💰 ${parseFloat(data.total).toFixed(2)} €</span>` : ''}
            ${data.categoria ? `<span class="upload-result-chip">🏷 ${data.categoria}</span>` : ''}
            <span class="upload-result-chip" style="color:var(--green)">A recarregar...</span>
        `;
    } else {
        meta.innerHTML = '';
    }
    card.style.display = 'block';
}

/* ── Edit category ────────────────────────────────────────── */
async function editarCategoria(id, valor) {
    await fetch(`/faturas/editar/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ categoria: valor })
    });
}

/* ── Delete fatura ────────────────────────────────────────── */
async function deleteFatura(id) {
    if (!confirm('Remover esta fatura?')) return;
    const res  = await fetch(`/faturas/delete/${id}`, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) {
        const row = document.getElementById('row-' + id);
        row.style.transition = 'opacity 0.3s, transform 0.3s';
        row.style.opacity = '0';
        row.style.transform = 'translateX(-8px)';
        setTimeout(() => row.remove(), 300);
    }
}
</script>
{% endblock %}
</file>

