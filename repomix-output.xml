        </div>

        <!-- Barra de ações: sino + theme toggle -->
        <div class="sidenav-actions">
            <!-- Notification bell -->
            <div class="notif-bell-wrap" id="notifWrap">
                <button class="notif-bell" id="notifBell" title="Notificações"
                        onclick="toggleNotifPanel(event)">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                    <span class="notif-badge" id="notifBadge"></span>
                </button>

                <!-- Panel -->
                <div class="notif-panel" id="notifPanel">
                    <div class="notif-panel-header">
                        <span class="notif-panel-title">Notificações</span>
                        <span class="notif-panel-count" id="notifCount">—</span>
                    </div>
                    <div class="notif-list" id="notifList">
                        <div class="notif-empty">
                            <div class="notif-empty-icon">🔔</div>
                            A carregar...
                        </div>
                    </div>
                </div>
            </div>

            <button class="theme-toggle" id="themeToggle" title="Alternar modo claro/escuro" aria-label="Toggle theme">
                <svg id="themeIcon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"/>
                    <line x1="12" y1="1"  x2="12" y2="3"/>
                    <line x1="12" y1="21" x2="12" y2="23"/>
                    <line x1="4.22" y1="4.22"   x2="5.64" y2="5.64"/>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                    <line x1="1" y1="12"  x2="3" y2="12"/>
                    <line x1="21" y1="12" x2="23" y2="12"/>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                    <line x1="18.36" y1="5.64"  x2="19.78" y2="4.22"/>
                </svg>
            </button>
        </div>

        <!-- Zona com scroll -->
        <div class="sidenav-scroll">

            <!-- PRINCIPAL -->
            <span class="sidenav-section">Principal</span>
            <ul class="sidenav-menu">
                <li>
                    <a href="{{ url_for('dashboard.dashboard') }}"
                       class="nav-link {% if request.endpoint == 'dashboard.dashboard' %}active{% endif %}"
                       data-tooltip="Dashboard">
                        <span class="nav-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="7" height="7" rx="1"/>
                                <rect x="14" y="3" width="7" height="7" rx="1"/>
                                <rect x="3" y="14" width="7" height="7" rx="1"/>
                                <rect x="14" y="14" width="7" height="7" rx="1"/>
                            </svg>
                        </span>
                        <span class="nav-label">Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="{{ url_for('faturas.faturas') }}"
                       class="nav-link {% if request.endpoint and 'faturas' in request.endpoint %}active{% endif %}"
                       data-tooltip="Faturas">
                        <span class="nav-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                                <line x1="16" y1="13" x2="8" y2="13"/>
                                <line x1="16" y1="17" x2="8" y2="17"/>
                                <line x1="10" y1="9"  x2="8" y2="9"/>
                            </svg>
                        </span>
                        <span class="nav-label">Faturas</span>
                    </a>
                </li>
                <li>
                    <a href="{{ url_for('chat.chat') }}"
                       class="nav-link {% if request.endpoint == 'chat.chat' %}active{% endif %}"
                       data-tooltip="Assistente IA">
                        <span class="nav-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
