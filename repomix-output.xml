<file path="templates/fatura_detalhe.html">
{% extends 'base.html' %}
{% block title %}{{ fatura.loja or fatura.nome_ficheiro }} · Verly{% endblock %}

{% block content %}
<div class="page-header">
    <div style="display:flex;align-items:center;gap:14px;">
        <a href="{{ url_for('faturas.faturas') }}" style="display:flex;align-items:center;gap:6px;color:var(--text-muted);font-size:13px;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--text-muted)'">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 5 5 12 12 19"/></svg>
            Faturas
        </a>
        <span style="color:var(--border);">/</span>
        <h1 class="page-title" style="margin:0;">{{ fatura.loja or fatura.nome_ficheiro }}</h1>
    </div>
    <div style="display:flex;gap:10px;">
        <button id="btnSave" onclick="saveAll()" class="btn-accent" style="display:none;">Guardar alterações</button>
        <button onclick="confirmDelete()" style="background:transparent;border:1px solid rgba(255,71,87,0.3);color:var(--red);padding:9px 18px;border-radius:10px;font-size:13px;font-weight:500;cursor:pointer;font-family:'Outfit',sans-serif;transition:all 0.2s;" onmouseover="this.style.background='rgba(255,71,87,0.1)'" onmouseout="this.style.background='transparent'">Eliminar</button>
    </div>
</div>

<div style="display:grid;grid-template-columns:1fr 360px;gap:20px;">
    <!-- Coluna principal -->
    <div style="display:flex;flex-direction:column;gap:20px;">

        <!-- Info principal -->
        <div class="card">
            <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
                <h3>Informação da Fatura</h3>
                <span style="font-size:11px;color:var(--text-muted);">Clica em qualquer campo para editar</span>
            </div>
            <div class="card-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">

                    <div class="detail-field">
                        <label>Loja / Fornecedor</label>
                        <div class="editable-field" data-field="loja" contenteditable="true" oninput="markDirty()">{{ fatura.loja or '' }}</div>
                    </div>

                    <div class="detail-field">
                        <label>Total Pago</label>
                        <div style="display:flex;align-items:center;gap:8px;">
                            <div class="editable-field" data-field="total" contenteditable="true" oninput="markDirty()" style="font-size:22px;font-weight:700;color:var(--text);">{{ "%.2f"|format(fatura.total or 0) }}</div>
                            <span style="color:var(--text-muted);font-size:16px;">€</span>
                        </div>
                    </div>

                    <div class="detail-field">
                        <label>Data de Compra</label>
                        <div class="editable-field" data-field="data_compra" contenteditable="true" oninput="markDirty()">{{ fatura.data_compra or '' }}</div>
                    </div>

                    <div class="detail-field">
                        <label>Categoria</label>
                        <select id="catSelect" onchange="markDirty()" style="background:var(--surface2);border:1.5px solid transparent;color:var(--text);padding:10px 12px;border-radius:10px;font-size:14px;font-family:'Outfit',sans-serif;outline:none;cursor:pointer;width:100%;transition:border-color 0.2s;" onfocus="this.style.borderColor='var(--brand)'" onblur="this.style.borderColor='transparent'">
                            {% for cat in categorias %}
                            <option value="{{ cat }}" {% if cat == fatura.categoria %}selected{% endif %}>{{ cat }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Items -->
        <div class="card">
            <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
                <h3>Items / Produtos</h3>
                <button onclick="addItem()" style="background:transparent;border:1px solid var(--border);color:var(--text-muted);padding:6px 14px;border-radius:8px;font-size:12px;cursor:pointer;font-family:'Outfit',sans-serif;transition:all 0.2s;" onmouseover="this.style.borderColor='var(--brand)';this.style.color='var(--brand)'" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-muted)'">+ Adicionar item</button>
            </div>
            <div class="card-body" style="padding:16px 24px;">
                <div id="itemsList">
                    {% if items_list %}
                        {% for item in items_list %}
                        <div class="item-row" style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border);">
                            <div style="width:6px;height:6px;border-radius:50%;background:var(--brand);flex-shrink:0;margin-top:1px;"></div>
                            <div class="editable-field item-field" contenteditable="true" oninput="markDirty()" style="flex:1;padding:6px 10px;">{{ item }}</div>
                            <button onclick="removeItem(this)" style="background:transparent;border:none;color:var(--text-sub);cursor:pointer;padding:4px;display:flex;align-items:center;transition:color 0.2s;" onmouseover="this.style.color='var(--red)'" onmouseout="this.style.color='var(--text-sub)'">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            </button>
                        </div>
                        {% endfor %}
                    {% else %}
                    <div id="emptyItems" style="text-align:center;padding:28px;color:var(--text-muted);font-size:13px;">
                        Sem items registados. Adiciona manualmente ou faz re-upload com um ficheiro mais detalhado.
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Notas -->
        <div class="card">
            <div class="card-header"><h3>Notas</h3></div>
            <div class="card-body">
                <textarea id="notasField" placeholder="Adiciona notas sobre esta compra..." oninput="markDirty()" style="width:100%;min-height:100px;background:var(--surface2);border:1.5px solid transparent;color:var(--text);padding:14px;border-radius:10px;font-size:14px;font-family:'Outfit',sans-serif;outline:none;resize:vertical;line-height:1.6;transition:border-color 0.2s;" onfocus="this.style.borderColor='var(--brand)'" onblur="this.style.borderColor='transparent'">{{ fatura.notas or '' }}</textarea>
            </div>
        </div>
    </div>

    <!-- Coluna lateral -->
    <div style="display:flex;flex-direction:column;gap:20px;">

        <!-- Garantia & Devolução -->
        <div class="card">
            <div class="card-header"><h3>Prazos</h3></div>
            <div class="card-body" style="display:flex;flex-direction:column;gap:16px;">

                <div class="detail-field">
                    <label style="display:flex;align-items:center;gap:6px;">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        Garantia até
                    </label>
                    <div class="editable-field" data-field="data_garantia" contenteditable="true" oninput="markDirty()" placeholder="dd/mm/aaaa">{{ fatura.data_garantia or '' }}</div>
                </div>

                <div class="detail-field">
                    <label style="display:flex;align-items:center;gap:6px;">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--yellow)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.95"/></svg>
                        Devolução até
                    </label>
                    <div class="editable-field" data-field="data_devolucao" contenteditable="true" oninput="markDirty()" placeholder="dd/mm/aaaa">{{ fatura.data_devolucao or '' }}</div>
                </div>
            </div>
        </div>

        <!-- Meta desta categoria -->
        <div class="card" id="metaCard" style="display:none;">
            <div class="card-header"><h3>Meta da Categoria</h3></div>
            <div class="card-body" id="metaCardBody"></div>
        </div>

        <!-- Metadados -->
        <div class="card">
            <div class="card-header"><h3>Detalhes do Ficheiro</h3></div>
            <div class="card-body" style="display:flex;flex-direction:column;gap:12px;">
                <div>
                    <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">Ficheiro</div>
                    <div style="font-size:13px;color:var(--text);word-break:break-all;">{{ fatura.nome_ficheiro }}</div>
                </div>
                <div>
                    <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">Carregado em</div>
                    <div style="font-size:13px;color:var(--text);">{{ fatura.data_upload.strftime('%d/%m/%Y %H:%M') }}</div>
                </div>
                <div>
                    <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">ID</div>
                    <div style="font-size:13px;color:var(--text-muted);">#{{ fatura.id }}</div>
                </div>
            </div>
        </div>

        <!-- Ações rápidas -->
        <div class="card">
            <div class="card-header"><h3>Ações Rápidas</h3></div>
            <div class="card-body" style="display:flex;flex-direction:column;gap:8px;">
                <a href="{{ url_for('chat.chat') }}" style="display:flex;align-items:center;gap:10px;padding:12px;background:var(--surface2);border-radius:10px;border:1px solid var(--border);text-decoration:none;color:var(--text);transition:all 0.2s;font-size:13px;" onmouseover="this.style.borderColor='var(--brand)'" onmouseout="this.style.borderColor='var(--border)'">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--brand-2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    Perguntar à Verly sobre esta compra
                </a>
                <a href="{{ url_for('scoring.analisar') }}" style="display:flex;align-items:center;gap:10px;padding:12px;background:var(--surface2);border-radius:10px;border:1px solid var(--border);text-decoration:none;color:var(--text);transition:all 0.2s;font-size:13px;" onmouseover="this.style.borderColor='var(--brand)'" onmouseout="this.style.borderColor='var(--border)'">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--yellow)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    Avaliar score desta compra
                </a>
            </div>
        </div>
    </div>
</div>

<style>
.detail-field { display:flex;flex-direction:column;gap:6px; }
.detail-field label { font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px; }
.editable-field { background:var(--surface2);border:1.5px solid transparent;color:var(--text);padding:10px 12px;border-radius:10px;font-size:14px;font-family:'Outfit',sans-serif;outline:none;min-height:42px;line-height:1.4;cursor:text;transition:border-color 0.2s; }
.editable-field:focus { border-color:var(--brand); }
.editable-field:empty:before { content:attr(placeholder);color:var(--text-sub); }
</style>
{% endblock %}

{% block extra_scripts %}
<script>
let isDirty = false;

function markDirty() {
    isDirty = true;
    document.getElementById('btnSave').style.display = 'inline-flex';
}

function addItem() {
    const empty = document.getElementById('emptyItems');
    if (empty) empty.remove();
    const list = document.getElementById('itemsList');
    const row = document.createElement('div');
    row.className = 'item-row';
    row.style.cssText = 'display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border);';
    row.innerHTML = `
        <div style="width:6px;height:6px;border-radius:50%;background:var(--brand);flex-shrink:0;"></div>
        <div class="editable-field item-field" contenteditable="true" oninput="markDirty()" style="flex:1;padding:6px 10px;" placeholder="Descreve o item..."></div>
        <button onclick="removeItem(this)" style="background:transparent;border:none;color:var(--text-sub);cursor:pointer;padding:4px;display:flex;align-items:center;transition:color 0.2s;" onmouseover="this.style.color='var(--red)'" onmouseout="this.style.color='var(--text-sub)'">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>`;
    list.appendChild(row);
    row.querySelector('.item-field').focus();
    markDirty();
}

function removeItem(btn) {
    btn.closest('.item-row').remove();
    markDirty();
}

async function saveAll() {
    const btn = document.getElementById('btnSave');
    btn.textContent = 'A guardar...';
    btn.disabled = true;

    const fields = {};
    document.querySelectorAll('.editable-field[data-field]').forEach(el => {
        fields[el.dataset.field] = el.textContent.trim();
    });

    fields['categoria'] = document.getElementById('catSelect').value;
    fields['notas'] = document.getElementById('notasField').value;

    // Items
    const items = [];
    document.querySelectorAll('.item-field').forEach(el => {
        const t = el.textContent.trim();
        if (t) items.push(t);
    });
    fields['items'] = items;

    const res = await fetch(window.location.pathname + '/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(fields)
    });
    const data = await res.json();

    if (data.success) {
        btn.textContent = 'Guardado';
        btn.style.background = 'var(--green)';
        isDirty = false;
        setTimeout(() => {
            btn.textContent = 'Guardar alterações';
            btn.style.background = '';
            btn.disabled = false;
            btn.style.display = 'none';
        }, 2000);
    } else {
        btn.textContent = 'Erro — tenta novamente';
        btn.disabled = false;
    }
}

async function confirmDelete() {
    if (!confirm('Eliminar esta fatura permanentemente?')) return;
    const res = await fetch('/faturas/{{ fatura.id }}/delete', { method: 'POST' });
    const data = await res.json();
    if (data.success) window.location.href = '/faturas';
}

// Warn before leaving with unsaved changes
window.addEventListener('beforeunload', e => {
    if (isDirty) { e.preventDefault(); e.returnValue = ''; }
});
</script>
{% endblock %}
</file>

<file path="templates/metas.html">
{% extends 'base.html' %}
{% block title %}Metas · Verly{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1 class="page-title">Metas de Poupança</h1>
        <p class="page-sub">{{ mes_atual }} · {{ "%.2f"|format(total_gasto) }} € gastos de {{ "%.2f"|format(total_orcado) }} € orçamentados</p>
    </div>
    <button class="btn-accent" onclick="openAddMeta()">+ Nova Meta</button>
</div>

{% if metas %}
<!-- Barra de progresso global -->
{% set pct_global = [(total_gasto / total_orcado * 100)|round|int, 100]|min if total_orcado > 0 else 0 %}
<div class="card" style="margin-bottom:24px;">
    <div class="card-body" style="padding:20px 24px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
            <span style="font-weight:600;font-size:14px;">Orçamento Global do Mês</span>
            <span style="font-size:13px;color:var(--text-muted);">{{ "%.2f"|format(total_gasto) }} € / {{ "%.2f"|format(total_orcado) }} €</span>
        </div>
        <div style="background:var(--surface3);border-radius:100px;height:10px;overflow:hidden;">
            <div style="height:100%;width:{{ pct_global }}%;border-radius:100px;background:{% if pct_global > 90 %}var(--red){% elif pct_global > 70 %}var(--yellow){% else %}var(--brand){% endif %};transition:width 0.6s ease;"></div>
        </div>
        <div style="display:flex;justify-content:space-between;margin-top:8px;">
            <span style="font-size:12px;color:var(--text-muted);">{{ pct_global }}% utilizado</span>
            <span style="font-size:12px;color:var(--green);">{{ "%.2f"|format([total_orcado - total_gasto, 0]|max) }} € disponíveis</span>
        </div>
    </div>
</div>

<!-- Grid de metas -->
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;margin-bottom:24px;">
    {% for m in metas %}
    <div class="card meta-card" data-id="{{ m.id }}">
        <div class="card-body" style="padding:22px 24px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
                <div>
                    <div style="font-size:12px;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">{{ m.categoria }}</div>
                    <div style="font-size:22px;font-weight:700;color:{% if m.ultrapassou %}var(--red){% else %}var(--text){% endif %};">{{ "%.2f"|format(m.gasto) }} €</div>
                </div>
                <div style="text-align:right;">
                    <div style="font-size:12px;color:var(--text-muted);margin-bottom:4px;">de {{ "%.0f"|format(m.limite) }} €</div>
                    {% if m.ultrapassou %}
                    <div style="font-size:11px;font-weight:700;color:var(--red);background:rgba(255,71,87,0.12);padding:3px 8px;border-radius:6px;">ULTRAPASSADO</div>
                    {% else %}
                    <div style="font-size:11px;font-weight:700;color:var(--green);background:rgba(0,214,143,0.1);padding:3px 8px;border-radius:6px;">{{ "%.2f"|format(m.sobra) }} € livres</div>
                    {% endif %}
                </div>
            </div>
            <!-- Progress bar -->
            <div style="background:var(--surface3);border-radius:100px;height:6px;overflow:hidden;margin-bottom:14px;">
                <div style="height:100%;width:{{ m.pct }}%;border-radius:100px;background:{% if m.ultrapassou %}var(--red){% elif m.pct > 80 %}var(--yellow){% else %}var(--brand){% endif %};transition:width 0.6s ease;"></div>
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;">
                <span style="font-size:12px;color:var(--text-muted);">{{ m.pct }}% utilizado</span>
                <div style="display:flex;gap:8px;">
                    <button onclick="editMeta({{ m.id }}, '{{ m.categoria }}', {{ m.limite }})" style="background:transparent;border:1px solid var(--border);color:var(--text-muted);padding:5px 12px;border-radius:6px;font-size:12px;cursor:pointer;transition:all 0.2s;font-family:'Outfit',sans-serif;" onmouseover="this.style.borderColor='var(--border-hover)';this.style.color='var(--text)'" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-muted)'">Editar</button>
                    <button onclick="deleteMeta({{ m.id }})" style="background:transparent;border:1px solid var(--border);color:var(--text-muted);padding:5px 12px;border-radius:6px;font-size:12px;cursor:pointer;transition:all 0.2s;font-family:'Outfit',sans-serif;" onmouseover="this.style.borderColor='var(--red)';this.style.color='var(--red)'" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-muted)'">Remover</button>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% else %}
<div class="card" style="margin-bottom:24px;">
    <div class="card-body" style="padding:60px;text-align:center;">
        <div style="width:56px;height:56px;background:var(--surface2);border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <h3 style="font-size:16px;font-weight:600;margin-bottom:8px;">Sem metas definidas</h3>
        <p style="color:var(--text-muted);font-size:14px;margin-bottom:20px;">Define um orçamento por categoria e controla os teus gastos em tempo real.</p>
        <button class="btn-accent" onclick="openAddMeta()">Criar primeira meta</button>
    </div>
</div>
{% endif %}

{% if sem_meta %}
<div class="card">
    <div class="card-header"><h3>Categorias sem meta</h3></div>
    <div class="card-body" style="padding:0;">
        <table class="data-table">
            <thead>
                <tr><th>Categoria</th><th>Gasto este mês</th><th></th></tr>
            </thead>
            <tbody>
                {% for s in sem_meta %}
                <tr>
                    <td style="font-weight:500;">{{ s.categoria }}</td>
                    <td style="color:var(--yellow);font-weight:600;">{{ "%.2f"|format(s.gasto) }} €</td>
                    <td><button onclick="openAddMetaFor('{{ s.categoria }}')" style="background:transparent;border:1px solid var(--border);color:var(--text-muted);padding:5px 14px;border-radius:6px;font-size:12px;cursor:pointer;font-family:'Outfit',sans-serif;">Definir meta</button></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

<!-- Modal Add/Edit Meta -->
<div id="metaModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:1000;display:none;align-items:center;justify-content:center;">
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:36px;width:420px;max-width:90vw;animation:fadeUp 0.25s ease;">
        <h2 style="font-size:18px;font-weight:700;margin-bottom:6px;" id="modalTitle">Nova Meta</h2>
        <p style="color:var(--text-muted);font-size:13px;margin-bottom:28px;">Define o limite de gastos mensais para esta categoria.</p>

        <div style="margin-bottom:16px;">
            <label style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;display:block;margin-bottom:8px;">Categoria</label>
            <select id="metaCat" style="width:100%;background:var(--surface2);border:1.5px solid var(--border);color:var(--text);padding:12px 14px;border-radius:10px;font-size:14px;font-family:'Outfit',sans-serif;outline:none;">
                {% for cat in categorias %}
                <option value="{{ cat }}">{{ cat }}</option>
                {% endfor %}
            </select>
        </div>
        <div style="margin-bottom:28px;">
            <label style="font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.5px;display:block;margin-bottom:8px;">Limite Mensal (€)</label>
            <input type="number" id="metaValor" placeholder="ex: 150" min="1" step="5" style="width:100%;background:var(--surface2);border:1.5px solid var(--border);color:var(--text);padding:12px 14px;border-radius:10px;font-size:15px;font-weight:600;font-family:'Outfit',sans-serif;outline:none;">
        </div>
        <div style="display:flex;gap:12px;justify-content:flex-end;">
            <button onclick="closeModal()" style="background:transparent;border:1.5px solid var(--border);color:var(--text-muted);padding:11px 20px;border-radius:10px;font-family:'Outfit',sans-serif;font-size:14px;cursor:pointer;">Cancelar</button>
            <button onclick="saveMeta()" class="btn-accent">Guardar</button>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
let editingMetaId = null;

function openAddMeta() { editingMetaId = null; document.getElementById('modalTitle').textContent = 'Nova Meta'; document.getElementById('metaValor').value = ''; showModal(); }
function openAddMetaFor(cat) { editingMetaId = null; document.getElementById('modalTitle').textContent = 'Nova Meta — ' + cat; document.getElementById('metaCat').value = cat; document.getElementById('metaValor').value = ''; showModal(); }
function editMeta(id, cat, val) { editingMetaId = id; document.getElementById('modalTitle').textContent = 'Editar Meta'; document.getElementById('metaCat').value = cat; document.getElementById('metaValor').value = val; showModal(); }
function showModal() { document.getElementById('metaModal').style.display = 'flex'; }
function closeModal() { document.getElementById('metaModal').style.display = 'none'; }

async function saveMeta() {
    const cat = document.getElementById('metaCat').value;
    const val = parseFloat(document.getElementById('metaValor').value);
    if (!val || val <= 0) { alert('Insere um valor válido.'); return; }

    const res = await fetch('/metas/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ categoria: cat, valor: val })
    });
    const data = await res.json();
    if (data.success) location.reload();
}

async function deleteMeta(id) {
    if (!confirm('Remover esta meta?')) return;
    const res = await fetch('/metas/delete/' + id, { method: 'POST' });
    const data = await res.json();
    if (data.success) location.reload();
}

// Close modal on backdrop click
document.getElementById('metaModal').addEventListener('click', function(e) {
    if (e.target === this) closeModal();
});
</script>
{% endblock %}
</file>

<file path="templates/onboarding.html">
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bem-vindo à Verly</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Sora:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <style>
        body { background: var(--bg); display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 20px; }

        .ob-wrap { width: 100%; max-width: 680px; }

        /* Progress */
        .ob-progress { display: flex; align-items: center; gap: 0; margin-bottom: 40px; }
        .ob-step { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.5px; text-transform: uppercase; }
        .ob-step.active { color: var(--text); }
        .ob-step.done { color: var(--green); }
        .ob-step-num { width: 28px; height: 28px; border-radius: 50%; background: var(--surface2); border: 1.5px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; transition: all 0.3s; flex-shrink: 0; }
        .ob-step.active .ob-step-num { background: var(--brand); border-color: var(--brand); color: #fff; box-shadow: 0 0 16px rgba(74,58,255,0.4); }
        .ob-step.done .ob-step-num { background: var(--green); border-color: var(--green); color: #fff; }
        .ob-line { flex: 1; height: 1px; background: var(--border); margin: 0 12px; }
        .ob-line.done { background: var(--green); }

        /* Card */
        .ob-card { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 48px; animation: fadeUp 0.4s ease; }
        @keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

        .ob-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--brand-2); margin-bottom: 12px; }
        .ob-title { font-family: 'Sora', sans-serif; font-size: 28px; font-weight: 700; color: var(--text); margin-bottom: 10px; line-height: 1.2; }
        .ob-sub { color: var(--text-muted); font-size: 14px; margin-bottom: 36px; line-height: 1.6; }

        /* Personality cards */
        .pers-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 32px; }
        .pers-card { border: 1.5px solid var(--border); border-radius: 14px; padding: 20px; cursor: pointer; transition: all 0.2s; background: var(--surface2); position: relative; }
        .pers-card:hover { border-color: var(--border-hover); transform: translateY(-1px); }
        .pers-card.selected { border-color: var(--brand); background: rgba(74,58,255,0.08); }
        .pers-card.selected::after { content: ''; position: absolute; top: 12px; right: 12px; width: 8px; height: 8px; border-radius: 50%; background: var(--brand); }
        .pers-name { font-weight: 700; font-size: 15px; color: var(--text); margin-bottom: 4px; }
        .pers-desc { font-size: 12px; color: var(--text-muted); line-height: 1.5; margin-bottom: 10px; }
        .pers-preview { font-size: 12px; color: var(--text-sub); font-style: italic; border-left: 2px solid var(--border); padding-left: 10px; line-height: 1.4; }
        .pers-card.selected .pers-preview { border-color: var(--brand); }

        /* Budget step */
        .budget-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 28px; }
        .budget-item { background: var(--surface2); border: 1.5px solid var(--border); border-radius: 12px; padding: 16px; transition: border-color 0.2s; }
        .budget-item:focus-within { border-color: var(--brand); }
        .budget-label { font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px; }
        .budget-input-wrap { display: flex; align-items: center; gap: 6px; }
        .budget-input-wrap span { color: var(--text-sub); font-size: 13px; }
        .budget-input { background: transparent; border: none; outline: none; color: var(--text); font-size: 15px; font-weight: 600; width: 100%; font-family: 'Outfit', sans-serif; }
        .budget-input::placeholder { color: var(--text-sub); font-weight: 400; }

        /* Welcome step */
        .welcome-icon { width: 80px; height: 80px; background: linear-gradient(135deg, var(--brand), var(--brand-2)); border-radius: 22px; display: flex; align-items: center; justify-content: center; margin: 0 auto 28px; box-shadow: 0 8px 32px rgba(74,58,255,0.35); }
        .welcome-features { display: flex; flex-direction: column; gap: 14px; margin-bottom: 36px; }
        .welcome-feature { display: flex; align-items: flex-start; gap: 14px; padding: 16px; background: var(--surface2); border-radius: 12px; border: 1px solid var(--border); }
        .welcome-feature-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .welcome-feature h4 { font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 2px; }
        .welcome-feature p { font-size: 12px; color: var(--text-muted); }

        /* Buttons */
        .ob-actions { display: flex; gap: 12px; justify-content: flex-end; }
        .btn-skip { background: transparent; border: 1.5px solid var(--border); color: var(--text-muted); padding: 12px 24px; border-radius: 10px; font-family: 'Outfit', sans-serif; font-size: 14px; font-weight: 500; cursor: pointer; transition: all 0.2s; }
        .btn-skip:hover { border-color: var(--border-hover); color: var(--text); }
        .btn-ob-next { background: var(--brand); color: #fff; border: none; padding: 12px 28px; border-radius: 10px; font-family: 'Outfit', sans-serif; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: var(--shadow-brand); display: flex; align-items: center; gap: 8px; }
        .btn-ob-next:hover { background: var(--brand-2); transform: translateY(-1px); }
        .btn-ob-next:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

        .ob-total-row { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; background: var(--surface3); border-radius: 10px; margin-bottom: 8px; }
        .ob-total-row span { color: var(--text-muted); font-size: 13px; }
        .ob-total-val { font-size: 16px; font-weight: 700; color: var(--text); }

        /* Step panels */
        .ob-panel { display: none; }
        .ob-panel.active { display: block; }
    </style>
</head>
<body>
<div class="ob-wrap">
    <!-- Progress bar -->
    <div class="ob-progress" id="progressBar">
        <div class="ob-step active" id="step-ind-1">
            <div class="ob-step-num">1</div>
            <span>Personalidade</span>
        </div>
        <div class="ob-line" id="line-1"></div>
        <div class="ob-step" id="step-ind-2">
            <div class="ob-step-num">2</div>
            <span>Orçamento</span>
        </div>
        <div class="ob-line" id="line-2"></div>
        <div class="ob-step" id="step-ind-3">
            <div class="ob-step-num">3</div>
            <span>Pronto</span>
        </div>
    </div>

    <div class="ob-card">
        <!-- STEP 1: Personalidade -->
        <div class="ob-panel active" id="panel-1">
            <div class="ob-eyebrow">Passo 1 de 3</div>
            <h1 class="ob-title">Como queres que a Verly te fale?</h1>
            <p class="ob-sub">Escolhe o tom do teu assistente financeiro. Podes mudar mais tarde em qualquer altura.</p>

            <div class="pers-grid">
                <div class="pers-card selected" data-key="calm" onclick="selectPersonality(this)">
                    <div class="pers-name">Calmo</div>
                    <div class="pers-desc">Coach financeiro gentil. Honesto sem ser brutal.</div>
                    <div class="pers-preview">"Identificámos 243€ de oportunidades de poupança. Vamos melhorar juntos."</div>
                </div>
                <div class="pers-card" data-key="savage" onclick="selectPersonality(this)">
                    <div class="pers-name">Savage</div>
                    <div class="pers-desc">Sem filtros. Verdade nua e crua.</div>
                    <div class="pers-preview">"Gastaste 243€ em lixo financeiro este mês. Parabéns pela consistência."</div>
                </div>
                <div class="pers-card" data-key="sarcastic" onclick="selectPersonality(this)">
                    <div class="pers-name">Sarcástico</div>
                    <div class="pers-desc">Ironia refinada. Construtivo, mas com estilo.</div>
                    <div class="pers-preview">"Ah, só 243€ desperdiçados. Modesto para os teus padrões habituais."</div>
                </div>
                <div class="pers-card" data-key="pro" onclick="selectPersonality(this)">
                    <div class="pers-name">Profissional</div>
                    <div class="pers-desc">CFO pessoal. Dados, análise, zero drama.</div>
                    <div class="pers-preview">"Índice de desperdício: 29.1% (243€). Acção requerida: optimizar 2 categorias."</div>
                </div>
            </div>

            <div class="ob-actions">
                <button class="btn-ob-next" onclick="goToStep(2)">
                    Continuar
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </button>
            </div>
        </div>

        <!-- STEP 2: Orçamento mensal -->
        <div class="ob-panel" id="panel-2">
            <div class="ob-eyebrow">Passo 2 de 3</div>
            <h1 class="ob-title">Define o teu orçamento mensal</h1>
            <p class="ob-sub">Quanto queres gastar por categoria? A Verly vai avisarte quando estiveres perto do limite. Podes deixar em branco o que não quiseres controlar.</p>

            <div class="budget-grid">
                {% for cat in categorias %}
                <div class="budget-item">
                    <div class="budget-label">{{ cat }}</div>
                    <div class="budget-input-wrap">
                        <span>€</span>
                        <input type="number" class="budget-input" placeholder="sem limite" min="0" step="5" data-cat="{{ cat }}">
                    </div>
                </div>
                {% endfor %}
            </div>

            <div class="ob-total-row">
                <span>Total orçamentado por mês</span>
                <span class="ob-total-val" id="totalBudget">0 €</span>
            </div>

            <div class="ob-actions">
                <button class="btn-skip" onclick="goToStep(1)">Voltar</button>
                <button class="btn-ob-next" onclick="goToStep(3)">
                    Continuar
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </button>
            </div>
        </div>

        <!-- STEP 3: Pronto -->
        <div class="ob-panel" id="panel-3">
            <div style="text-align:center;">
                <div class="welcome-icon">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div class="ob-eyebrow" style="text-align:center;">Tudo pronto</div>
                <h1 class="ob-title" style="text-align:center;">A Verly está configurada</h1>
                <p class="ob-sub" style="text-align:center;">Aqui está o que podes fazer agora:</p>
            </div>

            <div class="welcome-features">
                <div class="welcome-feature">
                    <div class="welcome-feature-icon" style="background:rgba(74,58,255,0.15);">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--brand-2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    </div>
                    <div>
                        <h4>Faz upload das tuas faturas</h4>
                        <p>PDF, imagem ou ficheiro de texto — a Verly extrai tudo automaticamente.</p>
                    </div>
                </div>
                <div class="welcome-feature">
                    <div class="welcome-feature-icon" style="background:rgba(0,214,143,0.12);">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    </div>
                    <div>
                        <h4>Fala com o Assistente IA</h4>
                        <p>Pergunta quanto gastaste, onde podes poupar, ou analisa uma compra impulso.</p>
                    </div>
                </div>
                <div class="welcome-feature">
                    <div class="welcome-feature-icon" style="background:rgba(255,184,0,0.12);">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--yellow)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    </div>
                    <div>
                        <h4>Acompanha as tuas metas</h4>
                        <p>Vê em tempo real quanto gastaste em cada categoria vs o teu orçamento.</p>
                    </div>
                </div>
            </div>

            <div class="ob-actions" style="justify-content:center;">
                <button class="btn-ob-next" id="btnFinalizar" onclick="finalizar()" style="padding:14px 40px;font-size:15px;">
                    Entrar na Verly
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
let selectedPersonality = 'calm';
const metas = {};

function selectPersonality(el) {
    document.querySelectorAll('.pers-card').forEach(c => c.classList.remove('selected'));
    el.classList.add('selected');
    selectedPersonality = el.dataset.key;
}

function goToStep(n) {
    document.querySelectorAll('.ob-panel').forEach(p => p.classList.remove('active'));
    document.getElementById('panel-' + n).classList.add('active');

    // Update progress indicators
    [1,2,3].forEach(i => {
        const stepEl = document.getElementById('step-ind-' + i);
        stepEl.classList.remove('active', 'done');
        if (i < n) stepEl.classList.add('done');
        else if (i === n) stepEl.classList.add('active');
        if (i < 3) {
            const lineEl = document.getElementById('line-' + i);
            lineEl.classList.toggle('done', i < n);
        }
    });

    // Update step numbers for done steps
    [1,2,3].forEach(i => {
        const numEl = document.querySelector('#step-ind-' + i + ' .ob-step-num');
        if (i < n) {
            numEl.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
        } else {
            numEl.textContent = i;
        }
    });
}

// Update total budget in real time
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.budget-input').forEach(inp => {
        inp.addEventListener('input', updateTotal);
    });
});

function updateTotal() {
    let total = 0;
    document.querySelectorAll('.budget-input').forEach(inp => {
        const v = parseFloat(inp.value) || 0;
        total += v;
        if (v > 0) metas[inp.dataset.cat] = v;
        else delete metas[inp.dataset.cat];
    });
    document.getElementById('totalBudget').textContent = total.toFixed(2).replace('.', ',') + ' €';
}

async function finalizar() {
    const btn = document.getElementById('btnFinalizar');
    btn.disabled = true;
    btn.textContent = 'A guardar...';

    const metasFinais = {};
    document.querySelectorAll('.budget-input').forEach(inp => {
        const v = parseFloat(inp.value) || 0;
        if (v > 0) metasFinais[inp.dataset.cat] = v;
    });

    const orcamento = Object.values(metasFinais).reduce((a, b) => a + b, 0);

    const res = await fetch('/onboarding/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            personalidade: selectedPersonality,
            metas: metasFinais,
            orcamento_mensal: orcamento,
        })
    });

    const data = await res.json();
    if (data.success) {
        window.location.href = '/dashboard';
    } else {
        btn.disabled = false;
        btn.textContent = 'Tentar novamente';
    }
}
</script>
</body>
</html>
</file>

<file path="templates/scoring.html">
{% extends 'base.html' %}
{% block title %}Score de Compras · Verly{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1 class="page-title">🧠 Was It Worth It?</h1>
        <p class="page-sub">Analisa qualquer compra e descobre se valeu a pena — ou não.</p>
    </div>
</div>

<div style="max-width:680px;">

    <!-- FORMULÁRIO -->
    <div class="card" style="margin-bottom:20px;">
        <div class="card-header"><h3>Analisar Compra</h3></div>
        <div class="card-body" style="display:flex;flex-direction:column;gap:16px;">

            <div>
                <label style="display:block;font-size:13px;font-weight:600;color:var(--text-sub);margin-bottom:6px;">Nome do item</label>
                <input
                    id="itemInput"
                    type="text"
                    placeholder="Ex: iPhone 16 Pro, Adidas Samba, Sofá Ikea..."
                    style="
                        width:100%; background:var(--surface2); border:1px solid var(--border);
                        border-radius:8px; color:var(--text); font-family:'Outfit',sans-serif;
                        font-size:14px; padding:10px 14px; outline:none; box-sizing:border-box;
                        transition:border-color 0.2s;
                    "
                    onfocus="this.style.borderColor='var(--brand)'"
                    onblur="this.style.borderColor='var(--border)'"
                >
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                <div>
                    <label style="display:block;font-size:13px;font-weight:600;color:var(--text-sub);margin-bottom:6px;">Preço (€)</label>
                    <input
                        id="precoInput"
                        type="number"
                        min="0"
                        placeholder="0.00"
                        style="
                            width:100%; background:var(--surface2); border:1px solid var(--border);
                            border-radius:8px; color:var(--text); font-family:'Outfit',sans-serif;
                            font-size:14px; padding:10px 14px; outline:none; box-sizing:border-box;
                            transition:border-color 0.2s;
                        "
                        onfocus="this.style.borderColor='var(--brand)'"
                        onblur="this.style.borderColor='var(--border)'"
                    >
                </div>
                <div>
                    <label style="display:block;font-size:13px;font-weight:600;color:var(--text-sub);margin-bottom:6px;">Categoria</label>
                    <select id="categoriaInput" style="
                        width:100%; background:var(--surface2); border:1px solid var(--border);
                        border-radius:8px; color:var(--text); font-family:'Outfit',sans-serif;
                        font-size:14px; padding:10px 14px; outline:none; box-sizing:border-box;
                        transition:border-color 0.2s; cursor:pointer;
                    ">
                        <option value="Outros">Outros</option>
                        <option value="Alimentação">Alimentação</option>
                        <option value="Tecnologia">Tecnologia</option>
                        <option value="Vestuário">Vestuário</option>
                        <option value="Entretenimento">Entretenimento</option>
                        <option value="Saúde & Beleza">Saúde & Beleza</option>
                        <option value="Casa & Decoração">Casa & Decoração</option>
                        <option value="Desporto">Desporto</option>
                        <option value="Educação">Educação</option>
                        <option value="Transportes">Transportes</option>
                    </select>
                </div>
            </div>

            <div>
                <label style="display:block;font-size:13px;font-weight:600;color:var(--text-sub);margin-bottom:8px;">Com que frequência vais usar?</label>
                <div style="display:flex;gap:8px;flex-wrap:wrap;" id="usoGroup">
                    {% for key, label in [('daily','Diariamente'), ('weekly','Regularmente'), ('monthly','Às vezes'), ('rarely','Raramente'), ('never','Nunca')] %}
                    <button
                        class="uso-btn"
                        data-uso="{{ key }}"
                        onclick="selecionarUso('{{ key }}', this)"
                        style="
                            padding:7px 14px; border-radius:20px; border:1px solid var(--border);
                            background:var(--surface2); color:var(--text-muted);
                            font-size:13px; font-weight:600; cursor:pointer; font-family:inherit;
                            transition:all 0.2s;
                        "
                    >{{ label }}</button>
                    {% endfor %}
                </div>
            </div>

            <button
                onclick="analisarCompra()"
                id="btnAnalisar"
                style="
                    background:var(--brand); color:#fff; border:none; border-radius:10px;
                    padding:12px 24px; font-size:15px; font-weight:700; cursor:pointer;
                    font-family:'Outfit',sans-serif; transition:opacity 0.2s; width:100%;
                "
            >Analisar Compra →</button>
        </div>
    </div>

    <!-- RESULTADO -->
    <div id="resultado" style="display:none;">
        <div class="card">
            <div class="card-header">
                <h3 id="resItem" style="font-size:16px;"></h3>
                <span id="resLabel" style="font-size:13px;font-weight:700;padding:4px 12px;border-radius:12px;"></span>
            </div>
            <div class="card-body">

                <!-- Score ring -->
                <div style="display:flex;align-items:center;gap:24px;margin-bottom:20px;">
                    <div style="position:relative;width:90px;height:90px;flex-shrink:0;">
                        <svg width="90" height="90" viewBox="0 0 90 90">
                            <circle cx="45" cy="45" r="36" fill="none" stroke="var(--border)" stroke-width="8"/>
                            <circle id="scoreCircle" cx="45" cy="45" r="36" fill="none"
                                stroke="var(--brand)" stroke-width="8"
                                stroke-linecap="round"
                                stroke-dasharray="226"
                                stroke-dashoffset="226"
                                transform="rotate(-90 45 45)"
                                style="transition:stroke-dashoffset 0.8s ease, stroke 0.4s ease;"
                            />
                        </svg>
                        <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;">
                            <div id="scoreNum" style="font-size:22px;font-weight:800;font-family:'Sora',sans-serif;color:var(--text);"></div>
                            <div style="font-size:10px;color:var(--text-sub);">/ 100</div>
                        </div>
                    </div>
                    <div>
                        <div id="resMessage" style="font-size:14px;color:var(--text-sub);line-height:1.5;margin-bottom:12px;"></div>
                        <div id="resChips" style="display:flex;gap:6px;flex-wrap:wrap;"></div>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block extra_scripts %}
<script>
let usoSelecionado = 'monthly';

// Selecionar uso
function selecionarUso(uso, btn) {
    usoSelecionado = uso;
    document.querySelectorAll('.uso-btn').forEach(b => {
        b.style.background = 'var(--surface2)';
        b.style.color = 'var(--text-muted)';
        b.style.borderColor = 'var(--border)';
    });
    btn.style.background = 'rgba(123,97,255,0.12)';
    btn.style.color = 'var(--brand)';
    btn.style.borderColor = 'var(--brand)';
}

// Selecionar "Às vezes" por defeito ao carregar
window.addEventListener('DOMContentLoaded', () => {
    const btn = document.querySelector('[data-uso="monthly"]');
    if (btn) selecionarUso('monthly', btn);
});

const SCORE_COLORS = {
    green:  { stroke: '#00D68F', bg: 'rgba(0,214,143,0.12)', text: '#00D68F' },
    brand2: { stroke: '#7B61FF', bg: 'rgba(123,97,255,0.12)', text: '#7B61FF' },
    yellow: { stroke: '#FFB800', bg: 'rgba(255,184,0,0.12)', text: '#FFB800' },
    orange: { stroke: '#FF8C00', bg: 'rgba(255,140,0,0.12)', text: '#FF8C00' },
    red:    { stroke: '#FF4757', bg: 'rgba(255,71,87,0.12)', text: '#FF4757' },
    muted:  { stroke: 'var(--border)', bg: 'var(--surface2)', text: 'var(--text-muted)' },
};

const CHIP_STYLES = {
    good: 'background:rgba(0,214,143,0.12);color:#00D68F;border:1px solid rgba(0,214,143,0.25);',
    bad:  'background:rgba(255,71,87,0.12);color:#FF4757;border:1px solid rgba(255,71,87,0.25);',
    mid:  'background:var(--surface2);color:var(--text-sub);border:1px solid var(--border);',
};

async function analisarCompra() {
    const item      = document.getElementById('itemInput').value.trim();
    const preco     = parseFloat(document.getElementById('precoInput').value) || 0;
    const categoria = document.getElementById('categoriaInput').value;

    if (!item) {
        document.getElementById('itemInput').style.borderColor = '#FF4757';
        document.getElementById('itemInput').focus();
        return;
    }
    if (preco <= 0) {
        document.getElementById('precoInput').style.borderColor = '#FF4757';
        document.getElementById('precoInput').focus();
        return;
    }

    const btn = document.getElementById('btnAnalisar');
    btn.disabled = true;
    btn.textContent = 'A analisar...';

    try {
        const res = await fetch('/scoring/analisar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ item, preco, categoria, uso: usoSelecionado }),
        });
        const data = await res.json();

        if (!data.success) throw new Error(data.message || 'Erro');

        mostrarResultado(data.resultado);
    } catch (e) {
        alert('Erro: ' + e.message);
    } finally {
        btn.disabled = false;
        btn.textContent = 'Analisar Compra →';
    }
}

function mostrarResultado(r) {
    const colors = SCORE_COLORS[r.color] || SCORE_COLORS.muted;

    // Item name
    document.getElementById('resItem').textContent = r.item || 'Compra';

    // Label badge
    const lbl = document.getElementById('resLabel');
    lbl.textContent = r.label;
    lbl.style.cssText = `font-size:13px;font-weight:700;padding:4px 12px;border-radius:12px;background:${colors.bg};color:${colors.text};`;

    // Score number
    document.getElementById('scoreNum').textContent = r.score;

    // Score circle animation
    const circle = document.getElementById('scoreCircle');
    const circumference = 226;
    const offset = circumference - (r.score / 100) * circumference;
    setTimeout(() => {
        circle.style.strokeDashoffset = offset;
        circle.style.stroke = colors.stroke;
    }, 50);

    // Message
    document.getElementById('resMessage').textContent = r.message;

    // Chips
    const chipsEl = document.getElementById('resChips');
    chipsEl.innerHTML = (r.chips || []).map(c =>
        `<span style="font-size:12px;font-weight:600;padding:4px 10px;border-radius:10px;${CHIP_STYLES[c.type] || CHIP_STYLES.mid}">${c.text}</span>`
    ).join('');

    // Show
    const resDiv = document.getElementById('resultado');
    resDiv.style.display = 'block';
    resDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}
</script>
{% endblock %}
