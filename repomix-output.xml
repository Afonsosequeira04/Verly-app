<file path="templates/configuracoes.html">
{% extends 'base.html' %}
{% block title %}Configurações · Verly{% endblock %}

{% block extra_head %}
<style>
.config-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 24px;
    max-width: 860px;
}
.config-tabs {
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.config-tab {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    border: none;
    background: transparent;
    text-align: left;
    transition: all 0.15s;
    width: 100%;
}
.config-tab:hover { background: var(--surface2); color: var(--text); }
.config-tab.active { background: var(--brand-light); color: var(--brand); font-weight: 600; }
.config-tab svg { flex-shrink: 0; }

.config-panel { display: none; }
.config-panel.active { display: block; }

.config-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px;
    margin-bottom: 20px;
}
.config-section h3 {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--text-muted);
    margin: 0 0 18px;
}
.config-field {
    margin-bottom: 16px;
}
.config-field label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 6px;
}
.config-field input,
.config-field select {
    width: 100%;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    padding: 9px 12px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.15s;
}
.config-field input:focus,
.config-field select:focus { border-color: var(--brand); }

.toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
}
.toggle-row:last-child { border-bottom: none; }
.toggle-info { flex: 1; }
.toggle-info .toggle-title { font-size: 14px; font-weight: 500; color: var(--text); }
.toggle-info .toggle-desc { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
.toggle-switch {
    position: relative;
    width: 40px; height: 22px;
    flex-shrink: 0;
}
.toggle-switch input { opacity: 0; width: 0; height: 0; }
.toggle-slider {
    position: absolute; inset: 0;
    background: var(--surface3);
    border-radius: 11px;
    cursor: pointer;
    transition: background 0.2s;
}
.toggle-slider::before {
    content: '';
    position: absolute;
    width: 16px; height: 16px;
    left: 3px; top: 3px;
    background: white;
    border-radius: 50%;
    transition: transform 0.2s;
}
.toggle-switch input:checked + .toggle-slider { background: var(--brand); }
.toggle-switch input:checked + .toggle-slider::before { transform: translateX(18px); }

/* Personalidade cards */
.pers-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}
.pers-card {
    background: var(--surface2);
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
}
.pers-card:hover { border-color: var(--brand); }
.pers-card.ativo { border-color: var(--brand); background: var(--brand-light); }
.pers-card .badge {
    display: none;
    position: absolute; top: 10px; right: 10px;
    background: var(--brand); color: white;
    font-size: 9px; font-weight: 700; padding: 2px 7px;
    border-radius: 4px; letter-spacing: .5px;
}
.pers-card.ativo .badge { display: block; }
.pers-nome { font-size: 14px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
.pers-desc { font-size: 11px; color: var(--text-muted); line-height: 1.5; }

/* Língua */
.lingua-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}
.lingua-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    background: var(--surface2);
    border: 2px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.15s;
}
.lingua-card:hover { border-color: var(--brand); }
.lingua-card.ativo { border-color: var(--brand); background: var(--brand-light); }
.lingua-flag { font-size: 20px; }
.lingua-nome { font-size: 13px; font-weight: 600; color: var(--text); }

.btn-guardar {
    background: var(--brand);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 22px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: opacity 0.15s;
    margin-top: 4px;
}
.btn-guardar:hover { opacity: 0.88; }

/* Botão de teste de email */
.btn-teste-email {
    background: transparent;
    color: var(--brand);
    border: 1px solid var(--brand);
    border-radius: 8px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s;
    margin-top: 10px;
}
.btn-teste-email:hover { background: var(--brand-light); }
.btn-teste-email:disabled { opacity: 0.5; cursor: not-allowed; }
.email-teste-msg {
    display: block;
    font-size: 12px;
    margin-top: 8px;
    min-height: 18px;
}

#confirmMsg {
    display: none;
    margin-top: 12px;
    background: rgba(0,214,143,0.08);
    border: 1px solid rgba(0,214,143,0.2);
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 13px;
    color: #00D68F;
    font-weight: 600;
}

@media (max-width: 600px) {
    .config-layout { grid-template-columns: 1fr; }
    .config-tabs { flex-direction: row; overflow-x: auto; }
    .pers-grid, .lingua-grid { grid-template-columns: 1fr; }
}
</style>
{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1 class="page-title">Configurações</h1>
        <p class="page-sub">Personaliza a tua experiência com a Verly.</p>
    </div>
</div>

<div class="config-layout">

    <!-- Tabs -->
    <div class="config-tabs">
        <button class="config-tab active" onclick="showTab('personalidade', this)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            Personalidade
        </button>
        <button class="config-tab" onclick="showTab('lingua', this)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            Língua
        </button>
        <button class="config-tab" onclick="showTab('preferencias', this)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M5.34 18.66l-1.41 1.41M20 12h2M2 12h2M19.07 19.07l-1.41-1.41M5.34 5.34 3.93 3.93M12 20v2M12 2v2"/></svg>
            Preferências
        </button>
    </div>

    <!-- Painéis -->
    <div>

        <!-- Personalidade -->
        <div class="config-panel active" id="panel-personalidade">
            <div class="config-section">
                <h3>Como a Verly te fala</h3>
                <div class="pers-grid">
                    {% for key, p in personalidades.items() %}
                    <div class="pers-card {% if key == atual_personalidade %}ativo{% endif %}"
                         data-key="{{ key }}" data-cor="{{ p.cor }}"
                         onclick="selecionarPersonalidade('{{ key }}', this)">
                        <div class="badge">ATIVO</div>
                        <div class="pers-nome">{{ p.nome }}</div>
                        <div class="pers-desc">{{ p.descricao }}</div>
                    </div>
                    {% endfor %}
                </div>
                <div id="confirmMsg"></div>
                <p style="font-size:11px;color:var(--text-sub);margin-top:16px;">
                    Afeta o Chat, Score de Compras, Relatório Mensal e Impulse Control.
                </p>
            </div>
        </div>

        <!-- Língua -->
        <div class="config-panel" id="panel-lingua">
            <div class="config-section">
                <h3>Idioma da interface</h3>
                <div class="lingua-grid">
                    {% for key, l in linguas.items() %}
                    <div class="lingua-card {% if key == lingua_atual %}ativo{% endif %}"
                         data-key="{{ key }}" onclick="selecionarLingua('{{ key }}', this)">
                        <span class="lingua-flag">{{ l.flag }}</span>
                        <span class="lingua-nome">{{ l.nome }}</span>
                    </div>
                    {% endfor %}
                </div>
                <div id="confirmLingua" style="display:none;margin-top:12px;background:rgba(0,214,143,0.08);border:1px solid rgba(0,214,143,0.2);border-radius:8px;padding:10px 16px;font-size:13px;color:#00D68F;font-weight:600;"></div>
                <p style="font-size:11px;color:var(--text-sub);margin-top:16px;">
                    A tradução completa da interface está em desenvolvimento. Por agora guarda a tua preferência.
                </p>
            </div>
        </div>

        <!-- Preferências -->
        <div class="config-panel" id="panel-preferencias">
            <div class="config-section">
                <h3>Conta</h3>
                <form method="POST" action="{{ url_for('configuracoes.set_preferencias') }}">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                    <div class="config-field">
                        <label>Nome</label>
                        <input type="text" name="nome" value="{{ current_user.nome }}" placeholder="O teu nome">
                    </div>
                    <div class="config-field">
                        <label>Orçamento Mensal (€)</label>
                        <input type="number" name="orcamento_mensal" step="0.01" min="0"
                               value="{{ current_user.orcamento_mensal or '' }}" placeholder="ex: 500">
                    </div>
                    <button type="submit" class="btn-guardar">Guardar alterações</button>
                </form>
            </div>

            <div class="config-section">
                <h3>Notificações</h3>
                <div class="toggle-row">
                    <div class="toggle-info">
                        <div class="toggle-title">Notificações por email</div>
                        <div class="toggle-desc">Recebe alertas de garantias, orçamento e subscrições</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" id="toggleNotif"
                               {% if current_user.notificacoes_email %}checked{% endif %}
                               onchange="guardarNotif(this.checked)">
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <!-- Botão de teste — só visível quando o toggle está activo -->
                <div id="email-teste-wrapper" style="padding-top: 14px; {% if not current_user.notificacoes_email %}display:none;{% endif %}">
                    <button type="button" class="btn-teste-email" id="btn-teste-email"
                            onclick="testarEmail()">
                        Enviar email de teste
                    </button>
                    <span class="email-teste-msg" id="email-teste-msg"></span>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
function showTab(id, btn) {
    document.querySelectorAll('.config-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.config-tab').forEach(t => t.classList.remove('active'));
    document.getElementById('panel-' + id).classList.add('active');
    btn.classList.add('active');
}

async function selecionarPersonalidade(key, card) {
    try {
        const res = await fetch('/configuracoes/personalidade', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ personalidade: key })
        });
        const data = await res.json();
        if (!data.success) return;
        document.querySelectorAll('.pers-card').forEach(c => c.classList.remove('ativo'));
        card.classList.add('ativo');
        const msg = document.getElementById('confirmMsg');
        msg.textContent = `Personalidade "${data.info.nome}" ativada.`;
        msg.style.display = 'block';
        setTimeout(() => msg.style.display = 'none', 3000);
    } catch(e) { console.error(e); }
}

async function selecionarLingua(key, card) {
    try {
        const res = await fetch('/configuracoes/lingua', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lingua: key })
        });
        const data = await res.json();
        if (!data.success) return;
        document.querySelectorAll('.lingua-card').forEach(c => c.classList.remove('ativo'));
        card.classList.add('ativo');
        const msg = document.getElementById('confirmLingua');
        msg.textContent = `Língua "${data.nome}" guardada.`;
        msg.style.display = 'block';
        setTimeout(() => msg.style.display = 'none', 3000);
    } catch(e) { console.error(e); }
}

async function guardarNotif(val) {
    await fetch('/perfil/atualizar', {
        method: 'POST',
        body: new URLSearchParams({ notificacoes_email: val ? 'on' : '' })
    });
    // Mostrar/esconder botão de teste
    document.getElementById('email-teste-wrapper').style.display = val ? 'block' : 'none';
    document.getElementById('email-teste-msg').textContent = '';
}

async function testarEmail() {
    const btn = document.getElementById('btn-teste-email');
    const msg = document.getElementById('email-teste-msg');
    btn.disabled = true;
    msg.textContent = 'A enviar…';
    msg.style.color = 'var(--text-muted)';

    try {
        const token = document.querySelector('meta[name="csrf-token"]')?.content || '';
        const res = await fetch('/alertas/teste', {
            method: 'POST',
            headers: {
                'X-CSRFToken': token,
                'X-Requested-With': 'XMLHttpRequest'
            }
        });
        const data = await res.json();
        msg.textContent = data.message;
        msg.style.color = data.success ? '#00D68F' : '#E24B4A';
    } catch (e) {
        msg.textContent = 'Erro de rede. Tenta novamente.';
        msg.style.color = '#E24B4A';
    } finally {
        btn.disabled = false;
    }
}
</script>
{% endblock %}
</file>

<file path="templates/impulse.html">
{% extends 'base.html' %}
{% block title %}Impulse Control · Verly{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1 class="page-title">Impulse Control</h1>
        <p class="page-sub">Antes de comprar, pergunta à Verly. Ela vai ser honesta.</p>
    </div>
</div>

<div style="max-width:680px;">

    <div class="card" style="margin-bottom:20px;">
        <div class="card-header">
            <h3>Modo de Resposta</h3>
            <a href="{{ url_for('personality.personality') }}" class="card-link">Alterar →</a>
        </div>
        <div class="card-body" style="display:flex;gap:8px;flex-wrap:wrap;">
            {% set modos = [('savage','Savage'),('sarcastic','Sarcástico'),('calm','Calmo'),('pro','Profissional')] %}
            {% for key, nome in modos %}
            <button class="pers-pill {% if key == personalidade_atual %}pers-pill--active{% endif %}"
                data-p="{{ key }}"
                onclick="selecionarPersonalidade('{{ key }}', this)"
                style="padding:7px 16px;border-radius:6px;border:1px solid {% if key == personalidade_atual %}var(--brand-2){% else %}var(--border){% endif %};
                background:{% if key == personalidade_atual %}rgba(123,97,255,0.1){% else %}var(--surface2){% endif %};
                color:{% if key == personalidade_atual %}var(--brand-2){% else %}var(--text-muted){% endif %};
                font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:all 0.2s;">
                {{ nome }}
            </button>
            {% endfor %}
        </div>
    </div>

    <div class="card" style="margin-bottom:20px;">
        <div class="card-header"><h3>O que queres comprar?</h3></div>
        <div class="card-body">
            <textarea id="impulseInput"
                placeholder="Ex: Adidas Samba 120€ · iPhone 16 Pro 1299€ · Sofá IKEA 800€"
                rows="3"
                style="width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:8px;
                color:var(--text);font-family:'Outfit',sans-serif;font-size:14px;padding:12px 16px;
                resize:none;outline:none;transition:border-color 0.2s;line-height:1.5;"
                onfocus="this.style.borderColor='var(--brand)'"
                onblur="this.style.borderColor='var(--border)'"></textarea>
            <button class="btn-primary" style="margin-top:12px;" onclick="analisarImpulso()">
                Analisar antes de comprar
            </button>
        </div>
    </div>

    <div id="impulseResult" style="display:none;">
        <div id="impulseLoading" class="card" style="margin-bottom:20px;display:none;">
            <div class="card-body" style="text-align:center;padding:32px;color:var(--text-muted);">
                <div style="font-size:13px;">A analisar...</div>
            </div>
        </div>
        <div id="impulseContent">
            <div class="card" style="margin-bottom:12px;">
                <div class="card-header"><h3>Análise</h3></div>
                <div class="card-body"><p id="resAnalise" style="font-size:14px;line-height:1.7;color:var(--text);"></p></div>
            </div>
            <div class="card" style="margin-bottom:12px;">
                <div class="card-header"><h3>Alternativa</h3></div>
                <div class="card-body"><p id="resAlternativa" style="font-size:14px;line-height:1.7;color:var(--text);"></p></div>
            </div>
            <div id="bannerAguardar" style="background:rgba(255,184,0,0.06);border:1px solid rgba(255,184,0,0.15);
                border-radius:10px;padding:16px 20px;text-align:center;margin-bottom:20px;">
                <div id="resVeredicto" style="font-size:14px;font-weight:600;color:var(--yellow);"></div>
            </div>
            <div id="bannerOk" style="background:rgba(0,214,143,0.06);border:1px solid rgba(0,214,143,0.15);
                border-radius:10px;padding:16px 20px;text-align:center;margin-bottom:20px;display:none;">
                <div id="resVeredictoOk" style="font-size:14px;font-weight:600;color:var(--green);"></div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
let personalidadeAtual = '{{ personalidade_atual }}';
function selecionarPersonalidade(key, btn) {
    personalidadeAtual = key;
    document.querySelectorAll('.pers-pill').forEach(b => {
        const active = b.dataset.p === key;
        b.style.background  = active ? 'rgba(123,97,255,0.1)' : 'var(--surface2)';
        b.style.color       = active ? 'var(--brand-2)' : 'var(--text-muted)';
        b.style.borderColor = active ? 'var(--brand-2)' : 'var(--border)';
    });
    fetch('/personality/set',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({personalidade:key})});
}
async function analisarImpulso() {
    const produto = document.getElementById('impulseInput').value.trim();
    if (!produto) { alert('Descreve o que queres comprar.'); return; }
    document.getElementById('impulseResult').style.display = 'block';
    document.getElementById('impulseLoading').style.display = 'block';
    document.getElementById('impulseContent').style.display = 'none';
    try {
        const res = await fetch('/impulse/analyze',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({produto,personalidade:personalidadeAtual})});
        const data = await res.json();
        document.getElementById('impulseLoading').style.display = 'none';
        if (data.success) {
            const r = data.resultado;
            document.getElementById('resAnalise').textContent = r.analise;
            document.getElementById('resAlternativa').textContent = r.alternativa;
            if (r.aguardar) {
                document.getElementById('bannerAguardar').style.display='block';
                document.getElementById('bannerOk').style.display='none';
                document.getElementById('resVeredicto').textContent=r.veredicto;
            } else {
                document.getElementById('bannerAguardar').style.display='none';
                document.getElementById('bannerOk').style.display='block';
                document.getElementById('resVeredictoOk').textContent=r.veredicto;
            }
            document.getElementById('impulseContent').style.display='block';
        } else { alert('Erro: '+(data.message||'Tenta de novo.')); document.getElementById('impulseResult').style.display='none'; }
    } catch(e) { alert('Erro de ligação.'); document.getElementById('impulseResult').style.display='none'; }
}
document.getElementById('impulseInput').addEventListener('keydown',e=>{if(e.key==='Enter'&&e.ctrlKey)analisarImpulso();});
</script>
{% endblock %}
</file>

<file path="templates/onboarding.html">
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bem-vindo à Verly</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Sora:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <style>
        body { background: var(--bg); display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 20px; }

        .ob-wrap { width: 100%; max-width: 680px; }

        /* Progress */
        .ob-progress { display: flex; align-items: center; gap: 0; margin-bottom: 40px; }
        .ob-step { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.5px; text-transform: uppercase; }
        .ob-step.active { color: var(--text); }
        .ob-step.done { color: var(--green); }
        .ob-step-num { width: 28px; height: 28px; border-radius: 50%; background: var(--surface2); border: 1.5px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; transition: all 0.3s; flex-shrink: 0; }
        .ob-step.active .ob-step-num { background: var(--brand); border-color: var(--brand); color: #fff; box-shadow: 0 0 16px rgba(74,58,255,0.4); }
        .ob-step.done .ob-step-num { background: var(--green); border-color: var(--green); color: #fff; }
        .ob-line { flex: 1; height: 1px; background: var(--border); margin: 0 12px; }
        .ob-line.done { background: var(--green); }

        /* Card */
        .ob-card { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 48px; animation: fadeUp 0.4s ease; }
        @keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

        .ob-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--brand-2); margin-bottom: 12px; }
        .ob-title { font-family: 'Sora', sans-serif; font-size: 28px; font-weight: 700; color: var(--text); margin-bottom: 10px; line-height: 1.2; }
        .ob-sub { color: var(--text-muted); font-size: 14px; margin-bottom: 36px; line-height: 1.6; }

        /* Personality cards */
        .pers-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 32px; }
        .pers-card { border: 1.5px solid var(--border); border-radius: 14px; padding: 20px; cursor: pointer; transition: all 0.2s; background: var(--surface2); position: relative; }
        .pers-card:hover { border-color: var(--border-hover); transform: translateY(-1px); }
        .pers-card.selected { border-color: var(--brand); background: rgba(74,58,255,0.08); }
        .pers-card.selected::after { content: ''; position: absolute; top: 12px; right: 12px; width: 8px; height: 8px; border-radius: 50%; background: var(--brand); }
        .pers-name { font-weight: 700; font-size: 15px; color: var(--text); margin-bottom: 4px; }
        .pers-desc { font-size: 12px; color: var(--text-muted); line-height: 1.5; margin-bottom: 10px; }
        .pers-preview { font-size: 12px; color: var(--text-sub); font-style: italic; border-left: 2px solid var(--border); padding-left: 10px; line-height: 1.4; }
        .pers-card.selected .pers-preview { border-color: var(--brand); }


        /* Global budget field */
        .ob-global-budget { background: var(--surface3); border: 2px solid var(--brand); border-radius: 14px; padding: 20px; margin-bottom: 8px; transition: border-color 0.2s; }
        .ob-global-budget.error { border-color: var(--red); }
        .ob-global-label { display:flex; align-items:flex-start; gap:12px; margin-bottom:14px; font-size:14px; font-weight:600; color:var(--text); }
        .ob-global-label span { font-size:20px; flex-shrink:0; }
        .ob-global-sub { display:block; font-size:12px; font-weight:400; color:var(--text-muted); margin-top:2px; }
        .ob-global-input-wrap { display:flex; align-items:center; gap:8px; background: var(--surface2); border: 1.5px solid var(--border); border-radius: 10px; padding: 10px 14px; }
        .ob-global-input-wrap:focus-within { border-color: var(--brand); }
        .ob-global-symbol { font-size:18px; font-weight:700; color: var(--text-sub); }
        .ob-global-input { background:transparent; border:none; outline:none; color:var(--text); font-size:20px; font-weight:700; width:100%; font-family:'Outfit',sans-serif; }
        .ob-global-input::placeholder { color:var(--text-sub); font-weight:400; font-size:16px; }
        .ob-global-error { font-size:12px; color:var(--red); margin-top:8px; }
        /* Budget step */
        .budget-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 28px; }
        .budget-item { background: var(--surface2); border: 1.5px solid var(--border); border-radius: 12px; padding: 16px; transition: border-color 0.2s; }
        .budget-item:focus-within { border-color: var(--brand); }
        .budget-label { font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px; }
        .budget-input-wrap { display: flex; align-items: center; gap: 6px; }
        .budget-input-wrap span { color: var(--text-sub); font-size: 13px; }
        .budget-input { background: transparent; border: none; outline: none; color: var(--text); font-size: 15px; font-weight: 600; width: 100%; font-family: 'Outfit', sans-serif; }
        .budget-input::placeholder { color: var(--text-sub); font-weight: 400; }

        /* Welcome step */
        .welcome-icon { width: 80px; height: 80px; background: linear-gradient(135deg, var(--brand), var(--brand-2)); border-radius: 22px; display: flex; align-items: center; justify-content: center; margin: 0 auto 28px; box-shadow: 0 8px 32px rgba(74,58,255,0.35); }
        .welcome-features { display: flex; flex-direction: column; gap: 14px; margin-bottom: 36px; }
        .welcome-feature { display: flex; align-items: flex-start; gap: 14px; padding: 16px; background: var(--surface2); border-radius: 12px; border: 1px solid var(--border); }
        .welcome-feature-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .welcome-feature h4 { font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 2px; }
        .welcome-feature p { font-size: 12px; color: var(--text-muted); }

        /* Buttons */
        .ob-actions { display: flex; gap: 12px; justify-content: flex-end; }
        .btn-skip { background: transparent; border: 1.5px solid var(--border); color: var(--text-muted); padding: 12px 24px; border-radius: 10px; font-family: 'Outfit', sans-serif; font-size: 14px; font-weight: 500; cursor: pointer; transition: all 0.2s; }
        .btn-skip:hover { border-color: var(--border-hover); color: var(--text); }
        .btn-ob-next { background: var(--brand); color: #fff; border: none; padding: 12px 28px; border-radius: 10px; font-family: 'Outfit', sans-serif; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: var(--shadow-brand); display: flex; align-items: center; gap: 8px; }
        .btn-ob-next:hover { background: var(--brand-2); transform: translateY(-1px); }
        .btn-ob-next:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

        .ob-total-row { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; background: var(--surface3); border-radius: 10px; margin-bottom: 8px; }
        .ob-total-row span { color: var(--text-muted); font-size: 13px; }
        .ob-total-val { font-size: 16px; font-weight: 700; color: var(--text); }

        /* Step panels */
        .ob-panel { display: none; }
        .ob-panel.active { display: block; }
    </style>
</head>
<body>
<div class="ob-wrap">
    <!-- Progress bar -->
    <div class="ob-progress" id="progressBar">
        <div class="ob-step active" id="step-ind-1">
            <div class="ob-step-num">1</div>
            <span>Personalidade</span>
        </div>
        <div class="ob-line" id="line-1"></div>
        <div class="ob-step" id="step-ind-2">
            <div class="ob-step-num">2</div>
            <span>Orçamento</span>
        </div>
        <div class="ob-line" id="line-2"></div>
        <div class="ob-step" id="step-ind-3">
            <div class="ob-step-num">3</div>
            <span>Pronto</span>
        </div>
    </div>

    <div class="ob-card">
        <!-- STEP 1: Personalidade -->
        <div class="ob-panel active" id="panel-1">
            <div class="ob-eyebrow">Passo 1 de 3</div>
            <h1 class="ob-title">Como queres que a Verly te fale?</h1>
            <p class="ob-sub">Escolhe o tom do teu assistente financeiro. Podes mudar mais tarde em qualquer altura.</p>

            <div class="pers-grid">
                <div class="pers-card selected" data-key="calm" onclick="selectPersonality(this)">
                    <div class="pers-name">Calmo</div>
                    <div class="pers-desc">Coach financeiro gentil. Honesto sem ser brutal.</div>
                    <div class="pers-preview">"Identificámos 243€ de oportunidades de poupança. Vamos melhorar juntos."</div>
                </div>
                <div class="pers-card" data-key="savage" onclick="selectPersonality(this)">
                    <div class="pers-name">Savage</div>
                    <div class="pers-desc">Sem filtros. Verdade nua e crua.</div>
                    <div class="pers-preview">"Gastaste 243€ em lixo financeiro este mês. Parabéns pela consistência."</div>
                </div>
                <div class="pers-card" data-key="sarcastic" onclick="selectPersonality(this)">
                    <div class="pers-name">Sarcástico</div>
                    <div class="pers-desc">Ironia refinada. Construtivo, mas com estilo.</div>
                    <div class="pers-preview">"Ah, só 243€ desperdiçados. Modesto para os teus padrões habituais."</div>
                </div>
                <div class="pers-card" data-key="pro" onclick="selectPersonality(this)">
                    <div class="pers-name">Profissional</div>
                    <div class="pers-desc">CFO pessoal. Dados, análise, zero drama.</div>
                    <div class="pers-preview">"Índice de desperdício: 29.1% (243€). Acção requerida: optimizar 2 categorias."</div>
                </div>
            </div>

            <div class="ob-actions">
                <button class="btn-ob-next" onclick="goToStep(2)">
                    Continuar
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </button>
            </div>
        </div>

        <!-- STEP 2: Orçamento mensal -->
        <div class="ob-panel" id="panel-2">
            <div class="ob-eyebrow">Passo 2 de 3</div>
            <h1 class="ob-title">Define o teu orçamento mensal</h1>
            <p class="ob-sub">Quanto queres gastar por mês no total? A Verly vai avisarte quando estiveres perto do limite.</p>

            <!-- Orçamento global obrigatório -->
            <div class="ob-global-budget" id="globalBudgetWrap">
                <div class="ob-global-label">
                    <span>💰</span>
                    <div>
                        <strong>Orçamento mensal total</strong>
                        <span class="ob-global-sub">Obrigatório — podes afinar por categoria a seguir</span>
                    </div>
                </div>
                <div class="ob-global-input-wrap">
                    <span class="ob-global-symbol">€</span>
                    <input type="number" id="orcamentoGlobal" class="ob-global-input" placeholder="ex: 800" min="1" step="10" oninput="onGlobalBudgetChange()">
                </div>
                <div class="ob-global-error" id="globalBudgetError" style="display:none;">⚠️ Define um orçamento mensal para continuar.</div>
            </div>

            <p class="ob-sub" style="margin-top:24px;margin-bottom:12px;">Quer dividir por categoria? (opcional)</p>

            <div class="budget-grid">
                {% for cat in categorias %}
                <div class="budget-item">
                    <div class="budget-label">{{ cat }}</div>
                    <div class="budget-input-wrap">
                        <span>€</span>
                        <input type="number" class="budget-input" placeholder="sem limite" min="0" step="5" data-cat="{{ cat }}">
                    </div>
                </div>
                {% endfor %}
            </div>

            <div class="ob-total-row">
                <span>Total orçamentado por mês</span>
                <span class="ob-total-val" id="totalBudget">0 €</span>
            </div>

            <div class="ob-actions">
                <button class="btn-skip" onclick="goToStep(1)">Voltar</button>
                <button class="btn-ob-next" onclick="validateAndGoStep3()">
                    Continuar
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </button>
            </div>
        </div>

        <!-- STEP 3: Pronto -->
        <div class="ob-panel" id="panel-3">
            <div style="text-align:center;">
                <div class="welcome-icon">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div class="ob-eyebrow" style="text-align:center;">Tudo pronto</div>
                <h1 class="ob-title" style="text-align:center;">A Verly está configurada</h1>
                <p class="ob-sub" style="text-align:center;">Aqui está o que podes fazer agora:</p>
            </div>

            <div class="welcome-features">
                <div class="welcome-feature">
                    <div class="welcome-feature-icon" style="background:rgba(74,58,255,0.15);">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--brand-2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    </div>
                    <div>
                        <h4>Faz upload das tuas faturas</h4>
                        <p>PDF, imagem ou ficheiro de texto — a Verly extrai tudo automaticamente.</p>
                    </div>
                </div>
                <div class="welcome-feature">
                    <div class="welcome-feature-icon" style="background:rgba(0,214,143,0.12);">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    </div>
                    <div>
                        <h4>Fala com o Assistente IA</h4>
                        <p>Pergunta quanto gastaste, onde podes poupar, ou analisa uma compra impulso.</p>
                    </div>
                </div>
                <div class="welcome-feature">
                    <div class="welcome-feature-icon" style="background:rgba(255,184,0,0.12);">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--yellow)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    </div>
                    <div>
                        <h4>Acompanha as tuas metas</h4>
                        <p>Vê em tempo real quanto gastaste em cada categoria vs o teu orçamento.</p>
                    </div>
                </div>
            </div>

            <div class="ob-actions" style="justify-content:center;">
                <button class="btn-ob-next" id="btnFinalizar" onclick="finalizar()" style="padding:14px 40px;font-size:15px;">
                    Entrar na Verly
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
let selectedPersonality = 'calm';
const metas = {};

function selectPersonality(el) {
    document.querySelectorAll('.pers-card').forEach(c => c.classList.remove('selected'));
    el.classList.add('selected');
    selectedPersonality = el.dataset.key;
}

function goToStep(n) {
    document.querySelectorAll('.ob-panel').forEach(p => p.classList.remove('active'));
    document.getElementById('panel-' + n).classList.add('active');

    // Update progress indicators
    [1,2,3].forEach(i => {
        const stepEl = document.getElementById('step-ind-' + i);
        stepEl.classList.remove('active', 'done');
        if (i < n) stepEl.classList.add('done');
        else if (i === n) stepEl.classList.add('active');
        if (i < 3) {
            const lineEl = document.getElementById('line-' + i);
            lineEl.classList.toggle('done', i < n);
        }
    });

    // Update step numbers for done steps
    [1,2,3].forEach(i => {
        const numEl = document.querySelector('#step-ind-' + i + ' .ob-step-num');
        if (i < n) {
            numEl.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
        } else {
            numEl.textContent = i;
        }
    });
}

// Update total budget in real time
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.budget-input').forEach(inp => {
        inp.addEventListener('input', updateTotal);
    });
});

function updateTotal() {
    let total = 0;
    document.querySelectorAll('.budget-input').forEach(inp => {
        const v = parseFloat(inp.value) || 0;
        total += v;
        if (v > 0) metas[inp.dataset.cat] = v;
        else delete metas[inp.dataset.cat];
    });
    document.getElementById('totalBudget').textContent = total.toFixed(2).replace('.', ',') + ' €';
}

function onGlobalBudgetChange() {
    const v = parseFloat(document.getElementById('orcamentoGlobal').value) || 0;
    const wrap = document.getElementById('globalBudgetWrap');
    const err = document.getElementById('globalBudgetError');
    if (v > 0) {
        wrap.classList.remove('error');
        err.style.display = 'none';
    }
}

function validateAndGoStep3() {
    const globalVal = parseFloat(document.getElementById('orcamentoGlobal').value) || 0;
    const wrap = document.getElementById('globalBudgetWrap');
    const err = document.getElementById('globalBudgetError');
    if (globalVal <= 0) {
        wrap.classList.add('error');
        err.style.display = 'block';
        document.getElementById('orcamentoGlobal').focus();
        return;
    }
    wrap.classList.remove('error');
    err.style.display = 'none';
    goToStep(3);
}

async function finalizar() {
    const btn = document.getElementById('btnFinalizar');
    btn.disabled = true;
    btn.textContent = 'A guardar...';

    const metasFinais = {};
    document.querySelectorAll('.budget-input').forEach(inp => {
        const v = parseFloat(inp.value) || 0;
        if (v > 0) metasFinais[inp.dataset.cat] = v;
    });

    const globalBudget = parseFloat(document.getElementById('orcamentoGlobal').value) || 0;
    const catSum = Object.values(metasFinais).reduce((a, b) => a + b, 0);
    const orcamento = globalBudget > 0 ? globalBudget : catSum;

    const res = await fetch('/onboarding/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            personalidade: selectedPersonality,
            metas: metasFinais,
            orcamento_mensal: orcamento,
        })
    });

    const data = await res.json();
    if (data.success) {
        window.location.href = '/dashboard';
    } else {
        btn.disabled = false;
        btn.textContent = 'Tentar novamente';
    }
}
</script>
</body>
</html>
</file>

<file path="templates/relatorio.html">
{% extends 'base.html' %}
{% block title %}Relatório Mensal · Verly{% endblock %}
{% block extra_head %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1 class="page-title">Relatório Mensal</h1>
        <p class="page-sub">{{ mes_nome }} {{ ano }}</p>
    </div>
    <div style="display:flex;gap:6px;flex-wrap:wrap;">
        {% for m in meses_nav %}
        <a href="{{ url_for('reports.relatorio', mes=m.mes, ano=m.ano) }}"
           class="btn-ghost {% if m.mes == mes and m.ano == ano %}btn-ghost--active{% endif %}"
           style="{% if m.mes == mes and m.ano == ano %}border-color:var(--brand-2);color:var(--brand-2);{% endif %}padding:7px 12px;font-size:12px;">
            {{ m.nome }}
        </a>
        {% endfor %}
    </div>
</div>

{% if total_gasto > 0 %}
<div class="metrics-grid" style="grid-template-columns:repeat(3,1fr);margin-bottom:28px;">
    <div class="metric-card">
        <div class="metric-icon" style="background:rgba(255,71,87,0.08);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
        </div>
        <div class="metric-body">
            <span class="metric-label">Total Gasto</span>
            <span class="metric-value metric-value-sm" style="color:var(--red)">{{ '%.2f'|format(total_gasto) }}€</span>
            {% if variacao != 0 %}
            <span class="metric-trend {% if variacao > 0 %}trend-bad{% else %}trend-ok{% endif %}">
                {% if variacao > 0 %}+{% endif %}{{ variacao|round(1) }}% vs mês anterior
            </span>
            {% endif %}
        </div>
    </div>
    <div class="metric-card">
        <div class="metric-icon" style="background:rgba(255,184,0,0.08);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--yellow)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
        </div>
        <div class="metric-body">
            <span class="metric-label">Estimativa Desperdício</span>
            <span class="metric-value metric-value-sm" style="color:var(--yellow)">{{ '%.2f'|format(desperdicado) }}€</span>
            <span class="metric-trend trend-bad">{{ '%.0f'|format(desperdicado / total_gasto * 100 if total_gasto > 0 else 0) }}% do total</span>
        </div>
    </div>
    <div class="metric-card">
        <div class="metric-icon" style="background:rgba(0,214,143,0.08);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
            </svg>
        </div>
        <div class="metric-body">
            <span class="metric-label">Boas Decisões</span>
            <span class="metric-value metric-value-sm" style="color:var(--green)">{{ '%.2f'|format(boas_decisoes) }}€</span>
            <span class="metric-trend trend-ok">{{ '%.0f'|format(boas_decisoes / total_gasto * 100 if total_gasto > 0 else 0) }}% do total</span>
        </div>
    </div>
</div>

<div style="background:var(--surface);border:1px solid var(--border);border-left:3px solid var(--brand-2);
    border-radius:0 10px 10px 0;padding:16px 22px;margin-bottom:28px;
    font-size:14px;line-height:1.7;color:var(--text);font-style:italic;">
    "{{ roast_phrase }}"
</div>

<div class="dashboard-grid" style="margin-bottom:28px;">
    <div class="card">
        <div class="card-header"><h3>Por Categoria</h3></div>
        <div class="card-body">
            {% for b in barras %}
            <div style="margin-bottom:14px;">
                <div style="display:flex;justify-content:space-between;margin-bottom:5px;">
                    <span style="font-size:12px;color:var(--text-muted);">{{ b.categoria }}</span>
                    <div style="display:flex;gap:8px;align-items:center;">
                        <span style="font-size:11px;color:var(--red);font-weight:600;">~{{ b.desperdicado }}€</span>
                        <span style="font-size:13px;font-weight:700;color:var(--text);">{{ b.valor }}€</span>
                    </div>
                </div>
                <div style="height:6px;background:var(--surface2);border-radius:4px;overflow:hidden;">
                    <div style="width:{{ b.percentagem }}%;height:100%;border-radius:4px;
                        background:{% if b.regret_pct > 35 %}var(--red){% elif b.regret_pct > 20 %}var(--yellow){% else %}var(--green){% endif %};
                        transition:width 0.8s ease;"></div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    <div class="card">
        <div class="card-header"><h3>Distribuição</h3></div>
        <div class="card-body" style="display:flex;align-items:center;justify-content:center;min-height:220px;">
            <canvas id="donutChart" style="max-width:200px;max-height:200px;"></canvas>
        </div>
    </div>
</div>

{% if top_lojas %}
<div class="card" style="margin-bottom:28px;">
    <div class="card-header"><h3>Top Lojas</h3></div>
    <div class="card-body" style="padding:0;">
        <table class="data-table">
            <thead><tr><th>#</th><th>Loja</th><th style="text-align:right;">Total</th></tr></thead>
            <tbody>
                {% for l in top_lojas %}
                <tr>
                    <td style="color:var(--text-sub);font-weight:700;">{{ loop.index }}</td>
                    <td style="font-weight:600;">{{ l.loja }}</td>
                    <td style="text-align:right;color:var(--brand-2);font-weight:700;">{{ l.valor }}€</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

{% else %}
<div class="empty-card">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--text-sub)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:12px;">
        <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
    </svg>
    <p>Sem faturas em {{ mes_nome }} {{ ano }}.<br>
       Carrega as tuas faturas em <a href="{{ url_for('faturas.faturas') }}">Faturas</a>.</p>
</div>
{% endif %}
{% endblock %}

{% block extra_scripts %}
<script>
{% if barras %}
const ctx = document.getElementById('donutChart');
if (ctx) {
    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: {{ barras | map(attribute='categoria') | list | tojson }},
            datasets: [{
                data: {{ barras | map(attribute='valor') | list | tojson }},
                backgroundColor: ['#4A3AFF','#7B61FF','#00D68F','#FFB800','#FF4757','#FF6B35'],
                borderWidth: 0, hoverOffset: 6,
            }]
        },
        options: { responsive:true, cutout:'65%', plugins:{ legend:{display:false}, tooltip:{callbacks:{label:(c)=>` ${c.label}: ${c.parsed.toFixed(2)}€`}} } }
    });
}
{% endif %}
</script>
{% endblock %}
</file>

<file path="templates/scoring.html">
{% extends 'base.html' %}
{% block title %}Score de Compras · Verly{% endblock %}

{% block extra_head %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<style>
.mapa-spinner {
    width:32px;height:32px;
    border:3px solid var(--border);
    border-top-color:var(--brand);
    border-radius:50%;
    animation:spin 0.8s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg);}}
#mapaDiv { height:220px; }
#mapaDiv .leaflet-container { background:var(--bg)!important; }
</style>
{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1 class="page-title">🧠 Was It Worth It?</h1>
        <p class="page-sub">Analisa qualquer compra e descobre se valeu a pena — ou não.</p>
    </div>
</div>

<!-- GRID: formulário + mapa lado a lado -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start;">

    <!-- COLUNA ESQUERDA -->
    <div style="display:flex;flex-direction:column;gap:20px;">

        <!-- Formulário -->
        <div class="card">
            <div class="card-header"><h3>Analisar Compra</h3></div>
            <div class="card-body" style="display:flex;flex-direction:column;gap:16px;">

                <div>
                    <label style="display:block;font-size:13px;font-weight:600;color:var(--text-sub);margin-bottom:6px;">Nome do item</label>
                    <input id="itemInput" type="text"
                        placeholder="Ex: iPhone 16 Pro, Adidas Samba, Sofá Ikea..."
                        style="width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'Outfit',sans-serif;font-size:14px;padding:10px 14px;outline:none;box-sizing:border-box;transition:border-color 0.2s;"
                        onfocus="this.style.borderColor='var(--brand)'"
                        onblur="this.style.borderColor='var(--border)'">
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                    <div>
                        <label style="display:block;font-size:13px;font-weight:600;color:var(--text-sub);margin-bottom:6px;">Preço (€)</label>
                        <input id="precoInput" type="number" min="0" placeholder="0.00"
                            style="width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'Outfit',sans-serif;font-size:14px;padding:10px 14px;outline:none;box-sizing:border-box;transition:border-color 0.2s;"
                            onfocus="this.style.borderColor='var(--brand)'"
                            onblur="this.style.borderColor='var(--border)'">
                    </div>
                    <div>
                        <label style="display:block;font-size:13px;font-weight:600;color:var(--text-sub);margin-bottom:6px;">Categoria</label>
                        <select id="categoriaInput"
                            style="width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:'Outfit',sans-serif;font-size:14px;padding:10px 14px;outline:none;box-sizing:border-box;cursor:pointer;">
                            <option value="Outros">Outros</option>
                            <option value="Alimentação">Alimentação</option>
                            <option value="Tecnologia">Tecnologia</option>
                            <option value="Vestuário">Vestuário</option>
                            <option value="Entretenimento">Entretenimento</option>
                            <option value="Saúde & Beleza">Saúde & Beleza</option>
                            <option value="Casa & Decoração">Casa & Decoração</option>
                            <option value="Desporto">Desporto</option>
                            <option value="Educação">Educação</option>
                            <option value="Transportes">Transportes</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label style="display:block;font-size:13px;font-weight:600;color:var(--text-sub);margin-bottom:8px;">Com que frequência vais usar?</label>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;" id="usoGroup">
                        {% for key, label in [('daily','Diariamente'),('weekly','Regularmente'),('monthly','Às vezes'),('rarely','Raramente'),('never','Nunca')] %}
                        <button class="uso-btn" data-uso="{{ key }}"
                            onclick="selecionarUso('{{ key }}', this)"
                            style="padding:7px 14px;border-radius:20px;border:1px solid var(--border);background:var(--surface2);color:var(--text-muted);font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:all 0.2s;">
                            {{ label }}
                        </button>
                        {% endfor %}
                    </div>
                </div>

                <button onclick="analisarCompra()" id="btnAnalisar"
                    style="background:var(--brand);color:#fff;border:none;border-radius:10px;padding:12px 24px;font-size:15px;font-weight:700;cursor:pointer;font-family:'Outfit',sans-serif;transition:opacity 0.2s;width:100%;">
                    Analisar Compra →
                </button>
            </div>
        </div>

        <!-- Resultado (oculto até análise) -->
        <div id="resultado" style="display:none;">
            <div class="card">
                <div class="card-header">
                    <h3 id="resItem" style="font-size:16px;"></h3>
                    <span id="resLabel" style="font-size:13px;font-weight:700;padding:4px 12px;border-radius:12px;"></span>
                </div>
                <div class="card-body">
                    <div style="display:flex;align-items:center;gap:24px;margin-bottom:16px;">
                        <div style="position:relative;width:90px;height:90px;flex-shrink:0;">
                            <svg width="90" height="90" viewBox="0 0 90 90">
                                <circle cx="45" cy="45" r="36" fill="none" stroke="var(--border)" stroke-width="8"/>
                                <circle id="scoreCircle" cx="45" cy="45" r="36" fill="none"
                                    stroke="var(--brand)" stroke-width="8" stroke-linecap="round"
                                    stroke-dasharray="226" stroke-dashoffset="226"
                                    transform="rotate(-90 45 45)"
                                    style="transition:stroke-dashoffset 0.8s ease,stroke 0.4s ease;"/>
                            </svg>
                            <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;">
                                <div id="scoreNum" style="font-size:22px;font-weight:800;font-family:'Sora',sans-serif;color:var(--text);"></div>
                                <div style="font-size:10px;color:var(--text-sub);">/100</div>
                            </div>
                        </div>
                        <div style="flex:1;">
                            <div id="resMessage" style="font-size:14px;color:var(--text-sub);line-height:1.5;margin-bottom:12px;"></div>
                            <div id="resChips" style="display:flex;gap:6px;flex-wrap:wrap;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- COLUNA DIREITA: mapa -->
    <div>
        <div class="card" style="overflow:hidden;">
            <div class="card-header" style="padding:14px 16px;">
                <h3 style="font-size:14px;">📍 Lojas Próximas</h3>
                <span id="mapaStatus" style="font-size:12px;color:var(--text-sub);">Analisa um produto para ver lojas</span>
            </div>

            <!-- Estado vazio -->
            <div id="mapaVazio" style="padding:48px 24px;display:flex;flex-direction:column;align-items:center;gap:12px;color:var(--text-sub);text-align:center;">
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.25;">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                </svg>
                <p style="font-size:13px;max-width:200px;line-height:1.6;margin:0;" id="mapaVazioMsg">
                    Após analisar um produto, mostramos lojas próximas onde o podes comprar.
                </p>
            </div>

            <!-- Loading -->
            <div id="mapaLoading" style="display:none;padding:48px 24px;flex-direction:column;align-items:center;gap:12px;color:var(--text-sub);">
                <div class="mapa-spinner"></div>
                <p style="font-size:13px;margin:0;">A procurar lojas próximas...</p>
            </div>

            <!-- Mapa + lista (aparece após pesquisa) -->
            <div id="mapaConteudo" style="display:none;">
                <div id="mapaDiv"></div>
                <div id="lojasList" style="max-height:220px;overflow-y:auto;padding:8px 16px;display:flex;flex-direction:column;gap:0;"></div>
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block extra_scripts %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
// ── Estado ──────────────────────────────────────────────────────────────────
let usoSelecionado = 'monthly';
let mapaInstance   = null;
let userLat = null, userLng = null;

const SCORE_COLORS = {
    green:  {stroke:'#00D68F', bg:'rgba(0,214,143,0.12)',  text:'#00D68F'},
    brand2: {stroke:'#7B61FF', bg:'rgba(123,97,255,0.12)', text:'#7B61FF'},
    yellow: {stroke:'#FFB800', bg:'rgba(255,184,0,0.12)',  text:'#FFB800'},
    orange: {stroke:'#FF8C00', bg:'rgba(255,140,0,0.12)',  text:'#FF8C00'},
    red:    {stroke:'#FF4757', bg:'rgba(255,71,87,0.12)',  text:'#FF4757'},
    muted:  {stroke:'#333',    bg:'var(--surface2)',        text:'var(--text-muted)'},
};

const CHIP_STYLES = {
    good: 'background:rgba(0,214,143,0.12);color:#00D68F;border:1px solid rgba(0,214,143,0.25);',
    bad:  'background:rgba(255,71,87,0.12);color:#FF4757;border:1px solid rgba(255,71,87,0.25);',
    mid:  'background:var(--surface2);color:var(--text-sub);border:1px solid var(--border);',
};

// ── Init ─────────────────────────────────────────────────────────────────────
window.addEventListener('DOMContentLoaded', () => {
    // Seleciona uso padrão
    const btn = document.querySelector('[data-uso="monthly"]');
    if (btn) selecionarUso('monthly', btn);

    // Pede GPS logo no carregamento (o browser só pergunta uma vez)
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
            pos => { userLat = pos.coords.latitude; userLng = pos.coords.longitude; },
            ()  => { userLat = null; userLng = null; },
            {timeout: 8000}
        );
    }
});

// ── Seleção de uso ────────────────────────────────────────────────────────────
function selecionarUso(uso, btn) {
    usoSelecionado = uso;
    document.querySelectorAll('.uso-btn').forEach(b => {
        b.style.background   = 'var(--surface2)';
        b.style.color        = 'var(--text-muted)';
        b.style.borderColor  = 'var(--border)';
    });
    btn.style.background  = 'rgba(123,97,255,0.12)';
    btn.style.color       = 'var(--brand)';
    btn.style.borderColor = 'var(--brand)';
}

// ── Analisar compra ───────────────────────────────────────────────────────────
async function analisarCompra() {
    const item      = document.getElementById('itemInput').value.trim();
    const preco     = parseFloat(document.getElementById('precoInput').value) || 0;
    const categoria = document.getElementById('categoriaInput').value;

    // Validação
    if (!item) {
        const el = document.getElementById('itemInput');
        el.style.borderColor = '#FF4757';
        el.focus();
        setTimeout(() => el.style.borderColor = 'var(--border)', 2000);
        return;
    }
    if (preco <= 0) {
        const el = document.getElementById('precoInput');
        el.style.borderColor = '#FF4757';
        el.focus();
        setTimeout(() => el.style.borderColor = 'var(--border)', 2000);
        return;
    }

    const btn = document.getElementById('btnAnalisar');
    btn.disabled = true;
    btn.textContent = 'A analisar...';

    // Mostra loading no mapa em paralelo
    mostrarMapaLoading(item);

    try {
        const res  = await fetch('/scoring/analisar', {
            method:  'POST',
            headers: {'Content-Type': 'application/json'},
            body:    JSON.stringify({item, preco, categoria, uso: usoSelecionado}),
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.message || 'Erro desconhecido');
        mostrarResultado(data.resultado, item);
    } catch (e) {
        alert('Erro ao analisar: ' + e.message);
    } finally {
        btn.disabled = false;
        btn.textContent = 'Analisar Compra →';
    }

    // Busca lojas (não bloqueia o resultado)
    buscarLojasProximas(item, categoria);
}

// ── Resultado ─────────────────────────────────────────────────────────────────
function mostrarResultado(r, item) {
    const colors = SCORE_COLORS[r.color] || SCORE_COLORS.muted;

    document.getElementById('resItem').textContent = item;

    const lbl = document.getElementById('resLabel');
    lbl.textContent = r.label;
    lbl.style.cssText = `font-size:13px;font-weight:700;padding:4px 12px;border-radius:12px;background:${colors.bg};color:${colors.text};`;

    document.getElementById('scoreNum').textContent = r.score;
    setTimeout(() => {
        const circle = document.getElementById('scoreCircle');
        circle.style.strokeDashoffset = 226 - (r.score / 100) * 226;
        circle.style.stroke = colors.stroke;
    }, 50);

    document.getElementById('resMessage').textContent = r.message;
    document.getElementById('resChips').innerHTML = (r.chips || []).map(c =>
        `<span style="font-size:12px;font-weight:600;padding:4px 10px;border-radius:10px;${CHIP_STYLES[c.type] || CHIP_STYLES.mid}">${c.text}</span>`
    ).join('');

    const el = document.getElementById('resultado');
    el.style.display = 'block';
    el.scrollIntoView({behavior:'smooth', block:'nearest'});
}

// ── Mapa helpers ──────────────────────────────────────────────────────────────
function mostrarMapaLoading(item) {
    document.getElementById('mapaVazio').style.display    = 'none';
    document.getElementById('mapaLoading').style.display  = 'flex';
    document.getElementById('mapaConteudo').style.display = 'none';
    document.getElementById('mapaStatus').textContent = `A procurar "${item}"...`;
}

function mostrarMapaErro(msg) {
    document.getElementById('mapaLoading').style.display  = 'none';
    document.getElementById('mapaConteudo').style.display = 'none';
    document.getElementById('mapaVazio').style.display    = 'flex';
    document.getElementById('mapaVazioMsg').textContent   = msg;
    document.getElementById('mapaStatus').textContent     = 'Sem resultados';
}

// ── Busca lojas ───────────────────────────────────────────────────────────────
async function buscarLojasProximas(item, categoria) {
    // Se não temos GPS ainda, tenta obter agora
    if (userLat === null || userLng === null) {
        try {
            const pos = await new Promise((resolve, reject) =>
                navigator.geolocation.getCurrentPosition(resolve, reject, {timeout: 6000})
            );
            userLat = pos.coords.latitude;
            userLng = pos.coords.longitude;
        } catch {
            mostrarMapaErro('Ativa a localização no browser para ver lojas próximas.');
            return;
        }
    }

    try {
        const res  = await fetch('/scoring/lojas-proximas', {
            method:  'POST',
            headers: {'Content-Type': 'application/json'},
            body:    JSON.stringify({item, categoria, lat: userLat, lng: userLng}),
        });
        const data = await res.json();

        if (!data.success || !data.lojas || data.lojas.length === 0) {
            mostrarMapaErro('Nenhuma loja encontrada num raio de 5 km.');
            return;
        }

        renderizarMapa(data.lojas, item);
    } catch {
        mostrarMapaErro('Erro ao procurar lojas. Tenta novamente.');
    }
}

// ── Renderiza mapa Leaflet ────────────────────────────────────────────────────
function renderizarMapa(lojas, item) {
    document.getElementById('mapaLoading').style.display  = 'none';
    document.getElementById('mapaVazio').style.display    = 'none';
    document.getElementById('mapaConteudo').style.display = 'block';
    document.getElementById('mapaStatus').textContent     = `${lojas.length} loja(s) encontrada(s)`;

    // Remove mapa anterior se existir
    if (mapaInstance) { mapaInstance.remove(); mapaInstance = null; }

    const map = L.map('mapaDiv', {zoomControl:true, attributionControl:false})
                 .setView([userLat, userLng], 14);
    mapaInstance = map;

    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {maxZoom:19})
     .addTo(map);

    // Marcador do utilizador
    L.marker([userLat, userLng], {
        icon: L.divIcon({
            html: `<div style="width:14px;height:14px;background:#7B61FF;border:3px solid white;border-radius:50%;box-shadow:0 0 10px rgba(123,97,255,0.8);"></div>`,
            className:'', iconAnchor:[7,7],
        })
    }).addTo(map).bindPopup('A tua localização');

    // Marcadores das lojas
    lojas.forEach((loja, i) => {
        L.marker([loja.lat, loja.lng], {
            icon: L.divIcon({
                html: `<div style="width:26px;height:26px;background:linear-gradient(135deg,#4A3AFF,#7B61FF);border:2px solid white;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:white;box-shadow:0 2px 8px rgba(0,0,0,0.5);">${i+1}</div>`,
                className:'', iconAnchor:[13,13],
            })
        }).addTo(map)
          .bindPopup(`<b>${loja.nome}</b>${loja.endereco ? '<br>' + loja.endereco : ''}`);
    });

    // Lista
    const lista = document.getElementById('lojasList');
    lista.innerHTML = lojas.map((loja, i) => `
        <div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border);">
            <div style="width:24px;height:24px;background:linear-gradient(135deg,#4A3AFF,#7B61FF);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;color:white;flex-shrink:0;">${i+1}</div>
            <div style="flex:1;min-width:0;">
                <div style="font-size:13px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${loja.nome}</div>
                ${loja.endereco ? `<div style="font-size:11px;color:var(--text-sub);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${loja.endereco}</div>` : ''}
            </div>
            ${loja.distancia ? `<div style="font-size:11px;color:var(--brand-2);font-weight:700;flex-shrink:0;">${loja.distancia}</div>` : ''}
        </div>
    `).join('');
}
</script>
{% endblock %}
</file>

