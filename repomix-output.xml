        const res = await fetch('/personality/set',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({personalidade:key})});
        const data = await res.json();
        if (!data.success) return;
        document.querySelectorAll('.pers-card').forEach(card => {
            const active = card.dataset.key === key;
            card.style.borderColor = active ? card.dataset.cor : 'var(--border)';
            card.querySelector('.badge-ativo').style.display = active ? 'block' : 'none';
        });
        const msg = document.getElementById('confirmMsg');
        msg.textContent = `Personalidade "${data.info.nome}" ativada.`;
        msg.style.display = 'block';
        setTimeout(() => msg.style.display = 'none', 3000);
    } catch(e) { console.error(e); }
}
</script>
{% endblock %}
