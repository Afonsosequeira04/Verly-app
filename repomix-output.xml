import os
import logging
import resend
from datetime import datetime

logger = logging.getLogger(__name__)

RESEND_API_KEY = os.getenv("RESEND_API_KEY", "")
EMAIL_FROM     = os.getenv("EMAIL_FROM", "Verly <alertas@verly.app>")
APP_URL        = os.getenv("APP_URL", "https://verly.app")


# ── Cores por urgência ────────────────────────────────────────────────────────

